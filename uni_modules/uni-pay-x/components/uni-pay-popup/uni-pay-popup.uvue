<template>
	<view class="popup-root" :class="'popup-'+type" v-if="isOpen" v-show="isShow" @click="clickMask">
		<view @click.stop class="popup-box">
			<slot></slot>
		</view>
	</view>
</template>

<script setup lang="uts">

	const props = withDefaults(defineProps<{
		maskClick?: boolean
		type?: string
	}>(), {
		maskClick: true,
		type: "center"
	})

	const emit = defineEmits(['close', 'clickMask'])

	const isShow = ref(false)
	const isOpen = ref(false)

	function open() {
		isOpen.value = true;
	}

	function close() : void {
		isOpen.value = false;
		emit('close');
	}

	function clickMask() {
		if (props.maskClick == true) {
			emit('clickMask');
			close();
		}
	}

	function hiden() {
		isShow.value = false;
	}

	function show() {
		isShow.value = true;
	}

	watch(isShow, (newVal : boolean) => {
		if (newVal && isOpen.value == false) {
			isOpen.value = true;
		}
	}, { immediate: true })

	watch(isOpen, (newVal : boolean) => {
		if (newVal && isShow.value == false) {
			isShow.value = true;
		}
	}, { immediate: true })

	defineExpose({
		open,
		close,
		hiden,
		show
	})
</script>

<style>
	.popup-root {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		flex: 1;
		background-color: rgba(0, 0, 0, 0.4);
		justify-content: center;
		align-items: center;
		z-index: 99;
	}
  .popup-box {
    width: 100%;
    justify-content: center;
    align-items: center;
  }
	.popup-bottom {
		justify-content: flex-end;
	}
</style>
