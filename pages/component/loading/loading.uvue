<template>
  <scroll-view class="container">
    <!-- 标题 -->
    <view class="header">
      <text class="title">loading 样式测试页</text>
      <text class="subtitle">class / style / 动态 style 对比</text>
    </view>

    <!-- 一、Class 实现 -->
    <view class="section">
      <text class="section-title">Class 实现</text>
      <view class="row">
        <view class="item">
          <text class="label">100×100 / blue / medium</text>
          <loading class="box size-100 bc-blue bw-medium" />
        </view>
        <view class="item">
          <text class="label">100×100 / red / thick</text>
          <loading class="box size-100 bc-red bw-thick" />
        </view>
        <view class="item">
          <text class="label">80×80 / green / medium</text>
          <loading class="box size-80 bc-green bw-medium" />
        </view>
        <view class="item">
          <text class="label">140×140 / yellow / thick</text>
          <loading class="box size-140 bc-yellow bw-thick" />
        </view>
      </view>
    </view>

    <!-- 二、Style 实现 -->
    <view class="section">
      <text class="section-title">Style 实现</text>
      <view class="row">
        <view class="item">
          <text class="label">80×80 / red / thick</text>
          <loading
            class="box"
            :style="{ width:'80px', height:'80px', borderColor:'red', borderWidth:'thick' }"
          />
        </view>
        <view class="item">
          <text class="label">120×120 / green / medium</text>
          <loading
            class="box"
            :style="{ width:'120px', height:'120px', borderColor:'green', borderWidth:'medium' }"
          />
        </view>
      </view>
    </view>

    <!-- 三、动态 style 控制 -->
    <view class="section">
      <text class="section-title">动态 style</text>
      <view class="controls">
        <button @click="decreaseSize">-10px</button>
        <button @click="increaseSize">+10px</button>
        <button @click="toggleBorderWidth">border: {{ borderWidthKw }}</button>
        <button @click="nextColor">color: {{ borderColor }}</button>
        <button @click="reset">reset</button>
      </view>

      <view class="row">
        <view class="item">
          <text class="label">{{ widthPx }}×{{ heightPx }} / {{ borderColor }} / {{ borderWidthKw }}</text>
          <loading class="box" :style="dynamicStyle" />
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script>
export default {
  data() {
    return {
      widthPx: 100,
      heightPx: 100,
      borderColor: 'blue',
      borderWidthKw: 'medium',
      colors: ['blue', 'red', 'green', 'yellow'],
      colorIndex: 0
    }
  },
  computed: {
    dynamicStyle() {
      return {
        width: this.widthPx + 'px',
        height: this.heightPx + 'px',
        borderColor: this.borderColor,
        borderWidth: this.borderWidthKw
      }
    }
  },
  methods: {
    increaseSize() {
      this.widthPx += 10
      this.heightPx += 10
    },
    decreaseSize() {
      this.widthPx = Math.max(20, this.widthPx - 10)
      this.heightPx = Math.max(20, this.heightPx - 10)
    },
    toggleBorderWidth() {
      this.borderWidthKw = this.borderWidthKw === 'medium' ? 'thick' : 'medium'
    },
    nextColor() {
      this.colorIndex = (this.colorIndex + 1) % this.colors.length
      this.borderColor = this.colors[this.colorIndex]
    },
    reset() {
      this.widthPx = 100
      this.heightPx = 100
      this.borderColor = 'blue'
      this.borderWidthKw = 'medium'
      this.colorIndex = 0
    }
  }
}
</script>

<style>
.container {
  flex: 1;
  padding: 8px;
  background-color: #f8f8f8;
}

.header {
  margin-bottom: 16px;
  align-items: center;
}

.title {
  font-size: 22px;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.subtitle {
  font-size: 14px;
  color: #666;
  margin-top: 6px;
  text-align: center;
}

.section {
  margin-bottom: 18px;
  background-color: #fff;
  border-radius: 10px;
  padding: 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #444;
  margin-bottom: 10px;
  text-align: center;
  background-color: #f0f0f0;
  padding: 6px;
  border-radius: 6px;
}

.row {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-around;
}

.item {
  align-items: center;
  margin: 8px 4px;
  min-width: 140px;
}

.label {
  font-size: 12px;
  color: #666;
  margin-bottom: 8px;
  text-align: center;
}

/* 基础边框容器 */
.box {
  border-style: solid;
  border-radius: 6px;
}

/* 尺寸类 */
.size-80 { width: 80px; height: 80px; }
.size-100 { width: 100px; height: 100px; }
.size-140 { width: 140px; height: 140px; }

/* 边框颜色类 */
.bc-blue { border-color: blue; }
.bc-red { border-color: red; }
.bc-green { border-color: green; }
.bc-yellow { border-color: yellow; }

/* 边框宽度类（关键字） */
.bw-medium { border-width: medium; }
.bw-thick { border-width: thick; }
</style>
