<template>
  <scroll-view style="flex: 1">
    <view style="margin: 20px;">
      <text style="font-weight: bold;">case1:</text>
      <text>loading 默认大小样式; \n font-weight="normal"/"bold"; \n color="默认"/"red"/"blue"</text>
      <view style="flex-direction: row; margin: 10px;">
        <loading></loading>
        <loading style="margin-left: 20px" font-weight="normal" color="red"></loading>
        <loading style="margin-left: 20px" font-weight="bold" color="blue"></loading>
      </view>

      <text style="font-weight: bold;">case2:</text>
      <text>loading width=height=50; \n font-weight="normal"/"bold"; \n color="默认"/"red"/"blue"</text>
      <view style="flex-direction: row; margin: 10px;">
        <loading style="width: 50px; height: 50px;"></loading>
        <loading style="margin-left: 20px; width: 50px; height: 50px;" font-weight="normal" color="red"></loading>
        <loading style="margin-left: 20px; width: 50px; height: 50px;" font-weight="bold" color="blue"></loading>
      </view>
      <text style="font-weight: bold;">case3:</text>
      <text>loading width=20px, height=50px; \n font-weight="normal"/"bold"; \n color="默认"/"red"/"blue"</text>
      <view style="flex-direction: row; margin: 10px;">
        <loading style="width: 20px; height: 50px;"></loading>
        <loading style="margin-left: 20px; width: 20px; height: 50px;" font-weight="normal"
          color="red"></loading>
        <loading style="margin-left: 20px; width: 20px; height: 50px;" font-weight="bold"
          color="blue"></loading>
      </view>

      <text style="font-weight: bold;">case4:</text>
      <text>loading width=50px, height=20px; \n font-weight="normal"/"bold"; \n color="默认"/"red"/"blue"</text>
      <view style="flex-direction: row; margin: 10px;">
        <loading style="width: 50px; height: 20px;;"></loading>
        <loading style="margin-left: 20px; width: 50px; height: 20px;" font-weight="normal"
          color="red"></loading>
        <loading style="margin-left: 20px; width: 50px; height: 20px;" font-weight="bold"
          color="blue"></loading>
      </view>

      <text style="font-weight: bold;">case5:</text>
      <text>loading 带背景环</text>
      <view style="flex-direction: row; margin: 10px;">
        <!-- 使用Vue计算属性动态计算border -->
        <view class="loading-container" :style="containerStyle(36)">
          <view class="background-ring" :style="ringStyle(36, false)"></view>
          <view class="loading-content">
            <loading :style="loadingStyle(36)"></loading>
          </view>
        </view>
        <view class="loading-container" :style="containerStyle(36)" style="margin-left: 20px;">
          <view class="background-ring" :style="ringStyle(36, false)"></view>
          <view class="loading-content">
            <loading :style="loadingStyle(36)" font-weight="normal" color="red"></loading>
          </view>
        </view>
        <view class="loading-container" :style="containerStyle(36)" style="margin-left: 20px;">
          <view class="background-ring" :style="ringStyle(36, true)"></view>
          <view class="loading-content">
            <loading :style="loadingStyle(36)" font-weight="bold" color="blue"></loading>
          </view>
        </view>
      </view>
      <text style="font-weight: bold;">case6:</text>
      <text>loading 带背景环+背景颜色</text>
      <view style="flex-direction: row; margin: 10px;">
        <!-- 使用Vue计算属性动态计算居中位置和边框 -->
        <view class="bg-container" style=" width: 80px; height: 80px;">
          <view class="background-ring" :style="centeredRingStyle(80, 36, false)"></view>
          <view class="loading-content" :style="centeredContentStyle(80, 36)">
            <loading :style="loadingStyle(36)"></loading>
          </view>
        </view>
        <view class="bg-container" style="margin-left: 20px; width: 80px; height: 80px;">
          <view class="background-ring" :style="centeredRingStyle(80, 36, false)"></view>
          <view class="loading-content" :style="centeredContentStyle(80, 36)">
            <loading :style="loadingStyle(36)" font-weight="normal" color="red"></loading>
          </view>
        </view>
        <view class="bg-container" style="margin-left: 20px; width: 80px; height: 80px;">
          <view class="background-ring" :style="centeredRingStyle(80, 36, true)"></view>
          <view class="loading-content" :style="centeredContentStyle(80, 36)">
            <loading :style="loadingStyle(36)" font-weight="bold" color="blue"></loading>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script>
  export default {
    data() {
      return {

      }
    },
    methods: {
      // 容器样式计算
      containerStyle(size : number) {
        return {
          width: size + 'px',
          height: size + 'px'
        }
      },

      // 背景环样式计算
      ringStyle(size : number, isBold : boolean = false) {
        const borderWidth = isBold ? size * 0.125 : size * 0.0625
        return {
          width: size + 'px',
          height: size + 'px',
          border: borderWidth + 'px solid #e0e0e0',
          borderRadius: '50px'
        }
      },

      // loading样式计算
      loadingStyle(size : number) {
        return {
          width: size + 'px',
          height: size + 'px'
        }
      },

      // 居中背景环样式计算
      centeredRingStyle(containerSize : number, loadingSize : number, isBold : boolean = false) {
        const borderWidth = isBold ? loadingSize * 0.125 : loadingSize * 0.0625
        const offset = (containerSize - loadingSize) / 2
        return {
          width: loadingSize + 'px',
          height: loadingSize + 'px',
          border: borderWidth + 'px solid #e0e0e0',
          borderRadius: '50px',
          top: offset + 'px',
          left: offset + 'px'
        }
      },

      // 居中内容样式计算
      centeredContentStyle(containerSize : number, loadingSize : number) {
        const offset = (containerSize - loadingSize) / 2
        return {
          top: offset + 'px',
          left: offset + 'px'
        }
      }
    }
  }
</script>

<style>
  /* 基础样式类 - 使用Vue计算属性动态设置具体数值 */
  .loading-container {
    position: relative;
  }

  .bg-container {
    position: relative;
    background-color: white;
  }

  .background-ring {
    position: absolute;
  }

  .loading-content {
    position: absolute;
  }
</style>
