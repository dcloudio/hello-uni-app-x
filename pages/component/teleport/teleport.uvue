<template>
  <!-- #ifdef APP && !VUE3-VAPOR -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view class="teleport-page">
      <page-head title="Teleport"></page-head>

      <view class="control-panel">
        <view class="control-row">
          <view class="control-copy">
            <text class="control-title">target</text>
            <text class="control-desc">{{ currentTarget.description }}</text>
          </view>
          <view class="target-actions">
            <button v-for="item in targetList" :key="item.title" class="target-button" size="mini"
              :type="currentTarget.title == item.title ? 'primary' : 'default'"
              @click="setTarget(item)">{{ item.title }}</button>
          </view>
        </view>
        <view class="control-row">
          <view class="control-copy">
            <text class="control-title">disabled</text>
            <text class="control-desc">{{ data.teleportDisabled ? '原位置渲染' : '传送到目标' }}</text>
          </view>
          <switch :checked="data.teleportDisabled" @change="onDisabledChange" />
        </view>
        <view class="control-row">
          <view class="control-copy">
            <text class="control-title">v-if</text>
            <text class="control-desc">{{ data.showTeleport ? '创建 Teleport' : '销毁 Teleport' }}</text>
          </view>
          <switch :checked="data.showTeleport" @change="onShowChange" />
        </view>
        <button class="defer-link-button" size="mini" type="primary" @click="goDeferPage">defer 专项测试</button>
      </view>

      <view class="status-box">
        <text class="status-text">当前：{{ teleportStatus }}</text>
        <text class="status-tip">切换 target 时通过 key 重建 Teleport。</text>
      </view>

      <view id="teleport-origin-box" class="origin-box">
        <text class="origin-title">Teleport 声明位置</text>
        <text class="origin-desc">disabled 开启时，内容会留在这里。</text>

        <Teleport v-if="data.showTeleport" :key="currentTarget.title" :to="currentTarget.value" :disabled="data.teleportDisabled" :defer="true">
          <view id="teleport-content" class="teleport-card">
            <text class="card-title">Teleport 内容</text>
            <text class="card-desc">to: {{ currentTarget.description }}</text>
          </view>
        </Teleport>

        <view v-if="!data.showTeleport" class="empty-box">
          <text class="empty-text">Teleport 已销毁</text>
        </view>
      </view>

      <view class="target-box" :class="currentTarget.title == 'page' ? 'target-box-active' : ''">
        <text class="target-title">page</text>
        <text class="target-desc">to="page" 指向页面根节点，此区域仅用于说明当前状态。</text>
      </view>

      <view id="teleport-id-target" class="target-box" :class="currentTarget.title == '#id' ? 'target-box-active' : ''">
        <text class="target-title">#id</text>
        <text class="target-desc">to="#teleport-id-target" 指向当前容器。</text>
      </view>

      <view id="teleport-ref-target" ref="teleportRefTarget" class="target-box" :class="currentTarget.title == 'ref' ? 'target-box-active' : ''">
        <text class="target-title">ref</text>
        <text class="target-desc">:to="teleportRefTarget" 指向这个 ref 容器。</text>
      </view>

      <view id="teleport-page-bottom-anchor" class="page-bottom-anchor"></view>
    </view>
    <!-- #ifdef APP && !VUE3-VAPOR -->
    <!-- </scroll-view> -->
    <!-- #endif -->
</template>

<script setup lang="uts">
  type TargetValue = string | Ref<UniElement | null>

  type TargetItem = {
    title : string
    value : TargetValue
    description : string
  }

  const teleportRefTarget = ref<UniElement | null>(null)
  const instance = getCurrentInstance()!.proxy!

  const data = reactive({
    teleportDisabled: false,
    showTeleport: false
  })

  const targetList = [
    { title: 'page', value: 'page', description: '页面根节点' },
    { title: '#id', value: '#teleport-id-target', description: '指定 id 容器' },
    { title: 'ref', value: teleportRefTarget, description: '模板 ref 容器' }
  ] as TargetItem[]

  const currentTarget = ref<TargetItem>(targetList[1])

  const teleportStatus = computed(() : string => {
    if (!data.showTeleport) {
      return 'v-if = false，Teleport 已销毁'
    }
    if (data.teleportDisabled) {
      return 'disabled = true，内容留在声明位置'
    }
    return '传送到 ' + currentTarget.value.title
  })

  function setTarget(target : TargetItem) {
    currentTarget.value = target
  }

  function setTargetByIndex(index : number) {
    if (index < 0 || index >= targetList.length) {
      return
    }
    currentTarget.value = targetList[index]
  }

  function onDisabledChange(e : UniSwitchChangeEvent) {
    data.teleportDisabled = e.detail.value
  }

  function onShowChange(e : UniSwitchChangeEvent) {
    data.showTeleport = e.detail.value
  }

  function goDeferPage() {
    uni.navigateTo({ url: '/pages/component/teleport/teleport-defer' })
  }

  function getBoundingClientRectForTest(id : string) : DOMRect | null {
    if (id == 'page') {
      return instance.$el?.getBoundingClientRect() ?? null
    }
    return uni.getElementById(id)?.getBoundingClientRect() ?? null
  }

  defineExpose({
    data,
    setTargetByIndex,
    getBoundingClientRectForTest
  })
</script>

<style>
  .teleport-page {
    padding: 16px;
    background-color: #f5f7fb;
  }

  .control-panel {
    display: flex;
    flex-direction: column;
    padding: 12px;
    margin-top: 12px;
    border-radius: 12px;
    background-color: #ffffff;
  }

  .control-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .control-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-right: 12px;
  }

  .control-title {
    font-size: 16px;
    color: #1f2937;
    font-weight: bold;
  }

  .control-desc {
    margin-top: 4px;
    font-size: 12px;
    color: #6b7280;
  }

  .target-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .target-button {
    width: 62px;
    margin-left: 6px;
  }

  .status-box {
    display: flex;
    flex-direction: column;
    padding: 12px;
    margin-top: 12px;
    border-radius: 12px;
    background-color: #eef6ff;
  }

  .status-text {
    font-size: 14px;
    color: #0052cc;
    font-weight: bold;
  }

  .status-tip {
    margin-top: 4px;
    font-size: 12px;
    color: #4b5563;
  }

  .defer-link-button {
    margin-top: 10px;
  }

  .target-box {
    display: flex;
    flex-direction: column;
    min-height: 116px;
    padding: 12px;
    margin-top: 12px;
    border-width: 1px;
    border-style: dashed;
    border-color: #c7d2fe;
    border-radius: 12px;
    background-color: #ffffff;
  }

  .target-box-active {
    border-color: #007aff;
    background-color: #f0f7ff;
  }

  .target-title {
    font-size: 16px;
    color: #111827;
    font-weight: bold;
  }

  .target-desc {
    margin-top: 4px;
    font-size: 12px;
    color: #6b7280;
  }

  .page-bottom-anchor {
    height: 1px;
  }

  .origin-box {
    display: flex;
    flex-direction: column;
    min-height: 136px;
    padding: 12px;
    margin-top: 12px;
    border-radius: 12px;
    background-color: #fff7ed;
  }

  .origin-title {
    font-size: 16px;
    color: #9a3412;
    font-weight: bold;
  }

  .origin-desc {
    margin-top: 4px;
    margin-bottom: 10px;
    font-size: 12px;
    color: #9a3412;
  }

  .teleport-card {
    display: flex;
    flex-direction: column;
    padding: 12px;
    margin-top: 10px;
    border-radius: 10px;
    background-color: #007aff;
  }

  .card-title {
    font-size: 16px;
    color: #ffffff;
    font-weight: bold;
  }

  .card-desc {
    margin-top: 4px;
    font-size: 12px;
    color: #dbeafe;
  }

  .empty-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-top: 10px;
    border-radius: 8px;
    background-color: #ffffff;
  }

  .empty-text {
    font-size: 13px;
    color: #9ca3af;
  }
</style>
