  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  box-shadow: none;
}

.sheet-host {
  position: fixed;
  left: 0px;
  right: 0px;
  bottom: 0px;
  display: flex;
  flex-direction: column;
  z-index: 131;
}

.sheet-backdrop-web {
  position: absolute;
  left: 0px;
  top: 0px;
  right: 0px;
  bottom: 0px;
  z-index: 129;
  background-color: transparent;
}

.sheet-host-web {
  position: absolute;
  left: 12px;
  right: auto;
  top: 74px;
  bottom: auto;
  z-index: 160;
  box-shadow: 0px 10px 24px rgba(25, 25, 25, 0.05);
  border-radius: 14px;
}

.toolbar-panel {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.98);
  border-width: 1px;
  border-color: #ddd8cf;
  padding-top: 14px;
  padding-right: 14px;
  padding-bottom: 12px;
  padding-left: 14px;
  /* box-shadow: 0px 10px 24px rgba(25, 25, 25, 0.12); */
}

.toolbar-panel-attached {
  border-top-left-radius: 0px;
  border-top-right-radius: 0px;
  border-top-width: 0px;
  /* box-shadow: 0px 10px 20px rgba(25, 25, 25, 0.08); */
}

/* #ifdef WEB */
.toolbar-shell-web {
  border-width: 1px;
  border-top-width: 0px;
  border-color: #ddd8cf;
  background-color: rgba(255, 255, 255, 0.96);
  box-shadow: 0px 12px 24px rgba(46, 41, 35, 0.06);
}

.toolbar-scroll-track-web {
  width: 100%;
}

.toolbar-row-web {
  width: 100%;
  padding-top: 8px;
  padding-right: 10px;
  padding-bottom: 8px;
  padding-left: 10px;
}

.toolbar-panel-web {
  position: relative;
  height: auto;
  border-width: 1px;
  border-color: #d5cdbc;
  border-radius: 14px;
  padding-top: 10px;
  padding-right: 10px;
  padding-bottom: 10px;
  padding-left: 10px;
  background-color: #fffdfa;
  transition-property: transform, opacity;
  transition-duration: 180ms;
  opacity: 0;
  transform: translateY(-8px);
}

.toolbar-panel-web-attached {
  border-top-width: 1px;
}

.toolbar-panel-web-entered {
  opacity: 1;
  transform: translateY(0px);
}

.toolbar-panel-arrow {
  position: absolute;
  top: -7px;
  width: 14px;
  height: 14px;
  background-color: #fffdfa;
  border-width: 0px;
  box-shadow: none;
  transform: rotate(45deg);
}

.toolbar-panel-header-web {
  margin-bottom: 8px;
}

.toolbar-panel-title-web {
  font-size: 13px;
}

.toolbar-panel-subtitle-web {
  font-size: 10px;
  margin-top: 2px;
}

.toolbar-panel-scroll-web {
  flex: 0;
}

.toolbar-chip-row-web {
  margin-left: -3px;
  margin-right: -3px;
}

.toolbar-chip-row-web-compact {
  margin-left: -2px;
  margin-right: -2px;
}

/* #endif */

.toolbar-panel-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.toolbar-panel-title-wrap {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.toolbar-panel-title {
  color: #2f2a24;
  font-size: 14px;
  font-weight: 600;
}

.toolbar-panel-subtitle {
  color: #8a7d6d;
  font-size: 11px;
  margin-top: 4px;
}

.toolbar-panel-close {
  width: 28px;
  height: 28px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
