  background-color: #ffffff;
  color: #1f1f1f;
  font-size: 18px;
  line-height: 30px;
  padding-top: 24px;
  padding-right: 20px;
  padding-bottom: 24px;
  padding-left: 20px;
}

.toolbar-wrap {
  position: fixed;
  left: 0px;
  right: 0px;
  bottom: 350px;
  display: flex;
  flex-direction: column;
