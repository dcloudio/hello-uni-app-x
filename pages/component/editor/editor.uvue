<template>
  <view id="editor-page-shell" class="page-shell">
    <view
     class="toolbar-wrap"
     :class="isWebToolbarMode() ? 'toolbar-wrap toolbar-wrap-web' : 'toolbar-wrap'"
     :style="getToolbarWrapStyle()"
     v-if="isToolbarRendered()"
     @touchstart="onToolbarTouchStart"
     <!--#ifdef WEB -->
     @mousedown="onToolbarMouseDown"
     <!--#endif-->
    >
      <view :class="getToolbarShellClass()">
        <scroll-view :class="getToolbarScrollTrackClass()" direction="horizontal" :show-scrollbar="false">
          <view :class="getToolbarRowClass()">
            <view class="toolbar-group toolbar-group-main">
              <view id="toolbar-button-more" @click="openMoreSheet" :class="data.activeSheet == 'more' ? 'toolbar-button toolbar-button-active toolbar-button-right' : 'toolbar-button toolbar-button-right'">
                <text :class="data.activeSheet == 'more' ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">&#xec7c;</text>
              </view>
            </view>

            <view class="toolbar-divider toolbar-divider-side"></view>

            <view class="toolbar-group toolbar-group-main">
              <view id="toolbar-button-title" @click="openTitleSheet" :class="isTitleSheetHighlighted() ? 'toolbar-button toolbar-button-active' : 'toolbar-button'">
                <text :class="isTitleSheetHighlighted() ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">&#xec8d;</text>
              </view>
              <view id="toolbar-button-style" @click="openStyleSheet" :class="isStyleSheetHighlighted() ? 'toolbar-button toolbar-button-active' : 'toolbar-button'">
                <text :class="isStyleSheetHighlighted() ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">&#xec8a;</text>
              </view>
              <view id="toolbar-button-align" @click="openAlignSheet" :class="isAlignSheetHighlighted() ? 'toolbar-button toolbar-button-active toolbar-button-right' : 'toolbar-button toolbar-button-right'">
                <text :class="isAlignSheetHighlighted() ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">&#xec84;</text>
              </view>
            </view>

            <view class="toolbar-divider toolbar-divider-center"></view>

            <view class="toolbar-group toolbar-group-main toolbar-group-main-right">
              <view @click="chooseInsertImage" class="toolbar-button">
                <text class="toolbar-iconfont iconfont">&#xec82;</text>
              </view>
              <view @click="insertDivider" class="toolbar-button">
                <text class="toolbar-iconfont iconfont">&#xec7f;</text>
              </view>
              <!-- #ifndef MP -->
              <view @click="insertMention" class="toolbar-button">
                <text class="toolbar-iconfont iconfont">@</text>
              </view>
              <!-- #endif -->
            </view>
          </view>
        </scroll-view>

        <!-- #ifndef WEB -->
        <view class="toolbar-fixed-action">
          <view class="toolbar-fixed-inner">
            <view class="toolbar-divider toolbar-divider-fixed"></view>
            <view @click="hideEditorKeyboard" class="toolbar-button toolbar-button-dismiss">
              <text class="toolbar-iconfont iconfont">&#xeca0;</text>
            </view>
          </view>
        </view>
        <!-- #endif -->
      </view>
    </view>

    <!-- #ifdef WEB -->
    <view v-if="data.activeSheet != ''" class="sheet-backdrop-web" @click="closeSheets"></view>
    <!-- #endif -->

    <view
     id="editor-sheet-host"
     class="sheet-host"
     :class="isWebToolbarMode() ? 'sheet-host sheet-host-web' : 'sheet-host'"
     :style="getSheetHostStyle()"
     v-if="data.activeSheet != ''"
      @touchstart="onToolbarTouchStart"
      <!--#ifdef WEB -->
      @mousedown="onToolbarMouseDown"
      <!--#endif-->
    >
      <view :class="getToolbarPanelClass()" :style="getSheetPanelStyle()">
        <!-- #ifdef WEB -->
        <view class="toolbar-panel-arrow" :style="getToolbarPanelArrowStyle()"></view>
        <!-- #endif -->
        <view :class="getToolbarPanelHeaderClass()">
          <view class="toolbar-panel-title-wrap">
            <text :class="getToolbarPanelTitleClass()">{{ getPanelTitle() }}</text>
            <text :class="getToolbarPanelSubtitleClass()">{{ getPanelSubtitle() }}</text>
          </view>
        </view>

        <scroll-view :class="getToolbarPanelScrollClass()" direction="vertical" :show-scrollbar="false">
          <view class="toolbar-panel-section" v-if="data.activeSheet == 'title'">
            <view :class="getToolbarChipRowClass()">
              <view :class="getToolbarChipCellClass()"><view @click="setParagraph" :class="isParagraphActive() ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="isParagraphActive() ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">P</text><text :class="isParagraphActive() ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">正文</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(1)" :class="data.formats.header == 1 ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.header == 1 ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">H1</text><text :class="data.formats.header == 1 ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">大标题1</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(2)" :class="data.formats.header == 2 ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.header == 2 ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">H2</text><text :class="data.formats.header == 2 ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">大标题2</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(3)" :class="data.formats.header == 3 ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.header == 3 ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">H3</text><text :class="data.formats.header == 3 ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">大标题3</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(4)" :class="data.formats.header == 4 ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.header == 4 ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">H4</text><text :class="data.formats.header == 4 ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">大标题4</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(5)" :class="data.formats.header == 5 ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.header == 5 ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">H5</text><text :class="data.formats.header == 5 ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">大标题5</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(6)" :class="data.formats.header == 6 ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.header == 6 ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">H6</text><text :class="data.formats.header == 6 ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">大标题6</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setOrderedList" :class="data.formats.list == 'ordered' ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.list == 'ordered' ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">1.</text><text :class="data.formats.list == 'ordered' ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">有序列表</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setBulletList" :class="data.formats.list == 'bullet' ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.list == 'bullet' ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">•</text><text :class="data.formats.list == 'bullet' ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">无序列表</text></view></view>
              <!-- <view class="toolbar-chip-cell"><view @click="toggleBlockquote" :class="data.formats.blockquote ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.blockquote ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">\"</text><text :class="data.formats.blockquote ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">引用</text></view></view> -->
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'style'">
            <view :class="getToolbarChipRowClass()">
              <view :class="getToolbarChipCellClass()"><view @click="toggleBoldAndClose" :class="data.formats.bold ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.bold ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">B</text><text :class="data.formats.bold ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">加粗</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="toggleItalicAndClose" :class="data.formats.italic ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.italic ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">I</text><text :class="data.formats.italic ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">斜体</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="toggleUnderlineAndClose" :class="data.formats.underline ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.underline ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">U</text><text :class="data.formats.underline ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">下划线</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="toggleStrikeAndClose" :class="data.formats.strike ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.strike ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">S</text><text :class="data.formats.strike ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">删除线</text></view></view>
            </view>

            <view class="toolbar-color-section">
              <text class="toolbar-color-title">文字颜色</text>
              <view :class="getColorRowClass()">
                <view @click="setTextColorAndClose('')" :class="data.formats.color == '' ? 'color-swatch color-swatch-clear color-swatch-active' : 'color-swatch color-swatch-clear'"></view>
                <view @click="setTextColorAndClose('#1f1f1f')" :class="data.formats.color == '#1f1f1f' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #1f1f1f;"></view>
                <view @click="setTextColorAndClose('#3553ff')" :class="data.formats.color == '#3553ff' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #3553ff;"></view>
                <view @click="setTextColorAndClose('#ef4444')" :class="data.formats.color == '#ef4444' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #ef4444;"></view>
                <view @click="setTextColorAndClose('#16a34a')" :class="data.formats.color == '#16a34a' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #16a34a;"></view>
                <view @click="setTextColorAndClose('#f59e0b')" :class="data.formats.color == '#f59e0b' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #f59e0b;"></view>
              </view>

              <text class="toolbar-color-title toolbar-color-title-secondary">文字背景颜色</text>
              <view :class="getColorRowClass()">
                <view @click="setBackgroundColorAndClose('')" :class="data.formats.backgroundColor == '' ? 'color-swatch color-swatch-clear color-swatch-active' : 'color-swatch color-swatch-clear'"></view>
                <view @click="setBackgroundColorAndClose('#fff4bf')" :class="data.formats.backgroundColor == '#fff4bf' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #fff4bf;"></view>
                <view @click="setBackgroundColorAndClose('#dbeafe')" :class="data.formats.backgroundColor == '#dbeafe' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #dbeafe;"></view>
                <view @click="setBackgroundColorAndClose('#fee2e2')" :class="data.formats.backgroundColor == '#fee2e2' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #fee2e2;"></view>
                <view @click="setBackgroundColorAndClose('#dcfce7')" :class="data.formats.backgroundColor == '#dcfce7' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #dcfce7;"></view>
                <view @click="setBackgroundColorAndClose('#f3e8ff')" :class="data.formats.backgroundColor == '#f3e8ff' ? 'color-swatch color-swatch-active' : 'color-swatch'" style="background-color: #f3e8ff;"></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'align'">
            <view :class="getToolbarChipRowClass()">
              <view :class="getToolbarChipCellClass()"><view @click="clearAlign" :class="data.formats.align == '' ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.align == '' ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">D</text><text :class="data.formats.align == '' ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">默认</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setAlignLeft" :class="data.formats.align == 'left' ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.align == 'left' ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">L</text><text :class="data.formats.align == 'left' ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">居左</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setAlignCenter" :class="data.formats.align == 'center' ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.align == 'center' ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">C</text><text :class="data.formats.align == 'center' ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">居中</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setAlignRight" :class="data.formats.align == 'right' ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.align == 'right' ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">R</text><text :class="data.formats.align == 'right' ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">居右</text></view></view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'more'">
            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">插入内容</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="chooseInsertImage" class="toolbar-chip toolbar-chip-grid"><text class="toolbar-chip-badge">IMG</text><text class="toolbar-chip-text">图片</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="toggleChecklistTool" :class="data.formats.list == 'check' ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'"><text :class="data.formats.list == 'check' ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'">TODO</text><text :class="data.formats.list == 'check' ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'">TODO</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="insertDivider" class="toolbar-chip toolbar-chip-grid"><text class="toolbar-chip-badge">---</text><text class="toolbar-chip-text">分割线</text></view></view>
              </view>
            </view>

            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">编辑操作</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="clearFormatting" class="toolbar-chip toolbar-chip-grid"><text class="toolbar-chip-badge">CLR</text><text class="toolbar-chip-text">清除样式</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="undo" class="toolbar-chip toolbar-chip-grid"><text class="toolbar-chip-badge">↶</text><text class="toolbar-chip-text">撤销</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="redo" class="toolbar-chip toolbar-chip-grid"><text class="toolbar-chip-badge">↷</text><text class="toolbar-chip-text">重做</text></view></view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="editor-stage" :style="getEditorStageStyle()">
      <editor
        id="editor"
        class="editor-field"
        placeholder="请输入正文内容..."
        show-img-size
        show-img-toolbar
        show-img-resize
        @ready="onEditorReady"
        @focus="onEditorFocus"
        @blur="onEditorBlur"
        @statuschange="onStatusChange"
      />
    </view>
  </view>
</template>

<script setup lang="uts">

type Formats = {
  bold: boolean;
  italic: boolean;
  underline: boolean;
  strike: boolean;
  // blockquote: boolean;
  header: number;
  list: string;
  align: string;
  color: string;
  backgroundColor: string;
}

type DataType = {
  toolbarVisible: boolean;
  toolbarBottom: number;
  keyboardHeight: number;
  pageWindowHeight: number;
  pageWindowWidth: number;
  sheetHeight: number;
  sheetTop: number;
  sheetLeft: number;
  sheetArrowLeft: number;
  sheetAnimated: boolean;
  isFocused: boolean;
  toolbarKeepVisible: boolean;
  activeSheet: string;
  autoTest: boolean;
  undoTest: boolean;
  redoTest: boolean;
  removeFormatTest: boolean;
  insertImageTest: boolean;
  blurTest: boolean;
  clearTest: boolean;
  getContentDeltaTest: any | null;
  formats: Formats;
}

const data = reactive({
  toolbarVisible: false,
  toolbarBottom: 0,
  keyboardHeight: 0,
  pageWindowHeight: 0,
  pageWindowWidth: 0,
  sheetHeight: 320,
  sheetTop: 74,
  sheetLeft: 12,
  sheetArrowLeft: 32,
  sheetAnimated: false,
  isFocused: false,
  toolbarKeepVisible: false,
  activeSheet: '',
  autoTest: false,
  undoTest: false,
  redoTest: false,
  removeFormatTest: false,
  insertImageTest: false,
  blurTest: false,
  clearTest: false,
  getContentDeltaTest: null,
  formats: {
    bold: false,
    italic: false,
    underline: false,
    strike: false,
    // blockquote: false,
    header: 0,
    list: '',
    align: '',
    color: '',
    backgroundColor: ''
  }
} as DataType)

const editorContext = ref<EditorContext | null>(null)

let keyboardChangeListenerId: number | null = null
let toolbarHideTimer = 0

function clearToolbarHideTimer() {
  if (toolbarHideTimer > 0) {
    clearTimeout(toolbarHideTimer)
    toolbarHideTimer = 0
  }
}

function scheduleToolbarHide() {
  clearToolbarHideTimer()
  toolbarHideTimer = setTimeout(() => {
    if (!data.isFocused && data.keyboardHeight <= 0 && data.activeSheet == '') {
      data.toolbarVisible = false
      data.toolbarBottom = 0
    }
    toolbarHideTimer = 0
  }, 120)
}

function getEditor() : EditorContext | null {
  return editorContext.value
}

function isWebToolbarMode() : boolean {
  // #ifdef WEB
  return true
  // #endif
  return false
}

function isToolbarRendered() : boolean {
  if (isWebToolbarMode()) {
    return true
  }
  return data.toolbarVisible
}

function getToolbarWrapStyle() : string {
  if (isWebToolbarMode()) {
    return ''
  }
  return `bottom:${data.toolbarBottom}px;`
}

function getSheetPanelStyle() : string {
  if (isWebToolbarMode()) {
    return ''
  }
  return `height:${data.sheetHeight}px;`
}

function getWebSheetWidth() : number {
  const windowWidth = data.pageWindowWidth > 0 ? data.pageWindowWidth : uni.getWindowInfo().windowWidth
  let maxWidth = windowWidth - 24
  if (maxWidth < 240) {
    maxWidth = windowWidth - 12
  }
  if (maxWidth < 220) {
    return maxWidth
  }
  if (data.activeSheet == 'title') {
    return maxWidth < 520 ? maxWidth : 520
  }
  if (data.activeSheet == 'style') {
    return maxWidth < 420 ? maxWidth : 420
  }
  if (data.activeSheet == 'align') {
    return maxWidth < 280 ? maxWidth : 280
  }
  return maxWidth < 360 ? maxWidth : 360
}

function getSheetHostStyle() : string {
  if (!isWebToolbarMode()) {
    return ''
  }
  return `left:${data.sheetLeft}px;top:${data.sheetTop}px;width:${getWebSheetWidth()}px;`
}

function getToolbarPanelArrowStyle() : string {
  if (!isWebToolbarMode()) {
    return ''
  }
  return `left:${data.sheetArrowLeft}px;`
}

function getToolbarShellClass() : string {
  if (isWebToolbarMode()) {
    if (data.activeSheet != '') {
      return 'toolbar-shell toolbar-shell-attached toolbar-shell-web'
    }
    return 'toolbar-shell toolbar-shell-web'
  }
  if (data.activeSheet != '') {
    return 'toolbar-shell toolbar-shell-attached'
  }
  return 'toolbar-shell'
}

function getToolbarScrollTrackClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-scroll-track toolbar-scroll-track-web'
  }
  return 'toolbar-scroll-track'
}

function getToolbarRowClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-row toolbar-row-scroll toolbar-row-web'
  }
  return 'toolbar-row toolbar-row-scroll'
}

function getToolbarPanelClass() : string {
  if (isWebToolbarMode()) {
    if (data.sheetAnimated) {
      return 'toolbar-panel toolbar-panel-attached toolbar-panel-web toolbar-panel-web-attached toolbar-panel-web-entered'
    }
    return 'toolbar-panel toolbar-panel-attached toolbar-panel-web toolbar-panel-web-attached'
  }
  return 'toolbar-panel toolbar-panel-attached'
}

function getToolbarPanelHeaderClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-header toolbar-panel-header-web'
  }
  return 'toolbar-panel-header'
}

function getToolbarPanelTitleClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-title toolbar-panel-title-web'
  }
  return 'toolbar-panel-title'
}

function getToolbarPanelSubtitleClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-subtitle toolbar-panel-subtitle-web'
  }
  return 'toolbar-panel-subtitle'
}

function getToolbarPanelScrollClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-scroll toolbar-panel-scroll-web'
  }
  return 'toolbar-panel-scroll'
}

function getToolbarChipRowClass() : string {
  if (!isWebToolbarMode()) {
    return 'toolbar-chip-row'
  }
  const panelWidth = getWebSheetWidth()
  if (panelWidth <= 300) {
    return 'toolbar-chip-row toolbar-chip-row-web toolbar-chip-row-web-compact'
  }
  return 'toolbar-chip-row toolbar-chip-row-web'
}

function getToolbarChipCellClass() : string {
  if (!isWebToolbarMode()) {
    return 'toolbar-chip-cell'
  }
  const panelWidth = getWebSheetWidth()
  if (panelWidth <= 300) {
    return 'toolbar-chip-cell toolbar-chip-cell-web toolbar-chip-cell-web-half'
  }
  if (panelWidth <= 420) {
    return 'toolbar-chip-cell toolbar-chip-cell-web toolbar-chip-cell-web-third'
  }
  return 'toolbar-chip-cell toolbar-chip-cell-web toolbar-chip-cell-web-quarter'
}

function getColorRowClass() : string {
  if (!isWebToolbarMode()) {
    return 'color-row'
  }
  return 'color-row color-row-web'
}

function refocusEditorAfterToolbarAction() {
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  setTimeout(() => {
    const editorElement = uni.getElementById('editor')
    if (editorElement != null) {
      editorElement.focus()
    }
    data.toolbarKeepVisible = false
  }, 30)
  // #endif
}

function updatePageWindowHeight() {
  const windowInfo = uni.getWindowInfo()
  data.pageWindowHeight = windowInfo.windowHeight
  data.pageWindowWidth = windowInfo.windowWidth
}

function getSheetButtonId(sheet: string) : string {
  if (sheet == 'more') {
    return 'toolbar-button-more'
  }
  if (sheet == 'title') {
    return 'toolbar-button-title'
  }
  if (sheet == 'style') {
    return 'toolbar-button-style'
  }
  return 'toolbar-button-align'
}

function updateWebSheetAnchor(sheet: string) {
  if (!isWebToolbarMode()) {
    return
  }
  updatePageWindowHeight()
  const pageShellElement = uni.getElementById('editor-page-shell')
  const buttonElement = uni.getElementById(getSheetButtonId(sheet))
  if (buttonElement == null || pageShellElement == null) {
    data.sheetTop = 74
    data.sheetLeft = 12
    data.sheetArrowLeft = 32
    return
  }
  const pageRect = pageShellElement.getBoundingClientRect()
  const rect = buttonElement.getBoundingClientRect()
  const panelWidth = getWebSheetWidth()
  const pageWidth = data.pageWindowWidth > 0 ? data.pageWindowWidth : uni.getWindowInfo().windowWidth
  let panelLeft = rect.left - pageRect.left + rect.width / 2 - panelWidth / 2
  let maxLeft = pageWidth - panelWidth - 12
  if (maxLeft < 12) {
    maxLeft = 12
  }
  if (panelLeft < 12) {
    panelLeft = 12
  }
  if (panelLeft > maxLeft) {
    panelLeft = maxLeft
  }
  let arrowLeft = rect.left - pageRect.left + rect.width / 2 - panelLeft - 8
  if (arrowLeft < 18) {
    arrowLeft = 18
  }
  if (arrowLeft > panelWidth - 30) {
    arrowLeft = panelWidth - 30
  }
  data.sheetTop = rect.bottom - pageRect.top + 12
  data.sheetLeft = panelLeft
  data.sheetArrowLeft = arrowLeft
}

function onEditorReady() {
  uni.createEditorContextAsync({
    id: 'editor',
    success: (context: EditorContext) => {
      editorContext.value = context
    },
    fail: (error: UniError) => {
      console.log('createEditorContextAsync fail', error)
    }
  } as CreateEditorContextAsyncOptions)
}

function applyFormat(name: string, value: string | number | boolean | null) {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.format(name, value)
  editor.scrollIntoView(null)
}

function getEditorBottomSpacing() : number {
  if (isWebToolbarMode()) {
    return 0
  }
  if (!data.toolbarVisible) {
    return 0
  }
  if (data.activeSheet != '') {
    return data.sheetHeight + 74
  }
  return 74
}

function getEditorStageStyle() : string {
  const paddingBottom = getEditorBottomSpacing()
  if (isWebToolbarMode()) {
    return `padding-bottom:${paddingBottom}px;`
  }
  if (data.keyboardHeight <= 0 || data.pageWindowHeight <= 0) {
    return `padding-bottom:${paddingBottom}px;`
  }
  let editorHeight = data.pageWindowHeight - data.keyboardHeight
  if (editorHeight < 120) {
    editorHeight = 120
  }
  return `height:${editorHeight}px;padding-bottom:${paddingBottom}px;`
}

function syncToolbarBottom() {
  if (data.activeSheet != '') {
    data.toolbarBottom = data.sheetHeight
    return
  }
  data.toolbarBottom = data.keyboardHeight
}

function syncToolbarVisibility() {
  if (data.activeSheet != '') {
    data.toolbarVisible = true
    return
  }
  if (data.isFocused) {
    data.toolbarVisible = true
    return
  }
  if (data.keyboardHeight > 0) {
    data.toolbarVisible = true
    return
  }
  if (data.toolbarKeepVisible) {
    data.toolbarVisible = true
    return
  }
  data.toolbarVisible = false
}

function closeSheets() {
  if (isWebToolbarMode()) {
    data.sheetAnimated = false
  }
  data.activeSheet = ''
  syncToolbarBottom()
  syncToolbarVisibility()
}

function hideKeyboardForSheet() {
  if (data.keyboardHeight > 0) {
    data.sheetHeight = data.keyboardHeight
  }
  data.isFocused = false
  uni.hideKeyboard()
}

function toggleSheet(sheet: string) {
  if (data.activeSheet == sheet) {
    closeSheets()
    return
  }
  updateWebSheetAnchor(sheet)
  data.activeSheet = sheet
  if (isWebToolbarMode()) {
    data.sheetAnimated = false
    setTimeout(() => {
      if (data.activeSheet == sheet) {
        data.sheetAnimated = true
      }
    }, 16)
  }
  hideKeyboardForSheet()
  syncToolbarBottom()
  syncToolbarVisibility()
}

function openMoreSheet() {
  toggleSheet('more')
}

function openTitleSheet() {
  toggleSheet('title')
}

function openStyleSheet() {
  toggleSheet('style')
}

function openAlignSheet() {
  toggleSheet('align')
}

function getPanelTitle() : string {
  if (data.activeSheet == 'title') {
    return '设置标题'
  }
  if (data.activeSheet == 'style') {
    return '设置字格式'
  }
  if (data.activeSheet == 'align') {
    return '居中设置'
  }
  return '更多操作'
}

function getTitleSummary() : string {
  // if (data.formats.blockquote) {
  //   return '当前为引用'
  // }
  if (data.formats.list == 'ordered') {
    return '当前为有序列表'
  }
  if (data.formats.list == 'bullet') {
    return '当前为无序列表'
  }
  if (data.formats.header > 0) {
    return `当前为大标题${data.formats.header}`
  }
  return '当前为正文'
}

function getStyleSummary() : string {
  const names: string[] = []
  if (data.formats.bold) {
    names.push('加粗')
  }
  if (data.formats.italic) {
    names.push('斜体')
  }
  if (data.formats.underline) {
    names.push('下划线')
  }
  if (data.formats.strike) {
    names.push('删除线')
  }
  if (data.formats.color != '') {
    names.push('已设颜色')
  }
  if (names.length == 0) {
    return '当前未设置字格式'
  }
  return names.join(' / ')
}

function getAlignSummary() : string {
  if (data.formats.align == '') {
    return '当前为默认对齐'
  }
  if (data.formats.align == 'center') {
    return '当前为居中'
  }
  if (data.formats.align == 'right') {
    return '当前为居右'
  }
  return '当前为居左'
}

function getPanelSubtitle() : string {
  if (data.activeSheet == 'title') {
    return getTitleSummary()
  }
  if (data.activeSheet == 'style') {
    return getStyleSummary()
  }
  if (data.activeSheet == 'align') {
    return getAlignSummary()
  }
  return '插入与编辑快捷操作'
}

function hasInlineStyleActive() : boolean {
  return data.formats.bold || data.formats.italic || data.formats.underline || data.formats.strike || data.formats.color != ''
}

function hasTitleFormatActive() : boolean {
  return data.formats.header > 0 || data.formats.list != ''
}

function isTitleSheetHighlighted() : boolean {
  return data.activeSheet == 'title' || hasTitleFormatActive()
}

function isStyleSheetHighlighted() : boolean {
  return data.activeSheet == 'style' || hasInlineStyleActive()
}

function isAlignSheetHighlighted() : boolean {
  return data.activeSheet == 'align' || data.formats.align != ''
}

function isParagraphActive() : boolean {
  return data.formats.header == 0 && data.formats.list == ''
}

function clearTitleFormats() {
  // applyFormat('blockquote', false)
  applyFormat('list', null)
}

function setParagraph() {
  clearTitleFormats()
  applyFormat('header', 0)
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setHeadingLevel(level: number) {
  clearTitleFormats()
  if (data.formats.header == level) {
    applyFormat('header', 0)
  } else {
    applyFormat('header', level)
  }
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setOrderedList() {
  // applyFormat('blockquote', false)
  applyFormat('header', 0)
  applyFormat('list', data.formats.list == 'ordered' ? null : 'ordered')
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setBulletList() {
  // applyFormat('blockquote', false)
  applyFormat('header', 0)
  applyFormat('list', data.formats.list == 'bullet' ? null : 'bullet')
  closeSheets()
  refocusEditorAfterToolbarAction()
}

// function toggleBlockquote() {
//   applyFormat('header', 0)
//   applyFormat('list', null)
//   applyFormat('blockquote', data.formats.blockquote ? false : true)
//   closeSheets()
// }

function toggleBold() {
  applyFormat('bold', null)
}

function toggleItalic() {
  applyFormat('italic', null)
}

function toggleUnderline() {
  applyFormat('underline', null)
}

function toggleStrike() {
  applyFormat('strike', null)
}

function toggleBoldAndClose() {
  toggleBold()
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function toggleItalicAndClose() {
  toggleItalic()
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function toggleUnderlineAndClose() {
  toggleUnderline()
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function toggleStrikeAndClose() {
  toggleStrike()
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setTextColor(color: string) {
  applyFormat('color', color == '' ? null : color)
}

function setTextColorAndClose(color: string) {
  setTextColor(color)
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setBackgroundColor(color: string) {
  applyFormat('background', color == '' ? null : color)
}

function setBackgroundColorAndClose(color: string) {
  setBackgroundColor(color)
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setAlignLeft() {
  applyFormat('align', 'left')
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setAlignCenter() {
  applyFormat('align', 'center')
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function setAlignRight() {
  applyFormat('align', 'right')
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function clearAlign() {
  applyFormat('align', null)
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function clearFormatting() {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.removeFormat(null)
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function toggleChecklistTool() {
  applyFormat('list', data.formats.list == 'check' ? null : 'check')
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function insertDivider() {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.insertDivider(null)
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function insertMention () {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  // 此处插入的两个 mention 测试例会用到
  editor.insertMention({
    id: '123456',
    name: 'uni-app',
    success: (res: any) => {
      console.log('insert mention success')
    }
  })
  editor.insertMention({
    id: '000',
    name: 'uni-app x',
    color: '#fff',
    background: '#42b983',
    radius: '10px',
    success: (res: any) => {
      console.log('insert mention success')
    }
  })
}

function getCon () {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.getContents({
    success: (res: UniEditorElementGetContentsOptionsRes) => {
      console.log('文本详情：', res)
      data.getContentDeltaTest = res.delta
    },
    fail: (err: any) => {
      console.log(err)
    }
  })
}

// 自动化测试专用
const setContents = (options: any) => {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.setContents({
    delta: {
      ops: options
    },
    success: (res: any) => {
      console.log('setContents-success', res)
    },
    fail: (err: any) => {
      console.log(err)
    }
  })
}

const blur = () => {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.blur({
    success: (res: any) => {
      console.log('编辑器失焦：', res)
      data.blurTest = true
    },
    fail: (err: any) => {
      console.log(err)
      data.blurTest = false
    }
  })
}

const clear = () => {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.clear({
    success: function (res: any) {
      console.log("clear success",res)
      data.clearTest = true
    },
    fail: (err: any) => {
      console.log(err)
      data.clearTest = false
    }
  })
}

const clearShowModal = () => {
  uni.showModal({
    title: '清空编辑器',
    content: '确定清空编辑器全部内容？',
    success: (res) => {
      if (res.confirm) {
        clear()
      }
    }
  })
}

const removeFormat = () => {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.removeFormat({
    success: (res: any) => {
      console.log('removeFormat-success', res)
      data.removeFormatTest = true
    },
    fail: (err: any) => {
      console.log(err)
      data.removeFormatTest = false
    }
  })
}

function insertImage(path: string) {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  const options: UniEditorElementInsertImageOptions = {
    src: path,
    alt: 'image',
    success: () => {
      data.insertImageTest = true
    },
    fail: () => {
      data.insertImageTest = false
    }
  }
  editor.insertImage(options)
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function chooseInsertImage() {
  uni.chooseImage({
    count: 1,
    success: (res: ChooseImageSuccess) => {
      const paths = res.tempFilePaths
      if (paths.length > 0) {
        insertImage(paths[0])
      }
    }
  })
}

function undo() {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.undo({
    success: () => {
      data.undoTest = true
    },
    fail: () => {
      data.undoTest = false
    }
  })
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function redo() {
  const editor = getEditor()
  if (editor == null) {
    return
  }
  editor.redo({
    success: () => {
      data.redoTest = true
    },
    fail: () => {
      data.redoTest = false
    }
  })
  closeSheets()
  refocusEditorAfterToolbarAction()
}

function hideEditorKeyboard() {
  uni.hideKeyboard()
  data.isFocused = false
  data.toolbarKeepVisible = false
  closeSheets()
  syncToolbarBottom()
  syncToolbarVisibility()
  scheduleToolbarHide()
}

// #ifdef WEB
function onToolbarMouseDown(event: UniMouseEvent) {
  clearToolbarHideTimer()
  data.toolbarVisible = true
  event.preventDefault()
}

// #endif

function onToolbarTouchStart(event: UniTouchEvent) {
  clearToolbarHideTimer()
  data.toolbarVisible = true
  // #ifndef WEB
  data.toolbarKeepVisible = true
  // #endif
}

function onEditorFocus(event: UniEditorFocusEvent) {
  console.log('onEditorFocus')
  clearToolbarHideTimer()
  if (data.activeSheet != '') {
    data.activeSheet = ''
  }
  data.isFocused = true
  data.toolbarKeepVisible = false
  syncToolbarVisibility()
  syncToolbarBottom()
}

function onEditorBlur(event: UniEditorBlurEvent) {
  data.isFocused = false
  if (data.activeSheet == '') {
    syncToolbarBottom()
    // #ifndef WEB
    if (data.toolbarKeepVisible) {
      data.toolbarVisible = true
      return
    }
    // #endif
    // #ifdef WEB
    data.toolbarVisible = true
    return
    // #endif
    syncToolbarVisibility()
    scheduleToolbarHide()
  }
}

function onStatusChange(event: UniEditorStatusChangeEvent) {
  const formats = event.detail
  data.formats.bold = formats.bold == true
  data.formats.italic = formats.italic == true
  data.formats.underline = formats.underline == true
  data.formats.strike = formats.strike == true
  // data.formats.blockquote = formats.blockquote == true
  data.formats.header = formats.header != null ? formats.header : 0
  data.formats.list = formats.list != null ? formats.list : ''
  data.formats.align = formats.align != null ? formats.align : ''
  data.formats.color = formats.color != null ? formats.color : ''
  data.formats.backgroundColor = formats.backgroundColor != null ? formats.backgroundColor : ''
}

onLoad(() => {
  // editor 内部基于 web-view，键盘高度用全局 API 更稳妥
  keyboardChangeListenerId = uni.onKeyboardHeightChange((res) => {
    data.keyboardHeight = res.height
    if (res.height > 0) {
      data.sheetHeight = res.height
      if (data.activeSheet != '') {
        data.activeSheet = ''
      }
    }
    syncToolbarBottom()
    if (res.height > 0) {
      syncToolbarVisibility()
      return
    }
    if (data.activeSheet != '') {
      data.toolbarVisible = true
      return
    }
    if (data.isFocused) {
      data.toolbarVisible = true
      return
    }
    if (data.toolbarKeepVisible) {
      data.toolbarVisible = true
      return
    }
    scheduleToolbarHide()
  })
})

onReady(() => {
  updatePageWindowHeight()
})

onResize((options: OnResizeOptions) => {
  data.pageWindowHeight = options.size.windowHeight
  data.pageWindowWidth = options.size.windowWidth
  if (isWebToolbarMode() && data.activeSheet != '') {
    updateWebSheetAnchor(data.activeSheet)
  }
})

onUnload(() => {
  clearToolbarHideTimer()
  if (keyboardChangeListenerId != null) {
    uni.offKeyboardHeightChange(keyboardChangeListenerId)
    keyboardChangeListenerId = null
  }
})

defineExpose({
  data,
  openMoreSheet,
  openTitleSheet,
  openStyleSheet,
  openAlignSheet,
  closeSheets,
  setContents,
  blur,
  clear,
  insertDivider,
  undo,
  redo,
  insertImage,
  removeFormat,
  insertMention,
  getCon
})
</script>

<style>
