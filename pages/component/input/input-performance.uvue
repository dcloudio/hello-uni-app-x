<template>
<!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-direction: column;background-color: #f5f5f5;">
      <fps />
      <!-- 控制按钮区域 -->
      <view style="padding: 2px;background-color: #ffffff;flex-direction: row;flex-wrap: wrap;align-items: center;">
        <button @click="clearValue" size="mini" style="margin: 2px;">清空内容</button>
        <button @click="toggleDisabled" :type="sharedDisabled ? 'primary' : 'default'" size="mini" style="margin: 2px;">{{ sharedDisabled ? '启用' : '禁用' }}输入</button>
        <text style="font-size: 11px;color: #666;margin-left: 5px;">值: {{ sharedValue == '' ? '(空)' : sharedValue }}</text>
      </view>

      <!-- 100个input组件 -->
      <view style="flex-direction: row;flex-wrap: wrap;padding: 2px;">
        <template v-for="index in 100" :key="index">
          <input
            :value="sharedValue"
            :placeholder="index.toString()"
            :disabled="sharedDisabled"
            @input="onInput"
            style="width: 15%;margin: 1px;border: 1px solid #ddd;padding: 2px;font-size: 9px;border-radius: 2px;background-color: #fff;height: 30px;"
          />
        </template>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  const sharedValue = ref('')
  const sharedDisabled = ref(false)

  function onInput(e : UniInputEvent) {
    sharedValue.value = e.detail.value
    console.log('input value changed:', e.detail.value)
  }

  function clearValue() {
    sharedValue.value = ''
    console.log('value cleared')
  }

  function toggleDisabled() {
    sharedDisabled.value = !sharedDisabled.value
    console.log('disabled:', sharedDisabled.value)
  }
</script>

<style>
</style>
