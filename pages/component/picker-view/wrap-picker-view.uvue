<template>
  <view>
    <MyPickerView ref='pickerViewRef' v-if='visible'></MyPickerView>
    <button class="btn_toggle" @click="toggle">btn</button>
  </view>
</template>

<script setup lang="uts">
  
  import MyPickerView from './picker-view.uvue'

  const visible = ref(false)
  const pickerViewRef = ref(null)

  function setValue() {
    const instance = getCurrentInstance()!.proxy!.$refs['pickerViewRef']
    if (instance != null) {
      (instance as ComponentPublicInstance).$callMethod('setValue')
    }
  }

  function toggle() {
    visible.value = !visible.value
    if (visible.value) {
      nextTick(() => {
        setValue()
      })
    }
  }
</script>

<style>

</style>
