<template>
  <view>
    <canvas class="drawing" id="tablet" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd"></canvas>
    <button @click="doClear()">清空</button>
  </view>
</template>

<script setup lang="uts">


type Point = {
  x : number
  y : number
}

// Data
const lastPointX = ref(0)
const lastPointY = ref(0)
const offsetX = ref(0)
const offsetY = ref(0)
const renderingContext = ref(null as CanvasRenderingContext2D | null)

// Methods
function getPosition(event : TouchEvent) : Point {
  const touch = event.touches[0]
  // #ifndef MP-WEIXIN
  return {
    x: touch.clientX - offsetX.value,
    y: touch.clientY - offsetY.value
  } as Point
  // #endif

  // #ifdef MP-WEIXIN
  return {
    x: touch.x,
    y: touch.y
  } as Point
  // #endif
}

function touchStart(event : TouchEvent) {
  const position = getPosition(event)
  lastPointX.value = position.x
  lastPointY.value = position.y
}

function touchMove(event : TouchEvent) {
  const position = getPosition(event)
  const x = position.x
  const y = position.y

  const ctx = renderingContext.value!
  ctx.lineWidth = 5
  ctx.lineCap = "round"
  ctx.lineJoin = "round"
  ctx.beginPath()
  ctx.moveTo(lastPointX.value, lastPointY.value)
  ctx.lineTo(x, y)
  ctx.stroke()

  lastPointX.value = x
  lastPointY.value = y
}

function touchEnd(event : TouchEvent) {
}

function doClear() {
  if (renderingContext.value != null) {
    renderingContext.value!.clearRect(0, 0, renderingContext.value!.canvas.width, renderingContext.value!.canvas.height)
  }
}

// Lifecycle
onReady(() => {
  uni.createCanvasContextAsync({
    id: 'tablet',
    success: (context : CanvasContext) => {
      console.log('success')
      renderingContext.value = context.getContext('2d')!
      const canvas = renderingContext.value!.canvas

      const dpr = uni.getWindowInfo().pixelRatio
      canvas.width = canvas.offsetWidth * dpr
      canvas.height = canvas.offsetHeight * dpr
      renderingContext.value!.scale(dpr, dpr)

      // #ifndef MP
      const elRect = canvas.getBoundingClientRect()
      offsetX.value = elRect.left
      offsetY.value = elRect.top
      // #endif
    }
  })
})
</script>

<style>
  .drawing {
    width: 100%;
    height: 500px;
    background-color: lightgray;
    margin-bottom: 15px;
  }
</style>
