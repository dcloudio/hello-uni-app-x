<template>
  <view>
    <canvas id="canvas1"></canvas>
  </view>
  <view>
    <canvas id="canvas2"></canvas>
  </view>
  <view>
    {{testCounter}}
  </view>
</template>

<script setup lang="uts">


// 仅测试
const testCounter = ref(0)

function _dispatchEvent() {
  if (testCounter.value == 2) {
    uni.$emit('canvasChildReady')
  }
}

function onMounted() {
  const instance = getCurrentInstance()!.proxy!
  uni.createCanvasContextAsync({
    id: 'canvas1',
    component: instance,
    success: (_ : CanvasContext) => {
      testCounter.value++
      _dispatchEvent()
    }
  });
  uni.createCanvasContextAsync({
    id: 'canvas2',
    component: instance,
    success: (_ : CanvasContext) => {
      testCounter.value++
      _dispatchEvent()
    }
  });
}
</script>
