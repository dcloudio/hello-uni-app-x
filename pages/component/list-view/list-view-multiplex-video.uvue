<template>
  <!-- #ifdef WEB -->
  <view>
  <!-- #endif -->
    <list-view class="list" @scrolltolower="onScrollTolower">
      <list-item class="list-item" v-for="(_,index) in item_count">
        <text>第{{index + 1}}个视频</text>
        <video class="video" :src="src" :controls="true" @pause="onPause"></video>
      </list-item>
    </list-view>
  <!-- #ifdef WEB -->
  </view>
  <!-- #endif -->
</template>

<script setup lang="uts">


const item_count = ref(10)
const src = ref('https://qiniu-web-assets.dcloud.net.cn/video/sample/2minute-demo.mp4')
const isTesting = ref(false)

function onPause(e : UniEvent) {
  console.log(JSON.stringify(e));
}

function onScrollTolower(event : ScrollToLowerEvent) {
  setTimeout(() => {
    if (isTesting.value && item_count.value >= 10) {
      return
    }
    item_count.value += 10
  }, 300)
}
</script>

<style>
  .list {
    flex: 1;
  }

  .list-item {
    background-color: white;
    margin-bottom: 30px;
  }

  .video {
    width: 100%;
    height: 200px;
  }
</style>
