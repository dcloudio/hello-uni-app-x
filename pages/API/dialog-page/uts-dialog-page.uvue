<template>
  <view class="content">
    <page-intro content="本页通过 uts 插件调用 openDialogPage，点击按钮打开 dialog 页面。"></page-intro>
    <button @tap="doOpendDialogpage()">open dialogpage</button>
  </view>

</template>

