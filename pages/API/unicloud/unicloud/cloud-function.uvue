<template>
  <!-- #ifdef APP -->
  <scroll-view class="page-scroll-view">
  <!-- #endif -->
    <view>
      <page-head :title="title"></page-head>
      <view class="uni-padding-wrap uni-common-mt">
        <view class="uni-btn-v uni-common-mt">
          <button type="primary" @click="callFunction">请求云函数</button>
          <button type="primary" @click="callFunctionWithGeneric">请求云函数传入泛型</button>
          <!-- #ifdef APP-ANDROID || APP-IOS -->
          <button type="primary" @click="callEncryptionFunction">请求安全网络加密云函数</button>
          <button type="primary" @click="callVerifyFunction">请求安全网络客户端校验云函数</button>
          <view><text class="tips">安全网络相关功能需要打包自定义基座方可正常使用</text></view>
          <!-- #endif -->
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">


const title = ref('请求云函数')
const callFunctionResult = ref({})
const callFunctionResult_Detail_functionName = ref('')
const callFunctionError = ref({})
const genericDemoShowMessage = ref('')
const isUniTest = ref(false)

function notify(content : string, title : string) {
  if (!isUniTest.value) {
    uni.showModal({
      title,
      content,
      showCancel: false
    })
  } else {
    console.log(title, content)
  }
}

async function callFunctionWithGeneric(): Promise<void> {
  type EchoCfResult = {
    showMessage : string
  }
  uni.showLoading({
    title: '加载中...'
  })
  await uniCloud.callFunction<EchoCfResult>({
    name: 'echo-cf',
    data: {
      num: 1,
      str: 'ABC'
    }
  }).then(res => {
    const result = res.result
    uni.hideLoading()
    genericDemoShowMessage.value = result.showMessage
    notify(result.showMessage, '提示')
  }).catch((err : any | null) => {
    const error = err as UniCloudError
    callFunctionError.value = {
      errCode: error.errCode,
      errMsg: error.errMsg
    }
    uni.hideLoading()
    notify(error.errMsg, '错误')
  })
}

async function callFunction(): Promise<void> {
  uni.showLoading({
    title: '加载中...'
  })
  await uniCloud.callFunction({
    name: 'echo-cf',
    data: {
      num: 1,
      str: 'ABC'
    }
  }).then(res => {
    const result = res.result
    callFunctionResult.value = result
    const detail = result.get('detail') as UTSJSONObject
    callFunctionResult_Detail_functionName.value = detail.get('functionName') as string
    console.log('callFunctionResult_Detail_functionName: ' + callFunctionResult_Detail_functionName.value)
    console.log(JSON.stringify(result))
    uni.hideLoading()
    notify(result['showMessage'] as string, '提示')
  }).catch((err : any | null) => {
    uni.hideLoading()
    if(err instanceof UniCloudError) {
      const error = err as UniCloudError
      callFunctionError.value = {
        errCode: error.errCode,
        errMsg: error.errMsg
      }
      notify(error.errMsg, '错误')
    } else {
      console.error(err)
    }
  })
}

function callEncryptionFunction() {
  uni.showLoading({
    title: '加载中...'
  })
  uniCloud.callFunction({
    name: 'encryption',
    data: {},
    secretType: 'both'
  }).then(res => {
    uni.hideLoading()
    notify(JSON.stringify(res.result), '提示')
  }).catch((err : any | null) => {
    uni.hideLoading()
    if(err instanceof UniCloudError) {
      const error = err as UniCloudError
      callFunctionError.value = {
        errCode: error.errCode,
        errMsg: error.errMsg
      }
      notify(error.errMsg, '错误')
    } else {
      console.error(err)
    }
  })
}

function callVerifyFunction() {
  uni.showLoading({
    title: '加载中...'
  })
  uniCloud.callFunction({
    name: 'verify-client',
    data: {}
  }).then(res => {
    uni.hideLoading()
    notify(JSON.stringify(res.result), '提示')
  }).catch((err : any | null) => {
    uni.hideLoading()
    if(err instanceof UniCloudError) {
      const error = err as UniCloudError
      callFunctionError.value = {
        errCode: error.errCode,
        errMsg: error.errMsg
      }
      notify(error.errMsg, '错误')
    } else {
      console.error(err)
    }
  })
}

function jest_UniCloudError() {
  return new Error() instanceof UniCloudError
}

onLoad((options : OnLoadOptions) => {
})

onUnload(() => {
  if (isUniTest.value) {
    uni.hideToast()
  }
})
</script>

<style>
  .tips {
    color: #999999;
    font-size: 12px;
    padding: 10px 0px;
  }
</style>
