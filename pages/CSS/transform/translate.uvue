<template>
  <scroll-view class="page">
    <view class="trace">
      <view class="base reserve">
        <text class="reserve-text">translateX(80%)</text>
        <text class="reserve-text">转变前位置</text>
      </view>
      <view class="base reserve">
        <text class="reserve-text">translateY(50px)</text>
        <text class="reserve-text">转变前位置</text>
      </view>
      <view class="base reserve">
        <text class="reserve-text">translate(-50%,50%)</text>
        <text class="reserve-text">转变前位置</text>
      </view>
    </view>

    <view class="base transform" style="transform: translateX(80%)">
      <text>translateX(80%)</text>
      <text>转变后位置</text>
    </view>
    <!-- #ifdef VUE3-VAPOR -->
    <view class="base transform" style="transform: translateX(80%)" flatten>
      <text>translateX(80%)</text>
      <text>转变后位置</text>
    </view>
    <!-- #endif -->
    <view class="base transform" style="transform: translateY(50px)">
      <text>translateY(50px)</text>
      <text>转变后位置</text>
    </view>
    <!-- #ifdef VUE3-VAPOR -->
    <view class="base transform" style="transform: translateY(50px)" flatten>
      <text>translateY(50px)</text>
      <text>转变后位置</text>
    </view>
    <!-- #endif -->
    <view class="base transform" style="transform: translate(-50%, 50%)">
      <text>translate(-50%,50%)</text>
      <text>转变后位置</text>
    </view>
    <!-- #ifdef VUE3-VAPOR -->
    <view class="base transform" style="transform: translate(-50%, 50%)" flatten>
      <text>translate(-50%,50%)</text>
      <text>转变后位置</text>
    </view>
    <!-- #endif -->

    <view style="margin-top: 150px; margin-left: 10px;">
      <text class="uni-title-text">style.setProperty 动态设置 transform (translate) 测试</text>
      <text>transform: {{transformValue}}</text>
    </view>

    <view ref="viewRef" class="base transform" style="transform: translateX(0px);" @click="changeTransform('translateX(80px)')">
      <text>点击修改 transform 为 translateX(80px)</text>
    </view>

    <navigator style="margin-top: 50px; width: 80%;" url="/pages/CSS/transform/transform-origin">
      <button type="primary">transform-origin</button>
    </navigator>
  </scroll-view>
</template>

<script setup lang="uts">
  const transformValue = ref('translateX(0px)')
  const viewRef = ref(null as UniElement | null)

  const changeTransform = (value: string) => {
    transformValue.value = value
    viewRef.value?.style.setProperty('transform', value)
  }
</script>

<style>
  .page {
    flex: 1;
    align-items: center;
  }

  .trace {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100%;
    align-items: center;
  }

  .base {
    margin: 10px;
    width: 150px;
    height: 150px;
    align-items: center;
    justify-content: center;
  }

  .reserve {
    border: 1px dotted #588;
    background-color: #DDD;
  }

  .reserve-text {
    color: #CCC;
  }

  .transform {
    border: 1px solid #00F;
    background-color: rgba(0, 255, 255, 0.5);
  }
</style>
