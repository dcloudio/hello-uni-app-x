<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view class="pages">
      <view class="trace">
        <view class="base reserve">
          <text class="reserve-text">rotate(20deg)</text>
          <text class="reserve-text">转变前位置</text>
        </view>
        <view class="base reserve">
          <text class="reserve-text">rotateX(50deg)</text>
          <text class="reserve-text">转变前位置</text>
        </view>
        <view class="base reserve">
          <text class="reserve-text">rotateY(50deg)</text>
          <text class="reserve-text">转变前位置</text>
        </view>
        <view class="base reserve">
          <text class="reserve-text">rotateZ(50deg)</text>
          <text class="reserve-text">转变前位置</text>
        </view>
        <view class="base reserve">
          <text class="reserve-text">rotateX(180deg)</text>
          <text class="reserve-text">转变前位置</text>
        </view>
        <view class="base reserve">
          <text class="reserve-text">rotateY(180deg)</text>
          <text class="reserve-text">转变前位置</text>
        </view>
      </view>

      <view class="base transform" style="transform: rotate(20deg)">
        <text>rotate(20deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotate(20deg)" flatten>
        <text>rotate(20deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateX(50deg)">
        <text>rotateX(50deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateX(50deg)" flatten>
        <text>rotateX(50deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateY(50deg)">
        <text>rotateY(50deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateY(50deg)" flatten>
        <text>rotateY(50deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateZ(50deg)">
        <text>rotateZ(50deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateZ(50deg)" flatten>
        <text>rotateZ(50deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateX(180deg)">
        <text>rotateX(180deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateX(180deg)" flatten>
        <text>rotateX(180deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateY(180deg)">
        <text>rotateY(180deg)</text>
        <text>转变后位置</text>
      </view>
      <view class="base transform" style="transform: rotateY(180deg)" flatten>
        <text>rotateY(180deg)</text>
        <text>转变后位置</text>
      </view>

      <view style="margin-top: 20px; margin-left: 10px;">
        <text class="uni-title-text">text 组件 rotate 测试</text>
      </view>

      <view class="base text-base-box">
        <text class="text-base" style="transform: rotate(20deg)">rotate(20deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotate(20deg)" flatten>rotate(20deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateX(50deg)">rotateX(50deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateX(50deg)" flatten>rotateX(50deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateY(50deg)">rotateY(50deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateY(50deg)" flatten>rotateY(50deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateZ(50deg)">rotateZ(50deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateZ(50deg)" flatten>rotateZ(50deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateX(180deg)">rotateX(180deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateX(180deg)" flatten>rotateX(180deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateY(180deg)">rotateY(180deg)</text>
      </view>
      <view class="base text-base-box">
        <text class="text-base" style="transform: rotateY(180deg)" flatten>rotateY(180deg)</text>
      </view>

      <view style="margin-top: 20px; margin-left: 10px;">
        <text class="uni-title-text">image 组件 rotate 测试</text>
      </view>

      <view class="base image-base-box">
        <text class="image-label">rotate(20deg) 旋转 20 度</text>
        <image class="image-base" style="transform: rotate(20deg)" src="/static/test-image/logo.png"></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotate(20deg) 旋转 20 度</text>
        <image class="image-base" style="transform: rotate(20deg)" src="/static/test-image/logo.png" flatten></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateX(50deg) 绕 X 轴旋转 50 度</text>
        <image class="image-base" style="transform: rotateX(50deg)" src="/static/test-image/logo.png"></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateX(50deg) 绕 X 轴旋转 50 度</text>
        <image class="image-base" style="transform: rotateX(50deg)" src="/static/test-image/logo.png" flatten></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateY(50deg) 绕 Y 轴旋转 50 度</text>
        <image class="image-base" style="transform: rotateY(50deg)" src="/static/test-image/logo.png"></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateY(50deg) 绕 Y 轴旋转 50 度</text>
        <image class="image-base" style="transform: rotateY(50deg)" src="/static/test-image/logo.png" flatten></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateZ(50deg) 绕 Z 轴旋转 50 度</text>
        <image class="image-base" style="transform: rotateZ(50deg)" src="/static/test-image/logo.png"></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateZ(50deg) 绕 Z 轴旋转 50 度</text>
        <image class="image-base" style="transform: rotateZ(50deg)" src="/static/test-image/logo.png" flatten></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateX(180deg) 绕 X 轴旋转 180 度</text>
        <image class="image-base" style="transform: rotateX(180deg)" src="/static/test-image/logo.png"></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateX(180deg) 绕 X 轴旋转 180 度</text>
        <image class="image-base" style="transform: rotateX(180deg)" src="/static/test-image/logo.png" flatten></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateY(180deg) 绕 Y 轴旋转 180 度</text>
        <image class="image-base" style="transform: rotateY(180deg)" src="/static/test-image/logo.png"></image>
      </view>
      <view class="base image-base-box">
        <text class="image-label">rotateY(180deg) 绕 Y 轴旋转 180 度</text>
        <image class="image-base" style="transform: rotateY(180deg)" src="/static/test-image/logo.png" flatten></image>
      </view>

      <view style="margin-top: 20px; margin-left: 10px;">
        <text class="uni-title-text">style.setProperty 动态设置 transform (rotate) 测试</text>
        <text>transform: {{transformValue}}</text>
      </view>

      <view class="base image-base-box" style="padding-bottom: 50px;">
        <view ref="viewRef" class="base transform" style="transform: rotate(0deg);" @click="changeTransform('rotate(45deg)')">
          <text>点击修改 transform 为 rotate(45deg)</text>
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  const transformValue = ref('rotate(0deg)')
  const viewRef = ref(null as UniElement | null)

  const changeTransform = (value: string) => {
    transformValue.value = value
    viewRef.value?.style.setProperty('transform', value)
  }
</script>

<style>
  .pages {
    align-items: center;
  }

  .trace {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100%;
    align-items: center;
  }

  .base {
    margin: 10px;
    width: 150px;
    height: 150px;
    align-items: center;
    justify-content: center;
  }

  .reserve {
    border: 1px dotted #588;
    background-color: #ddd;
  }

  .reserve-text {
    color: #ccc;
  }

  .text-base-box{
    width: 220px;
    height: 150px;
  }

  .image-base-box{
    width: 260px;
    height: 260px;
  }

  .image-label {
    text-align: center;
    margin-bottom: 20px;
    width: 300px;
  }

  .transform {
    border: 1px solid #00f;
    background-color: rgba(0, 255, 255, 0.5);
  }

  .text-base {
    width: 150px;
    height: 50px;
    padding: 10px;
    font-size: 16px;
    background-color: rgba(0, 255, 255, 0.5);
    border: 1px solid #00f;
    text-align: center;
  }

  .image-base {
    width: 150px;
    height: 150px;
    border: 1px solid #00f;
  }
</style>
