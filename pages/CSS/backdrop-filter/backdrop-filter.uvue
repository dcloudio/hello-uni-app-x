  left: 20px;
  right: 20px;
  pointer-events: none;
  z-index: 10;
}

.logo-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 12px;
}

.logo-item {
  width: 33%;
}

.color-box {
  flex: 1;
  height: 64px;
}

.demo-section {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 16px;
}

.demo-slot {
  flex: 1;
  align-items: center;
}

.demo-label {
  margin: 4px;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 4px 6px;
  box-shadow: 3px 3px 3px gray;
}

.glass-box {
  width: 100px;
  height: 100px;
  background-color: rgba(255, 255, 255, 0.3);
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.4);
  border-radius: 16px;
}

.demo-label-stack {
  align-items: center;
}

.control-section {
  margin-bottom: 6px;
}

