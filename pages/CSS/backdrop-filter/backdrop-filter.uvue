<template>
	<view class="page">
		<view class="demo-section">
			<view class="demo-row demo-row-three">
				<view class="demo-item">
					<view class="demo-stage">
						<image class="preview-image" src="/static/mount_cook.jpg" mode="aspectFill"></image>
						<view class="glass-box glass-box-center" style="backdrop-filter: blur(4px);"></view>
					</view>
					<text class="demo-label">静态 4px</text>
				</view>
				<view class="demo-item demo-item-spaced">
					<view class="demo-stage">
						<image class="preview-image" src="/static/mount_cook.jpg" mode="aspectFill"></image>
						<view class="glass-box glass-box-center" style="backdrop-filter: blur(8px);"></view>
					</view>
					<text class="demo-label">静态 8px</text>
				</view>
				<view class="demo-item demo-item-spaced">
					<view class="demo-stage">
						<image class="preview-image" src="/static/mount_cook.jpg" mode="aspectFill"></image>
						<view class="glass-box glass-box-center" style="backdrop-filter: blur(12px);"></view>
					</view>
					<text class="demo-label">静态 12px</text>
				</view>
			</view>

			<view class="demo-row demo-row-two">
				<view class="demo-item">
					<view class="demo-stage">
						<image class="preview-image" src="/static/mount_cook.jpg" mode="aspectFill"></image>
						<view class="glass-box glass-box-center" :style="getDynamicBlurStyle()"></view>
					</view>
					<text class="demo-label">动态 {{ blurValue }}px</text>
				</view>
				<view class="demo-item demo-item-spaced">
					<view class="demo-stage">
						<image class="preview-image" src="/static/mount_cook.jpg" mode="aspectFill"></image>
						<view class="glass-box glass-box-center" :style="getDynamicRichStyle()"></view>
					</view>
					<text class="demo-label">动态 {{ blurValue }}px / {{ colorLabel }} / {{ borderWidthValue }}px</text>
				</view>
			</view>

			<view class="control-section">
				<view class="control-row control-row-column">
					<text class="control-title">模糊半径</text>
					<slider class="control-slider"
						:min="0"
						:max="15"
						:step="1"
						:value="blurValue"
						:show-value="true"
						@changing="updateBlurValue"
						@change="updateBlurValue"
					/>
				</view>

				<view class="control-row control-row-column">
					<text class="control-title">背景颜色</text>
					<radio-group class="radio-group" @change="updateBackgroundColor">
						<radio class="radio-item" value="rgba(255, 255, 255, 0.24)" :checked="backgroundColor == 'rgba(255, 255, 255, 0.24)'">白色</radio>
						<radio class="radio-item" value="rgba(80, 160, 255, 0.28)" :checked="backgroundColor == 'rgba(80, 160, 255, 0.28)'">蓝色</radio>
						<radio class="radio-item" value="rgba(255, 110, 110, 0.28)" :checked="backgroundColor == 'rgba(255, 110, 110, 0.28)'">红色</radio>
						<radio class="radio-item" value="rgba(110, 210, 180, 0.28)" :checked="backgroundColor == 'rgba(110, 210, 180, 0.28)'">绿色</radio>
					</radio-group>
				</view>

				<view class="control-row control-row-column">
					<text class="control-title">边框宽度</text>
					<slider class="control-slider"
						:min="0"
						:max="10"
						:step="1"
						:value="borderWidthValue"
						:show-value="true"
						@changing="updateBorderWidth"
						@change="updateBorderWidth"
					/>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	const blurValue = ref(8)
	const borderWidthValue = ref(2)
	const backgroundColor = ref('rgba(255, 255, 255, 0.24)')
	const colorLabel = ref('白色')

	const getDynamicBlurStyle = () : string => {
		return `backdrop-filter: blur(${blurValue.value}px);`
	}

	const getDynamicRichStyle = () : string => {
		return `backdrop-filter: blur(${blurValue.value}px); background-color: ${backgroundColor.value}; border-width: ${borderWidthValue.value}px;`
	}

	const updateBlurValue = (event : UniSliderChangeEvent) => {
		blurValue.value = event.detail.value
	}

	const updateBorderWidth = (event : UniSliderChangeEvent) => {
		borderWidthValue.value = event.detail.value
	}

	const updateBackgroundColor = (event : UniRadioGroupChangeEvent) => {
		backgroundColor.value = event.detail.value
		if (event.detail.value == 'rgba(80, 160, 255, 0.28)') {
			colorLabel.value = '蓝色'
		} else if (event.detail.value == 'rgba(255, 110, 110, 0.28)') {
			colorLabel.value = '红色'
		} else if (event.detail.value == 'rgba(110, 210, 180, 0.28)') {
			colorLabel.value = '绿色'
		} else {
			colorLabel.value = '白色'
		}
	}
</script>

