	width: 100px;
	height: 100px;
	border-radius: 12px;
}

.demo-stage {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 100px;
	height: 100px;
	position: relative;
}

.glass-box-center {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	margin-top: 20px;
	margin-left: 20px;
}

.glass-box {
	width: 60px;
	height: 60px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: rgba(255, 255, 255, 0.22);
	border-width: 1px;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.4);
	border-radius: 14px;
}

.demo-label {
	width: 100%;
	color: #000000;
	font-size: 13px;
	line-height: 18px;
	font-weight: 500;
	text-align: center;
	margin-top: 10px;
}

.control-section {
	display: flex;
	flex-direction: column;
	padding-top: 8px;
}

.control-row {
	display: flex;
	width: 100%;
}

.control-row-column {
	flex-direction: column;
	align-items: flex-start;
	justify-content: flex-start;
	margin-bottom: 18px;
}

.control-title {
	color: #000000;
	font-weight: 600;
	font-size: 14px;
	margin-bottom: 10px;
}

.control-slider {
	width: 100%;
}

.radio-group {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
