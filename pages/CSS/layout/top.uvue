<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
  <view style="flex-grow: 1;">
    <view style="margin-bottom: 15px;">
      <text class="example-title">top: 20px (距离顶部 20px) - 右侧：拍平</text>
      <view class="example-container">
        <view class="example-box">
          <view class="common" style="top: 20px;"></view>
        </view>
        <view class="example-box">
          <view class="common" style="top: 20px;" flatten></view>
        </view>
      </view>
    </view>
    <view style="margin-bottom: 15px;">
      <text class="example-title">top: 20rpx (距离顶部 20rpx) - 右侧：拍平</text>
      <view class="example-container">
        <view class="example-box">
          <view class="common" style="top: 20rpx;"></view>
        </view>
        <view class="example-box">
          <view class="common" style="top: 20rpx;" flatten></view>
        </view>
      </view>
    </view>

    <view style="margin-bottom: 15px;">
      <text class="example-title">top: 20% (距离顶部 20%) - 右侧：拍平</text>
      <view class="example-container">
        <view class="example-box">
          <view class="common" style="top: 20%;"></view>
        </view>
        <view class="example-box">
          <view class="common" style="top: 20%;" flatten></view>
        </view>
      </view>
    </view>

    <view style="margin-bottom: 15px;">
      <text class="example-title">top: auto (自动，默认顶部对齐) - 右侧：拍平</text>
      <view class="example-container">
        <view class="example-box">
          <view class="common" style="top: auto;"></view>
        </view>
        <view class="example-box">
          <view class="common" style="top: auto;" flatten></view>
        </view>
      </view>
    </view>

    <view class="uni-common-mt">
      <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 top 测试</text>
    </view>

    <!-- 普通版本 -->
    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件</text>
        <text class="test-info">设置值: {{top}}</text>
        <text class="test-info">获取值: {{topActual}}</text>
        <view class="test-box">
          <view ref="viewRef" class="common" :style="{ top: top }">
            <text class="common-text">view测试</text>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件</text>
        <text class="test-info">设置值: {{top}}</text>
        <text class="test-info">获取值: {{topActualText}}</text>
        <view class="test-box">
          <text ref="textRef" class="common" :style="{ top: top }">text测试</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件</text>
        <text class="test-info">设置值: {{top}}</text>
        <text class="test-info">获取值: {{topActualImage}}</text>
        <view class="test-box">
          <image ref="imageRef" class="common" :style="{ top: top }" src="/static/test-image/logo.png"></image>
        </view>
      </view>
    </view>

    <!-- 拍平版本 -->
    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件拍平</text>
        <text class="test-info">设置值: {{top}}</text>
        <text class="test-info">获取值: {{topActualFlat}}</text>
        <view class="test-box">
          <view ref="viewRefFlat" class="common" :style="{ top: top }" flatten>
            <text class="common-text">view测试</text>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件拍平</text>
        <text class="test-info">设置值: {{top}}</text>
        <text class="test-info">获取值: {{topActualTextFlat}}</text>
        <view class="test-box">
          <text ref="textRefFlat" class="common" :style="{ top: top }" flatten>text测试</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件拍平</text>
        <text class="test-info">设置值: {{top}}</text>
        <text class="test-info">获取值: {{topActualImageFlat}}</text>
        <view class="test-box">
          <image ref="imageRefFlat" class="common" :style="{ top: top }" flatten src="/static/test-image/logo.png"></image>
        </view>
      </view>
    </view>

    <view class="uni-common-mt uni-common-mb">
      <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
      <enum-data :items="topEnum" title="top 枚举值" @change="radioChangeTop" :compact="true"></enum-data>
      <input-data :defaultValue="top" title="top 自定义值" type="text" @confirm="inputChangeTop"></input-data>
    </view>
  </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const topEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '10px' },
    { value: 4, name: '20rpx' },
    { value: 5, name: '0%' },
    { value: 6, name: '50%' },
    { value: 7, name: 'auto' }
  ]

  const top = ref('10px')
  const topActual = ref('')
  const topActualText = ref('')
  const topActualImage = ref('')
  const topActualFlat = ref('')
  const topActualTextFlat = ref('')
  const topActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeTop = (value: string) => {
    top.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('top', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('top', value)
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('top', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('top', value)
    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('top', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('top', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素 - 普通版本
      const actualValue = viewRef.value?.style.getPropertyValue('top')
      topActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('top')
      topActualFlat.value = actualValueFlat ?? ''
      // text 元素 - 普通版本
      const actualValueText = textRef.value?.style.getPropertyValue('top')
      topActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('top')
      topActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素 - 普通版本
      const actualValueImage = imageRef.value?.style.getPropertyValue('top')
      topActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('top')
      topActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangeTop = (index: number) => {
    const selectedItem = topEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeTop(selectedItem.name)
    }
  }

  const inputChangeTop = (value: string) => {
    changeTop(value)
  }

  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('top')
    topActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('top')
    topActualFlat.value = actualValueFlat ?? ''
    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('top')
    topActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('top')
    topActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('top')
    topActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('top')
    topActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .example-title {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .example-container {
    flex-direction: row;
    justify-content: space-between;
  }

  .example-box {
    position: relative;
    flex: 1;
    height: 150px;
    background-color: #f5f5f5;
    border: 1px solid #ddd;
    margin: 0 5px;
  }

  .common {
    position: absolute;
    width: 60px;
    height: 60px;
    background-color: #ff4444;
  }

  .common-text{
    width:50px;
    color: #fff;
    font-size: 12px;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    position: relative;
    width: 100%;
    height: 100px;
    background-color: #e0e0e0;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
