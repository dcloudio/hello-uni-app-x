<template>
  <view style="flex-grow: 1;">
    <view @click="changeVisibility">
      <text>visibility: {{visibility}}（点击切换）</text>
      <view class="common" :style="{'visibility': visibility}"></view>
    </view>
    <view @click="changeVisibility">
      <text>text组件: visibility: {{visibility}}（点击切换）</text>
      <text class="text-visibility" :style="{'visibility': visibility}">测试文本</text>
    </view>
    <view @click="changeVisibility">
      <text>image组件: visibility: {{visibility}}（点击切换）</text>
      <image class="image-visibility" :style="{'visibility': visibility}" src="/static/logo.png"></image>
    </view>
  </view>
</template>

<script setup lang="uts">

  const visibility = ref('visible')
  const flag = ref(true)

  const changeVisibility = () => {
    flag.value = !flag.value
    if (flag.value) {
      visibility.value = 'visible'
    } else {
      visibility.value = 'hidden'
    }
  }
</script>

<style>
  .common {
    width: 250px;
    height: 250px;
    background-color: red;
  }

  .text-visibility {
    width: 250px;
    height: 250px;
    background-color: red;
    font-size: 16px;
    color: white;
  }

  .image-visibility {
    width: 250px;
    height: 250px;
    background-color: red;
  }
</style>
