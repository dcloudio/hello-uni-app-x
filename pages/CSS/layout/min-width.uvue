<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>min-width: 250px</text>
        <view class="common" style="min-width: 250px;">
          <text>width: 50px</text>
        </view>
        <text>拍平测试</text>
        <view class="common" style="min-width: 250px;" flatten>
          <text>width: 50px</text>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 min-width 测试</text>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{minWidth}}</text>
          <text class="test-info">获取值: {{minWidthActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common" :style="{ minWidth: minWidth }">
              <text>view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{minWidth}}</text>
          <text class="test-info">获取值: {{minWidthActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common" :style="{ minWidth: minWidth }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{minWidth}}</text>
          <text class="test-info">获取值: {{minWidthActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common" :style="{ minWidth: minWidth }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="minWidthEnum" title="min-width 枚举值" @change="radioChangeMinWidth" :compact="true"></enum-data>
        <input-data :defaultValue="minWidth" title="min-width 自定义值" type="text" @confirm="inputChangeMinWidth"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const minWidthEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '50px' },
    { value: 4, name: '150px' },
    { value: 5, name: '0%' },
    { value: 6, name: '50%' }
  ]

  const minWidth = ref('100px')
  const minWidthActual = ref('')
  const minWidthActualText = ref('')
  const minWidthActualImage = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)

  const changeMinWidth = (value: string) => {
    minWidth.value = value
    // view 元素
    viewRef.value?.style.setProperty('min-width', value)
    const actualValue = viewRef.value?.style.getPropertyValue('min-width')
    minWidthActual.value = actualValue ?? ''
    // text 元素
    textRef.value?.style.setProperty('min-width', value)
    const actualValueText = textRef.value?.style.getPropertyValue('min-width')
    minWidthActualText.value = actualValueText ?? ''
    // image 元素
    imageRef.value?.style.setProperty('min-width', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('min-width')
    minWidthActualImage.value = actualValueImage ?? ''
  }

  const radioChangeMinWidth = (index: number) => {
    const selectedItem = minWidthEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeMinWidth(selectedItem.name)
    }
  }

  const inputChangeMinWidth = (value: string) => {
    changeMinWidth(value)
  }

  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('min-width')
    minWidthActual.value = actualValue ?? ''
    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('min-width')
    minWidthActualText.value = actualValueText ?? ''
    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('min-width')
    minWidthActualImage.value = actualValueImage ?? ''
  })
</script>

<style>
  .common {
    width: 50px;
    height: 150px;
    background-color: red;
    justify-content: center;
    align-items: center;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 150px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
