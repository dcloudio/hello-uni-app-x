<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>max-height: 100px</text>
        <view class="common" style="max-height: 100px;">
          <text>height: 400px</text>
        </view>
        <text>拍平测试</text>
        <view class="common" style="max-height: 100px;" flatten>
          <text>height: 400px</text>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 max-height 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{maxHeight}}</text>
          <text class="test-info">获取值: {{maxHeightActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ maxHeight: maxHeight }">
              <text style="font-size: 12px;">view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{maxHeight}}</text>
          <text class="test-info">获取值: {{maxHeightActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ maxHeight: maxHeight }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{maxHeight}}</text>
          <text class="test-info">获取值: {{maxHeightActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-dynamic" :style="{ maxHeight: maxHeight }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{maxHeight}}</text>
          <text class="test-info">获取值: {{maxHeightActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ maxHeight: maxHeight }" flatten>
              <text style="font-size: 12px;">view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{maxHeight}}</text>
          <text class="test-info">获取值: {{maxHeightActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ maxHeight: maxHeight }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{maxHeight}}</text>
          <text class="test-info">获取值: {{maxHeightActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-dynamic" :style="{ maxHeight: maxHeight }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="maxHeightEnum" title="max-height 枚举值" @change="radioChangeMaxHeight" :compact="true"></enum-data>
        <input-data :defaultValue="maxHeight" title="max-height 自定义值" type="text" @confirm="inputChangeMaxHeight"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const maxHeightEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '100px' },
    { value: 4, name: '150px' },
    { value: 5, name: '80rpx' },
    { value: 6, name: 'none' }
  ]

  const maxHeight = ref('50px')
  const maxHeightActual = ref('')
  const maxHeightActualText = ref('')
  const maxHeightActualImage = ref('')
  const maxHeightActualFlat = ref('')
  const maxHeightActualTextFlat = ref('')
  const maxHeightActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeMaxHeight = (value: string) => {
    maxHeight.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('max-height', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('max-height', value)
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('max-height', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('max-height', value)
    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('max-height', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('max-height', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素 - 普通版本
      const actualValue = viewRef.value?.style.getPropertyValue('max-height')
      maxHeightActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('max-height')
      maxHeightActualFlat.value = actualValueFlat ?? ''
      // text 元素 - 普通版本
      const actualValueText = textRef.value?.style.getPropertyValue('max-height')
      maxHeightActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('max-height')
      maxHeightActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素 - 普通版本
      const actualValueImage = imageRef.value?.style.getPropertyValue('max-height')
      maxHeightActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('max-height')
      maxHeightActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangeMaxHeight = (index: number) => {
    const selectedItem = maxHeightEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeMaxHeight(selectedItem.name)
    }
  }

  const inputChangeMaxHeight = (value: string) => {
    changeMaxHeight(value)
  }

  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('max-height')
    maxHeightActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('max-height')
    maxHeightActualFlat.value = actualValueFlat ?? ''
    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('max-height')
    maxHeightActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('max-height')
    maxHeightActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('max-height')
    maxHeightActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('max-height')
    maxHeightActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 250px;
    height: 400px;
    background-color: red;
    justify-content: center;
    align-items: center;
  }

  .common-dynamic {
    width: 100px;
    height: 150px;
    background-color: red;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 150px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
