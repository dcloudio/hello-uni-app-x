<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>max-height: 100px</text>
        <view class="common" style="max-height: 100px;">
          <text>height: 400px</text>
        </view>
        <view class="common uni-common-mt" style="max-height: 100px;" flatten>
          <text>height: 400px</text>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">style.setProperty 动态设置 max-height 测试</text>
        <text>max-height: {{maxHeight}}</text>
        <view ref="viewRef" class="common" style="max-height: 200px;" @click="changeMaxHeight('300px')">
          <text>点击修改 max-height</text>
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup>
  const maxHeight = ref('200px')
  const viewRef = ref(null as UniElement | null)

  const changeMaxHeight = (value: string) => {
    maxHeight.value = value
    viewRef.value?.style.setProperty('max-height', value)
  }
</script>

<style>
  .common {
    width: 250px;
    height: 400px;
    background-color: red;
    justify-content: center;
    align-items: center;
  }
</style>
