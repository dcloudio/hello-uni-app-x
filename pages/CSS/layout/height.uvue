<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>height: 100px</text>
        <view class="common" style="height: 100px;"></view>
        <text>拍平测试</text>
        <view class="common" style="height: 100px;" flatten></view>
      </view>

      <view style="height: 100px;">
        <text>height: 50%</text>
        <view class="common" style="height: 50%;"></view>
      </view>

      <view style="height: 100px;">
        <text>height: 50%（拍平测试）</text>
        <view class="common" style="height: 50%;" flatten></view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 height 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{height}}</text>
          <text class="test-info">获取值: {{heightActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ height: height }">
              <text>view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{height}}</text>
          <text class="test-info">获取值: {{heightActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ height: height }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{height}}</text>
          <text class="test-info">获取值: {{heightActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-dynamic" :style="{ height: height }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{height}}</text>
          <text class="test-info">获取值: {{heightActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ height: height }" flatten>
              <text>view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{height}}</text>
          <text class="test-info">获取值: {{heightActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ height: height }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{height}}</text>
          <text class="test-info">获取值: {{heightActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-dynamic" :style="{ height: height }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="heightEnum" title="height 枚举值" @change="radioChangeHeight" :compact="true"></enum-data>
        <input-data :defaultValue="height" title="height 自定义值" type="text" @confirm="inputChangeHeight"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const heightEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '50px' },
    { value: 4, name: '150px' },
    { value: 5, name: '0%' },
    { value: 6, name: '50%' },
    { value: 7, name: 'auto' }
  ]

  const height = ref('100px')
  const heightActual = ref('')
  const heightActualText = ref('')
  const heightActualImage = ref('')
  const heightActualFlat = ref('')
  const heightActualTextFlat = ref('')
  const heightActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeHeight = (value: string) => {
    height.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('height', value)
    const actualValue = viewRef.value?.style.getPropertyValue('height')
    heightActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('height', value)
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('height')
    heightActualFlat.value = actualValueFlat ?? ''
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('height', value)
    const actualValueText = textRef.value?.style.getPropertyValue('height')
    heightActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('height', value)
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('height')
    heightActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('height', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('height')
    heightActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('height', value)
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('height')
    heightActualImageFlat.value = actualValueImageFlat ?? ''
  }

  const radioChangeHeight = (index: number) => {
    const selectedItem = heightEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeHeight(selectedItem.name)
    }
  }

  const inputChangeHeight = (value: string) => {
    changeHeight(value)
  }

  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('height')
    heightActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('height')
    heightActualFlat.value = actualValueFlat ?? ''
    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('height')
    heightActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('height')
    heightActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('height')
    heightActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('height')
    heightActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 250px;
    background-color: red;
  }

  .common-dynamic {
    width: 100px;
    background-color: red;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 150px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
