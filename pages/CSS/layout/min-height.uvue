<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>min-height: 150px</text>
        <view class="common" style="min-height: 150px;">
          <text>height: 50px</text>
        </view>
        <text>拍平测试</text>
        <view class="common" style="min-height: 150px;" flatten>
          <text>height: 50px</text>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 min-height 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{minHeight}}</text>
          <text class="test-info">获取值: {{minHeightActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ minHeight: minHeight }">
              <text>view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{minHeight}}</text>
          <text class="test-info">获取值: {{minHeightActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ minHeight: minHeight }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{minHeight}}</text>
          <text class="test-info">获取值: {{minHeightActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-dynamic" :style="{ minHeight: minHeight }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{minHeight}}</text>
          <text class="test-info">获取值: {{minHeightActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ minHeight: minHeight }" flatten>
              <text>view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{minHeight}}</text>
          <text class="test-info">获取值: {{minHeightActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ minHeight: minHeight }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{minHeight}}</text>
          <text class="test-info">获取值: {{minHeightActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-dynamic" :style="{ minHeight: minHeight }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="minHeightEnum" title="min-height 枚举值" @change="radioChangeMinHeight" :compact="true"></enum-data>
        <input-data :defaultValue="minHeight" title="min-height 自定义值" type="text" @confirm="inputChangeMinHeight"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const minHeightEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '50px' },
    { value: 4, name: '150px' },
    { value: 5, name: '80rpx' },
  ]

  const minHeight = ref('100px')
  const minHeightActual = ref('')
  const minHeightActualText = ref('')
  const minHeightActualImage = ref('')
  const minHeightActualFlat = ref('')
  const minHeightActualTextFlat = ref('')
  const minHeightActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeMinHeight = (value: string) => {
    minHeight.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('min-height', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('min-height', value)
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('min-height', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('min-height', value)
    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('min-height', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('min-height', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素 - 普通版本
      const actualValue = viewRef.value?.style.getPropertyValue('min-height')
      minHeightActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('min-height')
      minHeightActualFlat.value = actualValueFlat ?? ''
      // text 元素 - 普通版本
      const actualValueText = textRef.value?.style.getPropertyValue('min-height')
      minHeightActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('min-height')
      minHeightActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素 - 普通版本
      const actualValueImage = imageRef.value?.style.getPropertyValue('min-height')
      minHeightActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('min-height')
      minHeightActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangeMinHeight = (index: number) => {
    const selectedItem = minHeightEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeMinHeight(selectedItem.name)
    }
  }

  const inputChangeMinHeight = (value: string) => {
    changeMinHeight(value)
  }

  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('min-height')
    minHeightActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('min-height')
    minHeightActualFlat.value = actualValueFlat ?? ''
    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('min-height')
    minHeightActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('min-height')
    minHeightActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('min-height')
    minHeightActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('min-height')
    minHeightActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 250px;
    height: 50px;
    background-color: red;
    justify-content: center;
    align-items: center;
  }

  .common-dynamic {
    width: 100px;
    height: 50px;
    background-color: red;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 150px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
