<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
  <view style="flex-grow: 1;">
    <view>
      <text>width: 250px</text>
      <view class="common" style="width: 250px;"></view>
      <text>拍平测试</text>
      <view class="common" style="width: 250px;" flatten></view>
    </view>

    <view style="width: 250px;">
      <text>width: 50%</text>
      <view class="common" style="width: 50%;"></view>
      <text>拍平测试</text>
      <view class="common" style="width: 50%;" flatten></view>
    </view>

    <view>
      <text>width: 250rpx</text>
      <view class="common" style="width: 250rpx;"></view>
      <text>拍平测试</text>
      <view class="common" style="width: 250rpx;" flatten></view>
    </view>

    <view class="container">
      <text>嵌套子元素测试 v-deep width: 150rpx</text>
      <child-width-uvue></child-width-uvue>
    </view>

    <view class="uni-common-mt">
      <text class="uni-title-text">style.setProperty 动态设置 width 测试</text>
      <view ref="viewRef" class="common" :style="{ width: width }">
        <text>当前 width: {{width}}</text>
      </view>
      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="widthEnum" title="width 枚举值" @change="radioChangeWidth" :compact="true"></enum-data>
        <input-data :defaultValue="width" title="width 自定义值" type="text" @confirm="inputChangeWidth"></input-data>
      </view>
    </view>
  </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import childWidthUvue from "./child-width.uvue"
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const widthEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '100px' },
    { value: 4, name: '200px' },
    { value: 5, name: '0%' },
    { value: 6, name: '50%' },
    { value: 7, name: 'auto' }
  ]

  const width = ref('250px')
  const viewRef = ref(null as UniElement | null)

  const changeWidth = (value: string) => {
    width.value = value
    viewRef.value?.style.setProperty('width', value)
  }

  const radioChangeWidth = (index: number) => {
    const selectedItem = widthEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeWidth(selectedItem.name)
    }
  }

  const inputChangeWidth = (value: string) => {
    changeWidth(value)
  }
</script>

<style>
  .common {
    height: 100px;
    background-color: red;
  }
  /* #ifndef VUE3-VAPOR */
  .container ::v-deep .box {
    width: 150px;
    height: 100px;
  }
  /* #endif */
</style>
