<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
  <view style="flex-grow: 1;">
    <view>
      <text>width: 250px</text>
      <view class="common" style="width: 250px;"></view>
      <text>拍平测试</text>
      <view class="common" style="width: 250px;" flatten></view>
    </view>

    <view style="width: 250px;">
      <text>width: 50%</text>
      <view class="common" style="width: 50%;"></view>
      <text>拍平测试</text>
      <view class="common" style="width: 50%;" flatten></view>
    </view>

    <view>
      <text>width: 250rpx</text>
      <view class="common" style="width: 250rpx;"></view>
      <text>拍平测试</text>
      <view class="common" style="width: 250rpx;" flatten></view>
    </view>

    <view class="container">
      <text>嵌套子元素测试 v-deep width: 150rpx</text>
      <child-width-uvue></child-width-uvue>
    </view>

    <view class="uni-common-mt">
      <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 width 测试</text>
    </view>

    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件</text>
        <text class="test-info">设置值: {{width}}</text>
        <text class="test-info">获取值: {{widthActual}}</text>
        <view class="test-box">
          <view ref="viewRef" class="common" :style="{ width: width }">
            <text>view测试</text>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件</text>
        <text class="test-info">设置值: {{width}}</text>
        <text class="test-info">获取值: {{widthActualText}}</text>
        <view class="test-box">
          <text ref="textRef" class="common" :style="{ width: width }">text测试</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件</text>
        <text class="test-info">设置值: {{width}}</text>
        <text class="test-info">获取值: {{widthActualImage}}</text>
        <view class="test-box">
          <image ref="imageRef" class="common" :style="{ width: width }" src="/static/logo.png"></image>
        </view>
      </view>
    </view>

    <view class="uni-common-mt uni-common-mb">
      <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
      <enum-data :items="widthEnum" title="width 枚举值" @change="radioChangeWidth" :compact="true"></enum-data>
      <input-data :defaultValue="width" title="width 自定义值" type="text" @confirm="inputChangeWidth"></input-data>
    </view>
  </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import childWidthUvue from "./child-width.uvue"
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const widthEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '150px' },
    { value: 4, name: '0%' },
    { value: 5, name: '50%' },
    { value: 6, name: 'auto' }
  ]

  const width = ref('100px')
  const widthActual = ref('')
  const widthActualText = ref('')
  const widthActualImage = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)

  const changeWidth = (value: string) => {
    width.value = value
    // view 元素
    viewRef.value?.style.setProperty('width', value)
    const actualValue = viewRef.value?.style.getPropertyValue('width')
    widthActual.value = actualValue ?? ''
    // text 元素
    textRef.value?.style.setProperty('width', value)
    const actualValueText = textRef.value?.style.getPropertyValue('width')
    widthActualText.value = actualValueText ?? ''
    // image 元素
    imageRef.value?.style.setProperty('width', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('width')
    widthActualImage.value = actualValueImage ?? ''
  }

  const radioChangeWidth = (index: number) => {
    const selectedItem = widthEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeWidth(selectedItem.name)
    }
  }

  const inputChangeWidth = (value: string) => {
    changeWidth(value)
  }

  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('width')
    widthActual.value = actualValue ?? ''
    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('width')
    widthActualText.value = actualValueText ?? ''
    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('width')
    widthActualImage.value = actualValueImage ?? ''
  })
</script>

<style>
  .common {
    height: 100px;
    background-color: red;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 100px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }

  /* #ifndef VUE3-VAPOR */
  .container ::v-deep .box {
    width: 150px;
    height: 100px;
  }
  /* #endif */
</style>
