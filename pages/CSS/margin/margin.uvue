<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>margin: 25px</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin: 25px;"></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin: 25px;" flatten></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
      </view>

      <view>
        <text>margin: 10%</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin: 10%;"></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin: 10%;" flatten></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 margin 测试</text>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActual}}</text>
          <view class="test-box">
            <view class="common-view" style="background-color: red;"></view>
            <view ref="viewRef" class="common-view test-view" :style="{ margin: margin }">
              <text class="common-text">view测试</text>
            </view>
            <view class="common-view" style="background-color: blue;"></view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualText}}</text>
          <view class="test-box">
            <text class="common-view common-text" style="background-color: red;">红色</text>
            <text ref="textRef" class="common-view common-text test-text" :style="{ margin: margin }">text测试</text>
            <text class="common-view common-text" style="background-color: blue;">蓝色</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualImage}}</text>
          <view class="test-box">
            <image class="common-image" style="background-color: red;" src="/static/test-image/logo.png"></image>
            <image ref="imageRef" class="common-image test-image" :style="{ margin: margin }" src="/static/test-image/logo.png"></image>
            <image class="common-image" style="background-color: blue;" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualFlat}}</text>
          <view class="test-box">
            <view class="common-view" style="background-color: red;"></view>
            <view ref="viewRefFlat" class="common-view test-view-flatten" :style="{ margin: margin }" flatten>
              <text class="common-text">view测试</text>
            </view>
            <view class="common-view" style="background-color: blue;"></view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualTextFlat}}</text>
          <view class="test-box">
            <text class="common-view common-text" style="background-color: red;">红色</text>
            <text ref="textRefFlat" class="common-view common-text test-text-flatten" :style="{ margin: margin }" flatten>text测试</text>
            <text class="common-view common-text" style="background-color: blue;">蓝色</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualImageFlat}}</text>
          <view class="test-box">
            <image class="common-image" style="background-color: red;" src="/static/test-image/logo.png"></image>
            <image ref="imageRefFlat" class="common-image test-image-flatten" :style="{ margin: margin }" flatten src="/static/test-image/logo.png"></image>
            <image class="common-image" style="background-color: blue;" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">scroll-view 组件 margin 测试</text>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">scroll-view 组件</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualScrollView}}</text>
          <view class="test-box" style="height: 180px;">
            <view class="common-view" style="background-color: red;"></view>
            <scroll-view ref="scrollViewRef" class="common-scroll-view" :style="{ margin: margin }">
              <view class="scroll-view-content">
                <text class="common-text">scroll-view测试1</text>
              </view>
              <view class="scroll-view-content">
                <text class="common-text">scroll-view测试2</text>
              </view>
              <view class="scroll-view-content">
                <text class="common-text">scroll-view测试3</text>
              </view>
            </scroll-view>
            <view class="common-view" style="background-color: blue;"></view>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :compact="true" :items="marginEnum" title="margin 枚举值" @change="radioChangeMargin"></enum-data>
        <input-data :defaultValue="margin" title="margin 自定义值" type="text" @confirm="inputChangeMargin"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const margin = ref('25px')
  const marginActual = ref('')
  const marginActualText = ref('')
  const marginActualImage = ref('')
  const marginActualFlat = ref('')
  const marginActualTextFlat = ref('')
  const marginActualImageFlat = ref('')
  const marginActualScrollView = ref('')

  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)
  const scrollViewRef = ref(null as UniElement | null)

  const marginEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '10%' },
    { value: 6, name: 'auto' }
  ]

  const changeMargin = (value: string) => {
    margin.value = value
    // view 元素
    viewRef.value?.style.setProperty('margin', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('margin', value)
    // text 元素
    textRef.value?.style.setProperty('margin', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('margin', value)
    // image 元素
    imageRef.value?.style.setProperty('margin', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('margin', value)
    // scroll-view 元素
    scrollViewRef.value?.style.setProperty('margin', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素
      const actualValue = viewRef.value?.style.getPropertyValue('margin')
      marginActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('margin')
      marginActualFlat.value = actualValueFlat ?? ''
      // text 元素
      const actualValueText = textRef.value?.style.getPropertyValue('margin')
      marginActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('margin')
      marginActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素
      const actualValueImage = imageRef.value?.style.getPropertyValue('margin')
      marginActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('margin')
      marginActualImageFlat.value = actualValueImageFlat ?? ''
      // scroll-view 元素
      const actualValueScrollView = scrollViewRef.value?.style.getPropertyValue('margin')
      marginActualScrollView.value = actualValueScrollView ?? ''
    })
  }

  const radioChangeMargin = (index: number) => {
    const selectedItem = marginEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeMargin(selectedItem.name)
    }
  }

  const inputChangeMargin = (value: string) => {
    changeMargin(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('margin')
    marginActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('margin')
    marginActualFlat.value = actualValueFlat ?? ''
    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('margin')
    marginActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('margin')
    marginActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('margin')
    marginActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('margin')
    marginActualImageFlat.value = actualValueImageFlat ?? ''
    // scroll-view 元素
    const actualValueScrollView = scrollViewRef.value?.style.getPropertyValue('margin')
    marginActualScrollView.value = actualValueScrollView ?? ''
  })

  defineExpose({
    radioChangeMargin
  })
</script>

<style>
  .common {
    height: 50px;
    background-color: green;
  }

  .common-view {
    height: 30px;
    background-color: green;
  }

  .common-text {
    font-size: 12px;
    color: white;
  }

  .common-image {
    width: 30px;
    height: 30px;
    background-color: green;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 140px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }

  .common-scroll-view {
    height: 30px;
    background-color: green;
  }

  .scroll-view-content {
    width: 100%;
    height: 30px;
    align-items: center;
    justify-content: center;
    border: cyan solid 2px;
  }
</style>
