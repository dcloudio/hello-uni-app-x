<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>margin-bottom: 25px</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin-bottom: 25px;"></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin-bottom: 25px;" flatten></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
      </view>

      <view>
        <text>margin-bottom: 10%</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin-bottom: 10%;"></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 250px;background-color: gray;">
          <view class="common" style="background-color: red;"></view>
          <view class="common" style="margin-bottom: 10%;" flatten></view>
          <view class="common" style="background-color: blue;"></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 margin-bottom 测试</text>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{marginBottom}}</text>
          <text class="test-info">获取值: {{marginBottomActual}}</text>
          <view class="test-box">
            <view class="common-view" style="background-color: red;"></view>
            <view ref="viewRef" class="common-view test-view" :style="{ marginBottom: marginBottom }">
              <text class="common-text">view测试</text>
            </view>
            <view class="common-view" style="background-color: blue;"></view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{marginBottom}}</text>
          <text class="test-info">获取值: {{marginBottomActualText}}</text>
          <view class="test-box">
            <text class="common-view common-text" style="background-color: red;">红色</text>
            <text ref="textRef" class="common-view common-text test-text" :style="{ marginBottom: marginBottom }">text测试</text>
            <text class="common-view common-text" style="background-color: blue;">蓝色</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{marginBottom}}</text>
          <text class="test-info">获取值: {{marginBottomActualImage}}</text>
          <view class="test-box">
            <image class="common-image" style="background-color: red;" src="/static/test-image/logo.png"></image>
            <image ref="imageRef" class="common-image test-image" :style="{ marginBottom: marginBottom }" src="/static/test-image/logo.png"></image>
            <image class="common-image" style="background-color: blue;" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{marginBottom}}</text>
          <text class="test-info">获取值: {{marginBottomActualFlat}}</text>
          <view class="test-box">
            <view class="common-view" style="background-color: red;"></view>
            <view ref="viewRefFlat" class="common-view test-view-flatten" :style="{ marginBottom: marginBottom }" flatten>
              <text class="common-text">view测试</text>
            </view>
            <view class="common-view" style="background-color: blue;"></view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{marginBottom}}</text>
          <text class="test-info">获取值: {{marginBottomActualTextFlat}}</text>
          <view class="test-box">
            <text class="common-view common-text" style="background-color: red;">红色</text>
            <text ref="textRefFlat" class="common-view common-text test-text-flatten" :style="{ marginBottom: marginBottom }" flatten>text测试</text>
            <text class="common-view common-text" style="background-color: blue;">蓝色</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{marginBottom}}</text>
          <text class="test-info">获取值: {{marginBottomActualImageFlat}}</text>
          <view class="test-box">
            <image class="common-image" style="background-color: red;" src="/static/test-image/logo.png"></image>
            <image ref="imageRefFlat" class="common-image test-image-flatten" :style="{ marginBottom: marginBottom }" flatten src="/static/test-image/logo.png"></image>
            <image class="common-image" style="background-color: blue;" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>
      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="marginBottomEnum" title="margin-bottom 枚举值" @change="radioChangeMarginBottom" :compact="true"></enum-data>
        <input-data :defaultValue="marginBottom" title="margin-bottom 自定义值" type="text" @confirm="inputChangeMarginBottom"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const marginBottom = ref('25px')
  const marginBottomActual = ref('')
  const marginBottomActualText = ref('')
  const marginBottomActualImage = ref('')
  const marginBottomActualFlat = ref('')
  const marginBottomActualTextFlat = ref('')
  const marginBottomActualImageFlat = ref('')

  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const marginBottomEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '10%' },
    { value: 6, name: 'auto' }
  ]

  const changeMarginBottom = (value: string) => {
    marginBottom.value = value
    // view 元素
    viewRef.value?.style.setProperty('margin-bottom', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('margin-bottom', value)
    // text 元素
    textRef.value?.style.setProperty('margin-bottom', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('margin-bottom', value)
    // image 元素
    imageRef.value?.style.setProperty('margin-bottom', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('margin-bottom', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素
      const actualValue = viewRef.value?.style.getPropertyValue('margin-bottom')
      marginBottomActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('margin-bottom')
      marginBottomActualFlat.value = actualValueFlat ?? ''
      // text 元素
      const actualValueText = textRef.value?.style.getPropertyValue('margin-bottom')
      marginBottomActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('margin-bottom')
      marginBottomActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素
      const actualValueImage = imageRef.value?.style.getPropertyValue('margin-bottom')
      marginBottomActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('margin-bottom')
      marginBottomActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangeMarginBottom = (index: number) => {
    const selectedItem = marginBottomEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeMarginBottom(selectedItem.name)
    }
  }

  const inputChangeMarginBottom = (value: string) => {
    changeMarginBottom(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('margin-bottom')
    marginBottomActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('margin-bottom')
    marginBottomActualFlat.value = actualValueFlat ?? ''
    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('margin-bottom')
    marginBottomActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('margin-bottom')
    marginBottomActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('margin-bottom')
    marginBottomActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('margin-bottom')
    marginBottomActualImageFlat.value = actualValueImageFlat ?? ''
  })

  defineExpose({
    radioChangeMarginBottom
  })
</script>

<style>
  .common {
    height: 50px;
    background-color: green;
  }

  .common-view {
    height: 30px;
    background-color: green;
  }

  .common-text {
    font-size: 12px;
    color: white;
  }

  .common-image {
    width: 30px;
    height: 30px;
    background-color: green;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 140px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
