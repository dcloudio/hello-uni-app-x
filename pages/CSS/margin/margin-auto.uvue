<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex:1;">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>margin-left: auto (元素会靠右)</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin-left: auto;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin-left: auto;" flatten></view>
        </view>
      </view>

      <view>
        <text>margin-right: auto (元素会靠左)</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin-right: auto;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin-right: auto;" flatten></view>
        </view>
      </view>

      <view>
        <text>margin-left: auto; margin-right: auto (水平居中)</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin-left: auto; margin-right: auto;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin-left: auto; margin-right: auto;" flatten></view>
        </view>
      </view>

      <view>
        <text>margin: 0 auto (常用的水平居中写法)</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin: 0 auto;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin: 0 auto;" flatten></view>
        </view>
      </view>

      <view>
        <text>margin: auto (所有方向auto)</text>
        <view style="width: 250px;height: 150px;background-color: gray;">
          <view class="common" style="width: 150px; height: 80px; margin: auto;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 150px;background-color: gray;">
          <view class="common" style="width: 150px; height: 80px; margin: auto;" flatten></view>
        </view>
      </view>

      <view>
        <text>margin: 10px auto (垂直固定，水平auto)</text>
        <view style="width: 250px;height: 120px;background-color: gray;">
          <view class="common" style="width: 150px; margin: 10px auto;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 120px;background-color: gray;">
          <view class="common" style="width: 150px; margin: 10px auto;" flatten></view>
        </view>
      </view>

      <view>
        <text>margin: auto 20px (垂直auto，水平固定)</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin: auto 20px;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px; margin: auto 20px;" flatten></view>
        </view>
      </view>

      <view>
        <text>对比: 无margin (默认左对齐)</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px;"></view>
        </view>
        <text>拍平测试</text>
        <view style="width: 250px;height: 100px;background-color: gray;">
          <view class="common" style="width: 150px;" flatten></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 margin 测试</text>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common" style="width: 100px;" :style="{ margin: margin }">
              <text class="common-text">view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-text" style="width: 100px;" :style="{ margin: margin }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-image" :style="{ margin: margin }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common" style="width: 100px;" :style="{ margin: margin }" flatten>
              <text class="common-text">view测试</text>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-text" style="width: 100px;" :style="{ margin: margin }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{margin}}</text>
          <text class="test-info">获取值: {{marginActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-image" :style="{ margin: margin }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>
      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="marginAutoEnum" title="margin 枚举值" @change="radioChangeMargin" :compact="true"></enum-data>
        <input-data :defaultValue="margin" title="margin 自定义值" type="text" @confirm="inputChangeMargin"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const margin = ref('0 auto')
  const marginActual = ref('')
  const marginActualText = ref('')
  const marginActualImage = ref('')
  const marginActualFlat = ref('')
  const marginActualTextFlat = ref('')
  const marginActualImageFlat = ref('')

  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const marginAutoEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'auto' },
    { value: 2, name: '0' },
    { value: 3, name: '20px' },
    { value: 4, name: '10%' }
  ]

  const changeMargin = (value: string) => {
    margin.value = value
    // view 元素
    viewRef.value?.style.setProperty('margin', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('margin', value)
    // text 元素
    textRef.value?.style.setProperty('margin', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('margin', value)
    // image 元素
    imageRef.value?.style.setProperty('margin', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('margin', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素
      const actualValue = viewRef.value?.style.getPropertyValue('margin')
      marginActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('margin')
      marginActualFlat.value = actualValueFlat ?? ''
      // text 元素
      const actualValueText = textRef.value?.style.getPropertyValue('margin')
      marginActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('margin')
      marginActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素
      const actualValueImage = imageRef.value?.style.getPropertyValue('margin')
      marginActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('margin')
      marginActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangeMargin = (index: number) => {
    const selectedItem = marginAutoEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeMargin(selectedItem.name)
    }
  }

  const inputChangeMargin = (value: string) => {
    changeMargin(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('margin')
    marginActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('margin')
    marginActualFlat.value = actualValueFlat ?? ''
    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('margin')
    marginActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('margin')
    marginActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('margin')
    marginActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('margin')
    marginActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    height: 50px;
    background-color: green;
  }

  .common-text {
    height: 50px;
    background-color: green;
    font-size: 14px;
    color: white;
  }

  .common-image {
    width: 50px;
    height: 50px;
    background-color: green;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 100px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
