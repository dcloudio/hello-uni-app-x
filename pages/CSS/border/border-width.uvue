<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <text style="margin-top: 3px;">border-width: 5px (无 border-style。右边拍平)</text>
    <view style="flex-direction: row;">
      <view class="common" style="border-width: 5px;"></view>
      <view class="common" style="border-width: 5px;" flatten></view>
    </view>

    <text style="margin-top: 3px;">border-width: 5px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common" style="border-width: 5px; border-style: solid;"></view>
      <view class="common" style="border-width: 5px; border-style: solid;" flatten></view>
    </view>

    <text style="margin-top: 3px;">border-left-width: 5px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common" style="border-left-width: 5px; border-left-style: solid; "></view>
      <view class="common" style="border-left-width: 5px; border-left-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">border-top-width: 10px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common" style="border-top-width: 10px; border-top-style: solid; "></view>
      <view class="common" style="border-top-width: 10px; border-top-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">border-right-width: 15px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common" style="border-right-width: 15px; border-right-style: solid; "></view>
      <view class="common" style="border-right-width: 15px; border-right-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">border-bottom-width: 20px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common" style="border-bottom-width: 20px; border-bottom-style: solid; "></view>
      <view class="common" style="border-bottom-width: 20px; border-bottom-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">左下细边框红色。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common"
        style="border-left-width: 0.5px; border-bottom-width: 0.5px; border-left-style: solid; border-bottom-style: solid; border-color:red;">
      </view>
      <view class="common"
        style="border-left-width: 0.5px; border-bottom-width: 0.5px; border-left-style: solid; border-bottom-style: solid; border-color:red;"
        flatten></view>
    </view>

    <!-- 圆角测试 -->
    <text style="margin-top: 3px;">border-width: 5px (无 border-style。右边拍平)</text>
    <view style="flex-direction: row;">
      <view class="common-circle" style="border-width: 5px;"></view>
      <view class="common-circle" style="border-width: 5px;" flatten></view>
    </view>

    <text style="margin-top: 3px;">border-width: 5px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common-circle" style="border-width: 5px; border-style: solid;"></view>
      <view class="common-circle" style="border-width: 5px; border-style: solid;" flatten></view>
    </view>

    <text style="margin-top: 3px;">border-left-width: 5px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common-circle" style="border-left-width: 5px; border-left-style: solid; "></view>
      <view class="common-circle" style="border-left-width: 5px; border-left-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">border-top-width: 10px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common-circle" style="border-top-width: 10px; border-top-style: solid; "></view>
      <view class="common-circle" style="border-top-width: 10px; border-top-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">border-right-width: 15px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common-circle" style="border-right-width: 15px; border-right-style: solid; "></view>
      <view class="common-circle" style="border-right-width: 15px; border-right-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">border-bottom-width: 20px。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common-circle" style="border-bottom-width: 20px; border-bottom-style: solid; "></view>
      <view class="common-circle" style="border-bottom-width: 20px; border-bottom-style: solid; " flatten></view>
    </view>

    <text style="margin-top: 3px;">左下细边框红色。右边拍平</text>
    <view style="flex-direction: row;">
      <view class="common-circle"
        style="border-left-width: 0.5px; border-bottom-width: 0.5px; border-left-style: solid; border-bottom-style: solid; border-color:red;">
      </view>
      <view class="common-circle"
        style="border-left-width: 0.5px; border-bottom-width: 0.5px; border-left-style: solid; border-bottom-style: solid; border-color:red;"
        flatten></view>
    </view>

    <text style="margin-top: 3px;">裁剪展现半圆。右边拍平</text>
    <view style="flex-direction: row;">
      <view style="width: 100px;height: 50px; /* 高度是宽度的一半 */
    overflow: hidden; /* 隐藏下半部分 */
    position: relative;">
        <view style="width: 100px;height: 100px; /* 完整的圆高度 */
    border: 10px solid blue; /* 环的厚度和颜色 */
    border-radius: 50px; /* 变成正圆 */
    box-sizing: border-box; /* 确保边框计算在宽度内 */"></view>
      </view>
      <view flatten style="width: 100px;height: 50px; /* 高度是宽度的一半 */
      overflow: hidden; /* 隐藏下半部分 */
      position: relative;">
        <view flatten style="width: 100px;height: 100px; /* 完整的圆高度 */
      border: 10px solid blue; /* 环的厚度和颜色 */
      border-radius: 50px; /* 变成正圆 */
      box-sizing: border-box; /* 确保边框计算在宽度内 */"></view>
      </view>
    </view>

    <text style="margin-top: 3px;">底边透明，3边上色的 3/4 圆弧。右边拍平</text>
    <view style="flex-direction: row;">
      <view style="width: 40px; height: 40px;
  /* 1. 基础边框：厚度、样式、透明色 */
  border: 5px solid transparent;
  /* 2. 给其中三条边上色，形成 3/4 圆弧 */
  border-top-color: blue;
  border-right-color: blue;
  border-left-color: blue;
  /* 3. 变成正圆 */
  border-radius: 20px;
  transform: rotate(45deg) translateZ(0); /* 开启硬件加速 */"></view>
      <view flatten style="width: 40px; height: 40px;
    /* 1. 基础边框：厚度、样式、透明色 */
    border: 5px solid transparent;
    /* 2. 给其中三条边上色，形成 3/4 圆弧 */
    border-top-color: blue;
    border-right-color: blue;
    border-left-color: blue;
    /* 3. 变成正圆 */
    border-radius: 20px;
    transform: rotate(45deg) translateZ(0); /* 开启硬件加速 */"></view>
    </view>

    <text style="margin-top: 3px;">底边上色，1/4边透明的 3/4 圆弧 加scale缩小。右边拍平</text>
    <view style="flex-direction: row;">
      <view style="width: 32px;height: 32px;
  border-radius: 16px;
  border: 2px solid blue;
  border-bottom-color: transparent;
  transform: scale(0.5) rotate(45deg);
  "></view>
      <view flatten style="width: 32px;height: 32px;
    border-radius: 16px;
    border: 2px solid blue;
    border-bottom-color: transparent;
    transform: scale(0.5) rotate(45deg);
    "></view>
    </view>

    <!-- 动态设置 -->
    <view class="uni-common-mt">
      <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 border-width 测试</text>
    </view>

    <!-- 普通版本 -->
    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件</text>
        <text class="test-info">设置值: {{borderWidth}}</text>
        <text class="test-info">获取值: {{borderWidthActual}}</text>
        <view class="test-box">
          <view ref="viewRef" class="common-dynamic" :style="{ borderWidth: borderWidth, borderStyle: 'solid' }">
            <view style="flex-grow: 1;background-color: red;"><text>view测试</text></view>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件</text>
        <text class="test-info">设置值: {{borderWidth}}</text>
        <text class="test-info">获取值: {{borderWidthActualText}}</text>
        <view class="test-box">
          <text ref="textRef" class="common-dynamic"
            :style="{ borderWidth: borderWidth, borderStyle: 'solid' }">text测试</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件</text>
        <text class="test-info">设置值: {{borderWidth}}</text>
        <text class="test-info">获取值: {{borderWidthActualImage}}</text>
        <view class="test-box">
          <image ref="imageRef" class="common-image" :style="{ borderWidth: borderWidth, borderStyle: 'solid' }"
            src="/static/test-image/logo.png"></image>
        </view>
      </view>
    </view>

    <!-- 拍平版本 -->
    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件拍平</text>
        <text class="test-info">设置值: {{borderWidth}}</text>
        <text class="test-info">获取值: {{borderWidthActualFlat}}</text>
        <view class="test-box">
          <view ref="viewRefFlat" class="common-dynamic" :style="{ borderWidth: borderWidth, borderStyle: 'solid' }"
            flatten>
            <view style="flex-grow: 1;background-color: red;"><text>view测试</text></view>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件拍平</text>
        <text class="test-info">设置值: {{borderWidth}}</text>
        <text class="test-info">获取值: {{borderWidthActualTextFlat}}</text>
        <view class="test-box">
          <text ref="textRefFlat" class="common-dynamic" :style="{ borderWidth: borderWidth, borderStyle: 'solid' }"
            flatten>text测试</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件拍平</text>
        <text class="test-info">设置值: {{borderWidth}}</text>
        <text class="test-info">获取值: {{borderWidthActualImageFlat}}</text>
        <view class="test-box">
          <image ref="imageRefFlat" class="common-image" :style="{ borderWidth: borderWidth, borderStyle: 'solid' }"
            flatten src="/static/test-image/logo.png"></image>
        </view>
      </view>
    </view>

    <view class="uni-common-mt uni-common-mb">
      <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
      <enum-data :items="borderWidthEnum" title="border-width 枚举值" @change="radioChangeBorderWidth"
        :compact="true"></enum-data>
      <input-data :defaultValue="borderWidth" title="border-width 自定义值" type="text"
        @confirm="inputChangeBorderWidth"></input-data>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const borderWidthEnum : ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '1px' },
    { value: 3, name: '3px' },
    { value: 4, name: 'thin' },
    { value: 5, name: 'medium' },
    { value: 6, name: 'thick' }
  ]

  const borderWidth = ref('5px')
  const borderWidthActual = ref('')
  const borderWidthActualText = ref('')
  const borderWidthActualImage = ref('')
  const borderWidthActualFlat = ref('')
  const borderWidthActualTextFlat = ref('')
  const borderWidthActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeBorderWidth = (value : string) => {
    borderWidth.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('border-width', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('border-width', value)
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('border-width', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('border-width', value)
    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('border-width', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('border-width', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素 - 普通版本
      const actualValue = viewRef.value?.style.getPropertyValue('border-width')
      borderWidthActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-width')
      borderWidthActualFlat.value = actualValueFlat ?? ''
      // text 元素 - 普通版本
      const actualValueText = textRef.value?.style.getPropertyValue('border-width')
      borderWidthActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-width')
      borderWidthActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素 - 普通版本
      const actualValueImage = imageRef.value?.style.getPropertyValue('border-width')
      borderWidthActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-width')
      borderWidthActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangeBorderWidth = (index : number) => {
    const selectedItem = borderWidthEnum.find((item) : boolean => item.value === index)
    if (selectedItem != null) {
      changeBorderWidth(selectedItem.name)
    }
  }

  const inputChangeBorderWidth = (value : string) => {
    changeBorderWidth(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('border-width')
    borderWidthActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-width')
    borderWidthActualFlat.value = actualValueFlat ?? ''

    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('border-width')
    borderWidthActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-width')
    borderWidthActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-width')
    borderWidthActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-width')
    borderWidthActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 150px;
    height: 50px;
    background-color: gray;
    margin: 5px;
  }

  .common-circle {
    width: 50px;
    height: 50px;
    background-color: gray;
    border-radius: 25px;
    margin: 5px;
  }

  .common-dynamic {
    height: 50px;
    background-color: gray;
  }

  .common-image {
    width: 50px;
    height: 50px;
    background-color: gray;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 60px;
    background-color: lightgray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
