<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>border-top: 5px dashed blue</text>
        <view class="common" style="border-top: 5px dashed blue;"></view>
        <text>拍平测试</text>
        <view class="common" style="border-top: 5px dashed blue;" flatten></view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 border-top 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{borderTop}}</text>
          <text class="test-info">获取值: {{borderTopActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ borderTop: borderTop }">
              <view style="flex-grow: 1;background-color: green;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{borderTop}}</text>
          <text class="test-info">获取值: {{borderTopActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ borderTop: borderTop }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{borderTop}}</text>
          <text class="test-info">获取值: {{borderTopActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-image" :style="{ borderTop: borderTop }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{borderTop}}</text>
          <text class="test-info">获取值: {{borderTopActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ borderTop: borderTop }" flatten>
              <view style="flex-grow: 1;background-color: green;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{borderTop}}</text>
          <text class="test-info">获取值: {{borderTopActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ borderTop: borderTop }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{borderTop}}</text>
          <text class="test-info">获取值: {{borderTopActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-image" :style="{ borderTop: borderTop }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="borderTopEnum" title="border-top 枚举值" @change="radioChangeBorderTop" :compact="true"></enum-data>
        <input-data :defaultValue="borderTop" title="border-top 自定义值" type="text" @confirm="inputChangeBorderTop"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup>
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const borderTopEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'none' },
    { value: 2, name: '1px solid red' },
    { value: 3, name: '2px dashed blue' },
    { value: 4, name: '3px dotted green' }
  ]

  const borderTop = ref('5px solid red')
  const borderTopActual = ref('')
  const borderTopActualText = ref('')
  const borderTopActualImage = ref('')
  const borderTopActualFlat = ref('')
  const borderTopActualTextFlat = ref('')
  const borderTopActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeBorderTop = (value: string) => {
    borderTop.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('border-top', value)
    const actualValue = viewRef.value?.style.getPropertyValue('border-top')
    borderTopActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('border-top', value)
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-top')
    borderTopActualFlat.value = actualValueFlat ?? ''

    // text 元素 - 普通版本
    textRef.value?.style.setProperty('border-top', value)
    const actualValueText = textRef.value?.style.getPropertyValue('border-top')
    borderTopActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('border-top', value)
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-top')
    borderTopActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('border-top', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-top')
    borderTopActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('border-top', value)
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-top')
    borderTopActualImageFlat.value = actualValueImageFlat ?? ''
  }

  const radioChangeBorderTop = (index: number) => {
    const selectedItem = borderTopEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeBorderTop(selectedItem.name)
    }
  }

  const inputChangeBorderTop = (value: string) => {
    changeBorderTop(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('border-top')
    borderTopActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-top')
    borderTopActualFlat.value = actualValueFlat ?? ''

    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('border-top')
    borderTopActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-top')
    borderTopActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-top')
    borderTopActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-top')
    borderTopActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 150px;
    height: 100px;
    background-color: gray;
  }

  .common-dynamic {
    height: 50px;
    background-color: gray;
  }

  .common-image {
    width: 50px;
    height: 50px;
    background-color: gray;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 60px;
    background-color: lightgray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
