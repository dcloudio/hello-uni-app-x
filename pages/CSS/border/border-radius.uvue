<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1">
      <view>
        <text>border-radius: 10px</text>
        <view class="common" style="border-radius: 10px"></view>
        <text>拍平测试</text>
        <view class="common" style="border-radius: 10px" flatten></view>
      </view>

      <view>
        <text>border-top-left-radius: 10px</text>
        <view class="common" style="border-top-left-radius: 10px"></view>
        <text>拍平测试</text>
        <view class="common" style="border-top-left-radius: 10px" flatten></view>
      </view>

      <view>
        <text>border-top-right-radius: 10px</text>
        <view class="common" style="border-top-right-radius: 10px"></view>
        <text>拍平测试</text>
        <view class="common" style="border-top-right-radius: 10px" flatten></view>
      </view>

      <view>
        <text>border-bottom-left-radius: 10px</text>
        <view class="common" style="border-bottom-left-radius: 10px"></view>
        <text>拍平测试</text>
        <view class="common" style="border-bottom-left-radius: 10px" flatten></view>
      </view>

      <view>
        <text>border-bottom-right-radius: 10px</text>
        <view class="common" style="border-bottom-right-radius: 10px"></view>
        <text>拍平测试</text>
        <view class="common" style="border-bottom-right-radius: 10px" flatten></view>
      </view>

      <view>
        <text>border-radius: 150px（长宽不同形成扁圆）</text>
        <view class="common" style="border-radius: 150px"></view>
        <text>拍平测试</text>
        <view class="common" style="border-radius: 150px" flatten></view>
      </view>

      <view>
        <text>border-radius: 150px（与长宽相同形成正圆）</text>
        <view class="common-square" style="border-radius: 150px"></view>
        <text>拍平测试</text>
        <view class="common-square" style="border-radius: 150px" flatten></view>
      </view>

      <view>
        <text>border-radius: 10px（包含子视图）</text>
        <view class="common" style="margin-left: 5px;border-radius: 10px">
           <view style="background-color: wheat;width: 100%;height: 20px;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="margin-left: 5px;border-radius: 10px" flatten>
           <view style="background-color: wheat;width: 100%;height: 20px;"></view>
        </view>
      </view>
      <view>
        <text>border-bottom-left-radius: 10px \nborder-bottom-right-radius: 10px \n(包含子视图）</text>
        <view class="common" style="margin-left: 5px;border-top-left-radius: 10px;border-top-right-radius: 10px">
           <view style="background-color: wheat;width: 100%;height: 20px;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="margin-left: 5px;border-top-left-radius: 10px;border-top-right-radius: 10px" flatten>
           <view style="background-color: wheat;width: 100%;height: 20px;"></view>
        </view>
      </view>
      <view>
        <text>text组件: border-radius: 10px</text>
        <text class="text-radius" style="border-radius: 10px;">测试文本</text>
        <text>拍平测试</text>
        <text class="text-radius" style="border-radius: 10px;" flatten>测试文本</text>
      </view>
      <view>
        <text>text组件: border-radius: 25px（与高度相同形成圆角）</text>
        <text class="text-radius-circle" style="border-radius: 25px;">测试文本</text>
        <text>拍平测试</text>
        <text class="text-radius-circle" style="border-radius: 25px;" flatten>测试文本</text>
      </view>
      <view>
        <text>image组件: border-radius: 10px</text>
        <image class="image-radius" style="border-radius: 10px;" src="/static/logo.png"></image>
        <text>拍平测试</text>
        <image class="image-radius" style="border-radius: 10px;" src="/static/logo.png" flatten></image>
      </view>
      <view>
        <text>image组件: border-radius: 100px（与长宽相同形成正圆）</text>
        <image class="image-radius-circle" style="border-radius: 100px;" src="/static/logo.png"></image>
        <text>拍平测试</text>
        <image class="image-radius-circle" style="border-radius: 100px;" src="/static/logo.png" flatten></image>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 border-radius 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{borderRadius}}</text>
          <text class="test-info">获取值: {{borderRadiusActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ borderRadius: borderRadius }">
              <view style="flex-grow: 1;background-color: red;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{borderRadius}}</text>
          <text class="test-info">获取值: {{borderRadiusActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ borderRadius: borderRadius }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{borderRadius}}</text>
          <text class="test-info">获取值: {{borderRadiusActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-image" :style="{ borderRadius: borderRadius }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{borderRadius}}</text>
          <text class="test-info">获取值: {{borderRadiusActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ borderRadius: borderRadius }" flatten>
              <view style="flex-grow: 1;background-color: red;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{borderRadius}}</text>
          <text class="test-info">获取值: {{borderRadiusActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ borderRadius: borderRadius }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{borderRadius}}</text>
          <text class="test-info">获取值: {{borderRadiusActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-image" :style="{ borderRadius: borderRadius }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="borderRadiusEnum" title="border-radius 枚举值" @change="radioChangeBorderRadius" :compact="true"></enum-data>
        <input-data :defaultValue="borderRadius" title="border-radius 自定义值" type="text" @confirm="inputChangeBorderRadius"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup>
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const borderRadiusEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '5px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '50%' }
  ]

  const borderRadius = ref('10px')
  const borderRadiusActual = ref('')
  const borderRadiusActualText = ref('')
  const borderRadiusActualImage = ref('')
  const borderRadiusActualFlat = ref('')
  const borderRadiusActualTextFlat = ref('')
  const borderRadiusActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeBorderRadius = (value: string) => {
    borderRadius.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('border-radius', value)
    const actualValue = viewRef.value?.style.getPropertyValue('border-radius')
    borderRadiusActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('border-radius', value)
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-radius')
    borderRadiusActualFlat.value = actualValueFlat ?? ''

    // text 元素 - 普通版本
    textRef.value?.style.setProperty('border-radius', value)
    const actualValueText = textRef.value?.style.getPropertyValue('border-radius')
    borderRadiusActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('border-radius', value)
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-radius')
    borderRadiusActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('border-radius', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-radius')
    borderRadiusActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('border-radius', value)
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-radius')
    borderRadiusActualImageFlat.value = actualValueImageFlat ?? ''
  }

  const radioChangeBorderRadius = (index: number) => {
    const selectedItem = borderRadiusEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeBorderRadius(selectedItem.name)
    }
  }

  const inputChangeBorderRadius = (value: string) => {
    changeBorderRadius(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('border-radius')
    borderRadiusActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-radius')
    borderRadiusActualFlat.value = actualValueFlat ?? ''

    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('border-radius')
    borderRadiusActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-radius')
    borderRadiusActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-radius')
    borderRadiusActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-radius')
    borderRadiusActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 150px;
    height: 100px;
    background-color: gray;
  }

  .common-square {
    width: 150px;
    height: 150px;
    background-color: gray;
  }

  .text-radius {
    width: 150px;
    height: 50px;
    background-color: gray;
    font-size: 16px;
    color: black;
  }

  .text-radius-circle {
    width: 150px;
    height: 25px;
    background-color: gray;
    font-size: 16px;
    color: black;
  }

  .image-radius {
    width: 150px;
    height: 100px;
    background-color: gray;
  }

  .image-radius-circle {
    width: 100px;
    height: 100px;
    background-color: gray;
  }

  .common-dynamic {
    height: 50px;
    background-color: gray;
  }

  .common-image {
    width: 50px;
    height: 50px;
    background-color: gray;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 60px;
    background-color: lightgray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
