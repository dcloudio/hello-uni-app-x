<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>border-right: 5px solid blue</text>
        <view class="common" style="border-right: 5px solid blue;"></view>
        <text>拍平测试</text>
        <view class="common" style="border-right: 5px solid blue;" flatten></view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 border-right 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{borderRight}}</text>
          <text class="test-info">获取值: {{borderRightActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ borderRight: borderRight }">
              <view style="flex-grow: 1;background-color: blue;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{borderRight}}</text>
          <text class="test-info">获取值: {{borderRightActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ borderRight: borderRight }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{borderRight}}</text>
          <text class="test-info">获取值: {{borderRightActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-image" :style="{ borderRight: borderRight }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{borderRight}}</text>
          <text class="test-info">获取值: {{borderRightActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ borderRight: borderRight }" flatten>
              <view style="flex-grow: 1;background-color: blue;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{borderRight}}</text>
          <text class="test-info">获取值: {{borderRightActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ borderRight: borderRight }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{borderRight}}</text>
          <text class="test-info">获取值: {{borderRightActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-image" :style="{ borderRight: borderRight }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="borderRightEnum" title="border-right 枚举值" @change="radioChangeBorderRight" :compact="true"></enum-data>
        <input-data :defaultValue="borderRight" title="border-right 自定义值" type="text" @confirm="inputChangeBorderRight"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup>
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const borderRightEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'none' },
    { value: 2, name: '1px solid black' },
    { value: 3, name: '2px dashed blue' },
    { value: 4, name: '3px dotted green' }
  ]

  const borderRight = ref('5px solid pink')
  const borderRightActual = ref('')
  const borderRightActualText = ref('')
  const borderRightActualImage = ref('')
  const borderRightActualFlat = ref('')
  const borderRightActualTextFlat = ref('')
  const borderRightActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeBorderRight = (value: string) => {
    borderRight.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('border-right', value)
    const actualValue = viewRef.value?.style.getPropertyValue('border-right')
    borderRightActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('border-right', value)
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-right')
    borderRightActualFlat.value = actualValueFlat ?? ''

    // text 元素 - 普通版本
    textRef.value?.style.setProperty('border-right', value)
    const actualValueText = textRef.value?.style.getPropertyValue('border-right')
    borderRightActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('border-right', value)
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-right')
    borderRightActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('border-right', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-right')
    borderRightActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('border-right', value)
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-right')
    borderRightActualImageFlat.value = actualValueImageFlat ?? ''
  }

  const radioChangeBorderRight = (index: number) => {
    const selectedItem = borderRightEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeBorderRight(selectedItem.name)
    }
  }

  const inputChangeBorderRight = (value: string) => {
    changeBorderRight(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('border-right')
    borderRightActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('border-right')
    borderRightActualFlat.value = actualValueFlat ?? ''

    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('border-right')
    borderRightActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('border-right')
    borderRightActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-right')
    borderRightActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('border-right')
    borderRightActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 150px;
    height: 100px;
    background-color: gray;
  }

  .common-dynamic {
    height: 80px;
    background-color: gray;
  }

  .common-image {
    width: 80px;
    height: 80px;
    background-color: gray;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 100px;
    background-color: lightgray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
