<template>
  <view style="flex-grow: 1;">
    <view>
      <text>border-left: 5px solid blue</text>
      <view class="common" style="border-left: 5px solid blue;"></view>
      <view class="common" style="border-left: 5px solid blue;" flatten></view>
    </view>

    <view class="uni-common-mt">
      <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 border-left 测试</text>
    </view>

    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件</text>
        <text class="test-info">设置值: {{borderLeft}}</text>
        <text class="test-info">获取值: {{borderLeftActual}}</text>
        <view class="test-box">
          <view ref="viewRef" class="common-dynamic" :style="{ borderLeft: borderLeft }">
            <view style="flex-grow: 1;background-color: red;"><text>view测试</text></view>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件</text>
        <text class="test-info">设置值: {{borderLeft}}</text>
        <text class="test-info">获取值: {{borderLeftActualText}}</text>
        <view class="test-box">
          <text ref="textRef" class="common-dynamic" :style="{ borderLeft: borderLeft }">text测试</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件</text>
        <text class="test-info">设置值: {{borderLeft}}</text>
        <text class="test-info">获取值: {{borderLeftActualImage}}</text>
        <view class="test-box">
          <image ref="imageRef" class="common-image" :style="{ borderLeft: borderLeft }" src="/static/logo.png"></image>
        </view>
      </view>
    </view>

    <view class="uni-common-mt uni-common-mb">
      <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
      <enum-data :items="borderLeftEnum" title="border-left 枚举值" @change="radioChangeBorderLeft" :compact="true"></enum-data>
      <input-data :defaultValue="borderLeft" title="border-left 自定义值" type="text" @confirm="inputChangeBorderLeft"></input-data>
    </view>
  </view>
</template>

<script setup>
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const borderLeftEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'none' },
    { value: 2, name: '1px solid black' },
    { value: 3, name: '2px dashed blue' },
    { value: 4, name: '3px dotted green' }
  ]

  const borderLeft = ref('5px solid pink')
  const borderLeftActual = ref('')
  const borderLeftActualText = ref('')
  const borderLeftActualImage = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)

  const changeBorderLeft = (value: string) => {
    borderLeft.value = value
    // view 元素
    viewRef.value?.style.setProperty('border-left', value)
    const actualValue = viewRef.value?.style.getPropertyValue('border-left')
    borderLeftActual.value = actualValue ?? ''
    // text 元素
    textRef.value?.style.setProperty('border-left', value)
    const actualValueText = textRef.value?.style.getPropertyValue('border-left')
    borderLeftActualText.value = actualValueText ?? ''
    // image 元素
    imageRef.value?.style.setProperty('border-left', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-left')
    borderLeftActualImage.value = actualValueImage ?? ''
  }

  const radioChangeBorderLeft = (index: number) => {
    const selectedItem = borderLeftEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeBorderLeft(selectedItem.name)
    }
  }

  const inputChangeBorderLeft = (value: string) => {
    changeBorderLeft(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('border-left')
    borderLeftActual.value = actualValue ?? ''
    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('border-left')
    borderLeftActualText.value = actualValueText ?? ''
    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('border-left')
    borderLeftActualImage.value = actualValueImage ?? ''
  })
</script>

<style>
  .common {
    width: 150px;
    height: 100px;
    background-color: gray;
  }
  .common-dynamic {
    height: 80px;
    background-color: gray;
  }

  .common-image {
    width: 80px;
    height: 80px;
    background-color: gray;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 100px;
    background-color: lightgray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
