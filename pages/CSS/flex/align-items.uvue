<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1">
      <view>
        <text>align-items: center</text>
        <view class="common" style="align-items: center">
          <view style="width: 50px; height: 50px; background-color: red"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>

        <view class="common" style="align-items: center" flatten>
          <view style="width: 50px; height: 50px; background-color: red"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
      </view>

      <view>
        <text>align-items: flex-start</text>
        <view class="common" style="align-items: flex-start">
          <view style="width: 50px; height: 50px; background-color: red"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>

        <view class="common" style="align-items: flex-start" flatten>
          <view style="width: 50px; height: 50px; background-color: red"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
      </view>

      <view>
        <text>align-items: flex-end</text>
        <view class="common" style="align-items: flex-end">
          <view style="width: 50px; height: 50px; background-color: red"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>

        <view class="common" style="align-items: flex-end" flatten>
          <view style="width: 50px; height: 50px; background-color: red"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
      </view>

      <view>
        <text>align-items: stretch</text>
        <view class="common" style="align-items: stretch">
          <view style="width: 50px; background-color: red"></view>
          <view style="width: 50px; background-color: green"></view>
          <view style="width: 50px; background-color: blue"></view>
        </view>

        <view class="common" style="align-items: stretch" flatten>
          <view style="width: 50px; background-color: red"></view>
          <view style="width: 50px; background-color: green"></view>
          <view style="width: 50px; background-color: blue"></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 align-items 测试</text>
        <text class="test-info">设置值: {{alignItems}}</text>
        <text class="test-info">获取值: {{alignItemsActual}}</text>
        <view class="test-box">
          <view ref="viewRef" class="test-flex-container" :style="{ alignItems: alignItems }">
            <view class="test-item-small" style="background-color: red;"></view>
            <view class="test-item-small" style="background-color: green;"></view>
            <view class="test-item-small" style="background-color: blue;"></view>
          </view>
        </view>
        <view class="uni-common-mt uni-common-mb">
          <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
          <enum-data :items="alignItemsEnum" title="align-items 枚举值" @change="radioChangeAlignItems" :compact="true"></enum-data>
          <input-data :defaultValue="alignItems" title="align-items 自定义值" type="text" @confirm="inputChangeAlignItems"></input-data>
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const alignItemsEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'flex-start' },
    { value: 2, name: 'flex-end' },
    { value: 3, name: 'center' },
    { value: 4, name: 'stretch' }
  ]

  const alignItems = ref('center')
  const alignItemsActual = ref('')
  const viewRef = ref(null as UniElement | null)

  const changeAlignItems = (value: string) => {
    alignItems.value = value
    viewRef.value?.style.setProperty('align-items', value)
    const actualValue = viewRef.value?.style.getPropertyValue('align-items')
    alignItemsActual.value = actualValue ?? ''
  }

  const radioChangeAlignItems = (index: number) => {
    const selectedItem = alignItemsEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeAlignItems(selectedItem.name)
    }
  }

  const inputChangeAlignItems = (value: string) => {
    changeAlignItems(value)
  }

  onReady(() => {
    const actualValue = viewRef.value?.style.getPropertyValue('align-items')
    alignItemsActual.value = actualValue ?? ''
  })
</script>

<style>
  .common {
    width: 200px;
    height: 200px;
    background-color: gray;
    flex-direction: row;
  }

  .test-box {
    width: 250px;
    height: 150px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }

  .test-flex-container {
    width: 100%;
    height: 100%;
    background-color: gray;
    flex-direction: row;
  }

  .test-item-small {
    width: 50px;
    height: 50px;
  }
</style>
