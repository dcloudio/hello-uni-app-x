<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1">
      <view>
        <text>flex: 0</text>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="min-width: 25px; flex: 0"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="min-width: 25px; flex: 0" flatten></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
      </view>

      <view>
        <text>flex: 1</text>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="flex: 1"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="flex: 1" flatten></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
      </view>

      <view>
        <text>flex: auto</text>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="flex: auto"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="flex: auto" flatten></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
      </view>

      <view>
        <text>flex: none</text>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="flex: none"></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="flex: none" flatten></view>
          <view style="width: 50px; height: 50px; background-color: green"></view>
          <view style="width: 50px; height: 50px; background-color: blue"></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">style.setProperty 动态设置 flex 测试</text>
        <button @click="changeFlex(2)">点击修改红色块 flex 从 1 改为 2</button>
        <text>红色块 flex: {{flexProp}}, 绿色块 flex: 1</text>
        <text style="font-size: 12px; color: #666;">容器剩余空间按 flex 比例分配</text>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view ref="viewRef" class="box" style="background-color: red; flex: 1; ">
            <text style="color: white; font-weight: bold;">{{flexProp}}</text>
          </view>
          <view class="box" style="background-color: green; flex: 1;">
            <text style="color: white;">1</text>
          </view>
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  const flexProp = ref(1)
  const viewRef = ref(null as UniElement | null)

  const changeFlex = (value: number) => {
    flexProp.value = value
    viewRef.value?.style.setProperty('flex', value.toString())
  }
</script>

<style>
  .common {
    width: 50px;
    height: 50px;
    background-color: red;
    justify-content: center;
    align-items: center;
  }
  .box{
    height: 50px;
    justify-content: center;
    align-items: center;
  }
</style>
