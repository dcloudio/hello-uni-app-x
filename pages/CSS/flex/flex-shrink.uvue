<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1">
      <view>
        <text>flex-shrink</text>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="background-color: red; flex-shrink: 1">
            <text>1</text>
          </view>
          <view class="common" style="background-color: green; flex-shrink: 2">
            <text>2</text>
          </view>
          <view class="common" style="background-color: blue; flex-shrink: 3">
            <text>3</text>
          </view>
        </view>
        <view style="
            width: 250px;
            height: 150px;
            background-color: gray;
            flex-direction: row;
          ">
          <view class="common" style="background-color: red; flex-shrink: 1" flatten>
            <text>1</text>
          </view>
          <view class="common" style="background-color: green; flex-shrink: 2" flatten>
            <text>2</text>
          </view>
          <view class="common" style="background-color: blue; flex-shrink: 3" flatten>
            <text>3</text>
          </view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 flex-shrink 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <!-- view 组件测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{flexShrink}}</text>
          <text class="test-info">获取值: {{flexShrinkActual}}</text>
          <view class="test-box">
            <view class="test-flex-container">
              <view class="common-image test-red"></view>
              <view ref="viewRef" class="common-image test-green" :style="{ flexShrink: flexShrink }">
                <text class="test-label">{{flexShrink}}</text>
              </view>
              <view class="common-image test-blue"></view>
            </view>
          </view>
        </view>

        <!-- text 组件测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{flexShrink}}</text>
          <text class="test-info">获取值: {{flexShrinkActualText}}</text>
          <view class="test-box">
            <view class="test-flex-container">
              <text class="common-text test-red">红色</text>
              <text ref="textRef" class="common-text test-green" :style="{ flexShrink: flexShrink }">text</text>
              <text class="common-text test-blue">蓝色</text>
            </view>
          </view>
        </view>

        <!-- image 组件测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{flexShrink}}</text>
          <text class="test-info">获取值: {{flexShrinkActualImage}}</text>
          <view class="test-box">
            <view class="test-flex-container">
              <image class="common-image test-red" src="/static/logo.png"></image>
              <image ref="imageRef" class="common-image test-green" :style="{ flexShrink: flexShrink }" src="/static/logo.png"></image>
              <image class="common-image test-blue" src="/static/logo.png"></image>
            </view>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <!-- view 组件拍平测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{flexShrink}}</text>
          <text class="test-info">获取值: {{flexShrinkActualFlat}}</text>
          <view class="test-box">
            <view class="test-flex-container">
              <view class="common-image test-red"></view>
              <view ref="viewRefFlat" class="common-image test-green" :style="{ flexShrink: flexShrink }" flatten>
                <text class="test-label">{{flexShrink}}</text>
              </view>
              <view class="common-image test-blue"></view>
            </view>
          </view>
        </view>

        <!-- text 组件拍平测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{flexShrink}}</text>
          <text class="test-info">获取值: {{flexShrinkActualTextFlat}}</text>
          <view class="test-box">
            <view class="test-flex-container">
              <text class="common-text test-red">红色</text>
              <text ref="textRefFlat" class="common-text test-green" :style="{ flexShrink: flexShrink }" flatten>text</text>
              <text class="common-text test-blue">蓝色</text>
            </view>
          </view>
        </view>

        <!-- image 组件拍平测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{flexShrink}}</text>
          <text class="test-info">获取值: {{flexShrinkActualImageFlat}}</text>
          <view class="test-box">
            <view class="test-flex-container">
              <image class="common-image test-red" src="/static/logo.png"></image>
              <image ref="imageRefFlat" class="common-image test-green" :style="{ flexShrink: flexShrink }" flatten src="/static/logo.png"></image>
              <image class="common-image test-blue" src="/static/logo.png"></image>
            </view>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="flexShrinkEnum" title="flex-shrink 枚举值" @change="radioChangeFlexShrink" :compact="true"></enum-data>
        <input-data :defaultValue="flexShrink" title="flex-shrink 自定义值" type="text" @confirm="inputChangeFlexShrink"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const flexShrinkEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '1' },
    { value: 3, name: '2' },
    { value: 4, name: '3' }
  ]

  const flexShrink = ref('1')
  const flexShrinkActual = ref('')
  const flexShrinkActualFlat = ref('')
  const flexShrinkActualText = ref('')
  const flexShrinkActualImage = ref('')
  const flexShrinkActualTextFlat = ref('')
  const flexShrinkActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const changeFlexShrink = (value: string) => {
    flexShrink.value = value
    // view 元素
    viewRef.value?.style.setProperty('flex-shrink', value)
    const actualValue = viewRef.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActual.value = actualValue ?? ''
    // view 元素 拍平
    viewRefFlat.value?.style.setProperty('flex-shrink', value)
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualFlat.value = actualValueFlat ?? ''

    // text 元素
    textRef.value?.style.setProperty('flex-shrink', value)
    const actualValueText = textRef.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualText.value = actualValueText ?? ''
    // text 元素 拍平
    textRefFlat.value?.style.setProperty('flex-shrink', value)
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素
    imageRef.value?.style.setProperty('flex-shrink', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualImage.value = actualValueImage ?? ''
    // image 元素 拍平
    imageRefFlat.value?.style.setProperty('flex-shrink', value)
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualImageFlat.value = actualValueImageFlat ?? ''
  }

  const radioChangeFlexShrink = (index: number) => {
    const selectedItem = flexShrinkEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeFlexShrink(selectedItem.name)
    }
  }

  const inputChangeFlexShrink = (value: string) => {
    changeFlexShrink(value)
  }

  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActual.value = actualValue ?? ''
    // view 元素 拍平
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualFlat.value = actualValueFlat ?? ''

    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualText.value = actualValueText ?? ''
    // text 元素 拍平
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualTextFlat.value = actualValueTextFlat ?? ''

    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualImage.value = actualValueImage ?? ''
    // image 元素 拍平
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('flex-shrink')
    flexShrinkActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 125px;
    height: 50px;
    justify-content: center;
    align-items: center;
  }

  .common-text {
    height: 30px;
    background-color: green;
    font-size: 12px;
    color: white;
  }

  .common-image {
    width: 30px;
    height: 30px;
    background-color: green;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 80px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }

  .test-flex-container {
    width: 100%;
    height: 100%;
    flex-direction: row;
  }

  .test-red {
    background-color: red;
  }

  .test-blue {
    background-color: blue;
  }

  .test-green {
    background-color: green;
  }

  .test-label {
    font-size: 12px;
    color: white;
  }
</style>
