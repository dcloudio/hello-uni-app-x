<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1">
      <view>
        <text>flex-wrap: nowrap</text>
        <view class="common" style="flex-wrap: nowrap">
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="flex-wrap: nowrap" flatten>
          <view class="common-item common-red" flatten></view>
          <view class="common-item common-green" flatten></view>
          <view class="common-item common-blue" flatten></view>
          <view class="common-item common-red" flatten></view>
          <view class="common-item common-green" flatten></view>
          <view class="common-item common-blue" flatten></view>
        </view>
      </view>

      <view>
        <text>flex-wrap: wrap</text>
        <view class="common" style="flex-wrap: wrap">
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="flex-wrap: wrap" flatten>
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
        </view>
      </view>

      <view>
        <text>flex-wrap: wrap-reverse</text>
        <view class="common" style="flex-wrap: wrap-reverse">
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="flex-wrap: wrap-reverse" flatten>
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
          <view class="common-item common-red"></view>
          <view class="common-item common-green"></view>
          <view class="common-item common-blue"></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 flex-wrap 测试</text>
      </view>

      <view class="common-box">
        <!-- 普通版本 -->
        <view class="uni-common-mt">
          <text class="uni-title-text">flex-wrap</text>
          <text class="test-info">设置值: {{flexWrap}}</text>
          <text class="test-info">获取值: {{flexWrapActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="test-flex-container test-view" :style="{ flexWrap: flexWrap }">
              <view class="common-item common-red"></view>
              <view class="common-item common-green"></view>
              <view class="common-item common-blue"></view>
              <view class="common-item common-red"></view>
              <view class="common-item common-green"></view>
              <view class="common-item common-blue"></view>
            </view>
          </view>
        </view>

        <!-- 拍平版本 -->
        <view class="uni-common-mt">
          <text class="uni-title-text">测试拍平</text>
          <text class="test-info">设置值: {{flexWrap}}</text>
          <text class="test-info">获取值: {{flexWrapActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="test-flex-container test-view-flatten" :style="{ flexWrap: flexWrap }" flatten>
              <view class="common-item common-red"></view>
              <view class="common-item common-green"></view>
              <view class="common-item common-blue"></view>
              <view class="common-item common-red"></view>
              <view class="common-item common-green"></view>
              <view class="common-item common-blue"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="flexWrapEnum" title="flex-wrap 枚举值" @change="radioChangeFlexWrap"
          :compact="true"></enum-data>
        <input-data :defaultValue="flexWrap" title="flex-wrap 自定义值" type="text"
          @confirm="inputChangeFlexWrap"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const flexWrapEnum : ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'nowrap' },
    { value: 2, name: 'wrap' },
    { value: 3, name: 'wrap-reverse' }
  ]

  const flexWrap = ref('nowrap')
  const flexWrapActual = ref('')
  const flexWrapActualFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const viewRefFlat = ref(null as UniElement | null)

  const changeFlexWrap = (value : string) => {
    flexWrap.value = value
    // 普通版本
    viewRef.value?.style.setProperty('flex-wrap', value)
    // 拍平版本
    viewRefFlat.value?.style.setProperty('flex-wrap', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // 普通版本
      const actualValue = viewRef.value?.style.getPropertyValue('flex-wrap')
      flexWrapActual.value = actualValue ?? ''
      // 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('flex-wrap')
      flexWrapActualFlat.value = actualValueFlat ?? ''
    })
  }

  const radioChangeFlexWrap = (index : number) => {
    const selectedItem = flexWrapEnum.find((item) : boolean => item.value === index)
    if (selectedItem != null) {
      changeFlexWrap(selectedItem.name)
    }
  }

  const inputChangeFlexWrap = (value : string) => {
    changeFlexWrap(value)
  }

  onReady(() => {
    const actualValue = viewRef.value?.style.getPropertyValue('flex-wrap')
    flexWrapActual.value = actualValue ?? ''

    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('flex-wrap')
    flexWrapActualFlat.value = actualValueFlat ?? ''
  })

  defineExpose({
    radioChangeFlexWrap
  })
</script>

<style>
  .common {
    width: 250px;
    height: 150px;
    background-color: gray;
    flex-direction: row;
  }

  .common-box {
    flex-direction: row;
    justify-content: space-around;
  }

  .test-box {
    width: 180px;
    height: 140px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }

  .test-flex-container {
    width: 100%;
    height: 100%;
    background-color: gray;
    flex-direction: row;
  }

  .common-item {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
  }

  .common-red {
    background-color: red;
  }

  .common-green {
    background-color: green;
  }

  .common-blue {
    background-color: blue;
  }
</style>
