<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view class="common">
        <text class="common-size" style="font-style: italic;">font-style: italic</text>
        <text class="common-size" style="font-style: normal;">font-style: normal</text>
      </view>
      <text class="uni-title-text">拍平测试</text>
      <view class="common">
        <text class="common-size" style="font-style: italic;" flatten>font-style: italic</text>
        <text class="common-size" style="font-style: normal;" flatten>font-style: normal</text>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 font-style 测试</text>
      </view>

      <view class="common-box">
        <!-- 普通版本 -->
        <view class="uni-common-mt">
          <text class="uni-title-text">font-style</text>
          <text class="test-info">设置值: {{fontStyle}}</text>
          <text class="test-info">获取值: {{fontStyleActual}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-size" :style="{ fontStyle: fontStyle }">当前 font-style: {{fontStyle}}</text>
          </view>
        </view>

        <!-- 拍平版本 -->
        <view class="uni-common-mt">
          <text class="uni-title-text">测试拍平</text>
          <text class="test-info">设置值: {{fontStyle}}</text>
          <text class="test-info">获取值: {{fontStyleActualFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-size" :style="{ fontStyle: fontStyle }" flatten>当前 font-style: {{fontStyle}}</text>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
          <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
          <enum-data :items="fontStyleEnum" title="font-style 枚举值" @change="radioChangeFontStyle" :compact="true"></enum-data>
          <input-data :defaultValue="fontStyle" title="font-style 自定义值" type="text" @confirm="inputChangeFontStyle"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const fontStyleEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'normal' },
    { value: 2, name: 'italic' }
  ]

  const fontStyle = ref('normal')
  const fontStyleActual = ref('')
  const fontStyleActualFlat = ref('')
  const textRef = ref(null as UniTextElement | null)
  const textRefFlat = ref(null as UniTextElement | null)

  const changeFontStyle = (value: string) => {
    fontStyle.value = value
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('font-style', value)
    const actualValue = textRef.value?.style.getPropertyValue('font-style')
    fontStyleActual.value = actualValue ?? ''
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('font-style', value)
    const actualValueFlat = textRefFlat.value?.style.getPropertyValue('font-style')
    fontStyleActualFlat.value = actualValueFlat ?? ''
  }

  const radioChangeFontStyle = (index: number) => {
    const selectedItem = fontStyleEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeFontStyle(selectedItem.name)
    }
  }

  const inputChangeFontStyle = (value: string) => {
    changeFontStyle(value)
  }

  onReady(() => {
    // text 元素 - 普通版本
    const actualValue = textRef.value?.style.getPropertyValue('font-style')
    fontStyleActual.value = actualValue ?? ''
    // text 元素 - 拍平版本
    const actualValueFlat = textRefFlat.value?.style.getPropertyValue('font-style')
    fontStyleActualFlat.value = actualValueFlat ?? ''
  })
</script>

<style>
  .common-size {
    font-size: 20px;
  }
  .common{
    height: 100px;
    background-color: gray;
    justify-content: center;
    align-items: center;
  }

  .common-box{
    flex-direction: row;
    justify-content: space-around;
  }

  .test-box {
    width: 180px;
    height: 80px;
    background-color: gray;
    justify-content: center;
    align-items: center;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
