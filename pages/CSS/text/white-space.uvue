<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <scroll-view style="padding: 10px 0px; background-color: gray;justify-content: center;" direction="horizontal">
        <text class="text" :style="textStyle">{{multiLineText}}</text>
        <text class="text" :style="textStyle" flatten>{{multiLineText}}</text>
      </scroll-view>
      <scroll-view style="flex: 1">
        <view class="content">
          <enum-data :items="white_space" title="white-space" @change="radio_change"></enum-data>

          <view class="uni-common-mt">
            <text class="uni-title-text">style.setProperty 动态设置 white-space 测试</text>
            <button  @click="changeWhiteSpace('nowrap')">点击修改 white-space 为 nowrap</button>
            <text>white-space: {{whiteSpace}}</text>
            <scroll-view style="padding: 10px 0px; background-color: gray;justify-content: center;" direction="horizontal">
              <text ref="viewRef" class="text" style="white-space: normal;">{{multiLineText}}</text>
            </scroll-view>
          </view>
        </view>
      </scroll-view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">

  import { ItemType } from '@/components/enum-data/enum-data-types'

  const textStyle = ref("white-space: normal;")
  const white_space = ref([
    { "value": 0, "name": "normal" },
    { "value": 1, "name": "nowrap" },
    { "value": 2, "name": "pre" },
    { "value": 3, "name": "pre-wrap" },
    { "value": 4, "name": "pre-line" },
    { "value": 5, "name": "break-spaces" }] as ItemType[])
  const multiLineText = ref(`HBuilderX，
	轻巧、
		极速，
			极客编辑器；
				uni-app x，
					终极跨平台方案；
				uts，
			大一统语言

HBuilderX，轻巧、极速，极客编辑器；uni-app x，终极跨平台方案；uts，大一统语言`)

  const radio_change = (checked : number) => {
    textStyle.value = `white-space: ${white_space.value[checked].name};`
  }

  const whiteSpace = ref('normal')
  const viewRef = ref(null as UniElement | null)

  const changeWhiteSpace = (value: string) => {
    whiteSpace.value = value
    viewRef.value?.style.setProperty('white-space', value)
  }
</script>

<style>
  .text {
    font-size: 20px;
    /* 需要设置 align-self text组件才会自适应宽度 */
    align-self: flex-start;
  }
</style>
