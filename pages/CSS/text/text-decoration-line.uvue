<template>
  <!-- #ifdef APP -->
  <scroll-view>
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view class="content">
        <text class="common" style="text-decoration-line: underline;">text-decoration-line: underline</text>
        <text class="common" style="text-decoration-line: line-through;">text-decoration-line: line-through</text>
      </view>
      <!-- #ifdef VUE3-VAPOR -->
      <view class="content">
        <text class="common" style="text-decoration-line: underline;" flatten>text-decoration-line: underline</text>
        <text class="common" style="text-decoration-line: line-through;" flatten>text-decoration-line: line-through</text>
      </view>
      <!-- #endif -->
      <view class="content">
        <text class="common" style="text-decoration-line: underline;color: blue;">text-decoration-line: underline</text>
        <text class="common" style="text-decoration-line: line-through;color: blue;">text-decoration-line: line-through</text>
      </view>
      <!-- #ifdef VUE3-VAPOR -->
      <view class="content">
        <text class="common" style="text-decoration-line: underline;color: blue;" flatten>text-decoration-line: underline</text>
        <text class="common" style="text-decoration-line: line-through;color: blue;" flatten>text-decoration-line: line-through</text>
      </view>
      <!-- #endif -->

      <view class="uni-common-mt">
        <text class="uni-title-text">style.setProperty 动态设置 text-decoration-line 测试</text>
        <text>text-decoration-line: {{textDecorationLine}}</text>
        <view class="content">
          <text ref="viewRef" class="common" style="text-decoration-line: none;" @click="changeTextDecorationLine('underline')">点击修改 text-decoration-line 为 underline</text>
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
	const textDecorationLine = ref('none')
	const viewRef = ref(null as UniElement | null)

	const changeTextDecorationLine = (value: string) => {
		textDecorationLine.value = value
		viewRef.value?.style.setProperty('text-decoration-line', value)
	}
</script>

<style>
	.common {
		font-size: 20px;
	}
  .content {
    height: 250px;
    background-color: gray;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
  }
</style>
