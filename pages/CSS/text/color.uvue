<template>
  <view style="flex-grow: 1;">
    <view class="box">
      <text class="common" style="color: rgb(255, 0, 0);">color: rgb(255, 0, 0)</text>
      <text class="common" style="color: rgba(255, 0, 0, 0.5);">color: rgba(255, 0, 0, 0.5)</text>
      <text class="common" style="color: #ff0000;">color: #ff0000</text>
      <text class="common" style="color: #f00;">color: #f00</text>
      <text class="common" style="color: red;">color: red</text>
    </view>
    <text class="uni-title-text">拍平测试</text>
    <view class="box">
      <text class="common" style="color: rgb(255, 0, 0);" flatten>color: rgb(255, 0, 0)</text>
      <text class="common" style="color: rgba(255, 0, 0, 0.5);" flatten>color: rgba(255, 0, 0, 0.5)</text>
      <text class="common" style="color: #ff0000;" flatten>color: #ff0000</text>
      <text class="common" style="color: #f00;" flatten>color: #f00</text>
      <text class="common" style="color: red;" flatten>color: red</text>
    </view>

    <view class="uni-common-mt">
      <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 color 测试</text>
      
      <!-- 普通版本 -->
      <text class="test-info">设置值: {{color}}</text>
      <text class="test-info">获取值: {{colorActual}}</text>
      <view class="box" style="height: 50px;">
        <text ref="textRef" class="common" :style="{ color: color }">当前 color: {{color}}</text>
      </view>
      
      <!-- 拍平版本 -->
      <text class="test-info">设置值: {{color}}</text>
      <text class="test-info">获取值: {{colorActualFlat}}</text>
      <view class="box" style="height: 50px;">
        <text ref="textRefFlat" class="common" :style="{ color: color }" flatten>当前 color: {{color}}</text>
      </view>
      
      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="colorEnum" title="color 枚举值" @change="radioChangeColor" :compact="true"></enum-data>
        <input-data :defaultValue="color" title="color 自定义值" type="text" @confirm="inputChangeColor"></input-data>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const colorEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'red' },
    { value: 2, name: 'blue' },
    { value: 3, name: 'green' },
    { value: 4, name: '#ff0000' },
    { value: 5, name: '#00ff00' },
    { value: 6, name: '#0000ff' },
    { value: 7, name: 'rgb(255, 0, 0)' },
    { value: 8, name: 'rgba(255, 0, 0, 0.5)' }
  ]

  const color = ref('red')
  const colorActual = ref('')
  const colorActualFlat = ref('')
  const textRef = ref(null as UniTextElement | null)
  const textRefFlat = ref(null as UniTextElement | null)

  const changeColor = (value: string) => {
    color.value = value
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('color', value)
    const actualValue = textRef.value?.style.getPropertyValue('color')
    colorActual.value = actualValue ?? ''
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('color', value)
    const actualValueFlat = textRefFlat.value?.style.getPropertyValue('color')
    colorActualFlat.value = actualValueFlat ?? ''
  }

  const radioChangeColor = (index: number) => {
    const selectedItem = colorEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeColor(selectedItem.name)
    }
  }

  const inputChangeColor = (value: string) => {
    changeColor(value)
  }

  onReady(() => {
    // text 元素 - 普通版本
    const actualValue = textRef.value?.style.getPropertyValue('color')
    colorActual.value = actualValue ?? ''
    // text 元素 - 拍平版本
    const actualValueFlat = textRefFlat.value?.style.getPropertyValue('color')
    colorActualFlat.value = actualValueFlat ?? ''
  })
</script>

<style>
  .common {
    font-size: 20px;
  }
  .box{
    height: 180px;
    background-color: gray;
    justify-content: center;
    align-items: center;
  }
</style>
