<template>
	<view style="flex-grow: 1;">
		<view style="height: 250px;background-color: gray;justify-content: center;align-items: center;">
			<text class="common" style="font-weight: normal;">font-weight: normal</text>
			<text class="common" style="font-weight: bold;">font-weight: bold</text>
			<text class="common" style="font-weight: 400;">font-weight: 400</text>
			<text class="common" style="font-weight: 700;">font-weight: 700</text>
		</view>

		<view class="uni-common-mt">
			<text class="uni-title-text">style.setProperty 动态设置 font-weight 测试</text>
			<text>font-weight: {{fontWeight}}</text>
			<view style="height: 100px;background-color: gray;justify-content: center;align-items: center;">
				<text ref="viewRef" class="common" style="font-weight: normal;" @click="changeFontWeight('bold')">点击修改 font-weight 为 bold</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	const fontWeight = ref('normal')
	const viewRef = ref(null as UniElement | null)

	const changeFontWeight = (value: string) => {
		fontWeight.value = value
		viewRef.value?.style.setProperty('font-weight', value)
	}
</script>

<style>
	.common {
		font-size: 20px;
	}
</style>