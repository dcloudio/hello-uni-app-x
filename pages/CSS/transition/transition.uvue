<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view class="container">
      <text class="text">点击修改宽度</text>
      <view class="base-style transition-width" id="widthOrHeight" @click="changeWidthOrHeight"></view>
    </view>
    <view class="container">
      <text class="text">点击修改宽度(递增)</text>
      <view class="width-progress transition-width" id="widthProgress" @click="changeWidthProgress"></view>
    </view>
    <view class="container">
      <text class="text">点击修改宽度(通过style设置transition)</text>
      <view class="base-style" style="transition-property: width; transition-duration: 1s;" id="widthOrHeightStyle"
        @click="changeWidthOrHeightStyle"></view>
    </view>

    <view class="container">
      <text class="text">点击修改Margin</text>
      <view class="base-style transition-margin" id="styleMargin" @click="changeMargin"></view>
    </view>
    <view class="container">
      <text class="text">点击修改Padding</text>
      <view class="base-style transition-padding" id="stylePadding" @click="changePadding">
        <view style="background-color: black; height: 50px; width: 50px"></view>
      </view>
    </view>
    <view class="container">
      <text class="text">点击修改background-color和opacity</text>
      <view class="base-style transition-background" id="styleBackground" @click="changeBackground"></view>
    </view>
    <view class="container">
      <text class="text">点击修改background-color（rgba）</text>
      <view style="flex: 1;">
        <view class="base-style transition-background" id="styleBackground2" @click="changeBackground2"></view>
      </view>
    </view>
    <view class="container">
      <text class="text">点击修改opacity渐隐渐现</text>
      <view class="base-style transition-opacity" id="styleOpacity" @click="changeStyleOpacity"></view>
    </view>
    <view class="container">
      <text class="text">动态修改background-color和duration</text>
      <view class="base-style" id="propertyStyleBackground" @click="propertyChangeBackground"></view>
    </view>
    <view class="container">
      <text class="text">点击修改Transform</text>
      <view class="base-style transition-transform" id="styleTransform" @click="changeTransform"></view>
    </view>
    <view class="container">
      <text class="text">点击修改TransformTranslate</text>
      <view class="base-style transition-transform" id="transformTranslate" @click="changeTransformTranslate"></view>
    </view>
    <view class="container">
      <text class="text">点击修改Transform和宽</text>
      <view class="base-style transition-transform-width" id="styleTransformWithWidth"
        @click="changeTransformWithWidth"></view>
    </view>
    <view class="container" @click="changeTransformWithOrigin">
      <text class="text">点击修改Transform（含transform-origin）</text>
      <view class="base-style transition-transform" style="transform-origin: 0 0;" id="styleTransformWithOrigin"></view>
    </view>

    <view class="container">
      <text class="text">点击修改Border</text>
      <view class="base-style transition-border" id="styleBorder" @click="changeBorder"></view>
    </view>
    <view class="container">
      <text class="text">点击修改Position</text>
      <view class="base-style transition-position" id="stylePosition" @click="changestylePosition"></view>
    </view>
    <view class="container">
      <text class="text">点击修改Scale
      </text>
      <view class="base-style transition-transform" id="styleChangScale" @click="changestyleScale"></view>
    </view>
    <view class="container">
      <text class="text">仅指定transition-duration背影有动画为正常</text>
      <view style="width: 100%;height: 50px;" :style="changestyleTransitionDuration"
        @click="doChangeTransitionDuration">
      </view>
    </view>

    <view class="container">
      <text class="text">transition-property: all/none 演示</text>
      <view class="base-style transition-all" id="styleTransitionAll" @click="changeTransitionAll"></view>
    </view>

    <view class="container">
      <text class="text">在组件内滑动测试是否闪动</text>
      <view class="base-style transition-transform" id="styleTransformTranslateScale" @touchmove="handleTouchMove"
        @touchstart="handleTouchStart" @touchend="handleTouchEnd">
        这是一段文字
      </view>
    </view>

    <view class="container">
      <text class="text">测试在style中同时修改transform和width</text>
      <view style="width:100%;height: 100%;">
        <view class="base-style transition-transform-width" id="styleTransformTranslateScale"
          :style="{transform:`translateX(${lineLeft}px)`,width:`${lineWidth}px`}" @click="changeTransform61">
        </view>
      </view>
    </view>

    <!-- #ifndef APP-ANDROID -->
    <view style="margin: 7px; height: 60px;">
      <navigator url="/pages/CSS/transition/transition-transform" hover-class="none">
        <button type="primary">
          transform 多个属性示例
        </button>
      </navigator>
    </view>
    <!-- #endif -->
    <view style="margin: 7px; height: 60px;">
      <navigator url="/pages/CSS/transition/transition-duration" hover-class="none">
        <button type="primary">
          transition-duration 示例
        </button>
      </navigator>
    </view>

    <view class="container">
      <text class="text">点击修改宽度(值为auto有无动画交替出现)</text>
      <view class="base-style transition-width" id="widthOrHeightAuto" @click="changeWidthOrHeightAuto"></view>
    </view>

    <view class="container">
      <view class="text">重复修改width</view>
      <view class="base-style transition-width" id="changeWidthInEnd" style="transition-duration: 0.5s;" @transitionend="onChangeWidthEnd" @click="changeWidthInEndFun"></view>
    </view>

    <view style="margin-top: 20px; margin-left: 7px;">
      <text style="font-size: 18px; font-weight: bold;">text 组件 transition 测试</text>
    </view>

    <view class="container">
      <text class="text">text 点击修改 transform (rotate)</text>
      <text class="text-base-style transition-transform" id="textTransform" @click="changeTextTransform">文字内容</text>
    </view>

    <view class="container">
      <text class="text">text 点击修改 opacity</text>
      <text class="text-base-style transition-opacity" id="textOpacity" @click="changeTextOpacity">文字内容</text>
    </view>

    <view class="container">
      <text class="text">text 点击修改 background-color</text>
      <text class="text-base-style transition-background" id="textBackground" @click="changeTextBackground">文字内容</text>
    </view>

    <view style="margin-top: 20px; margin-left: 7px;">
      <text style="font-size: 18px; font-weight: bold;">image 组件 transition 测试</text>
    </view>

    <view class="container">
      <text class="text">image 点击修改 transform (rotate)</text>
      <image class="image-base-style transition-transform" id="imageTransform" @click="changeImageTransform" src="/static/test-image/logo.png"></image>
    </view>

    <view class="container">
      <text class="text">image 点击修改 opacity</text>
      <image class="image-base-style transition-opacity" id="imageOpacity" @click="changeImageOpacity" src="/static/test-image/logo.png"></image>
    </view>

    <view class="container">
      <text class="text">image 点击修改 transform (scale)</text>
      <image class="image-base-style transition-transform" id="imageScale" @click="changeImageScale" src="/static/test-image/logo.png"></image>
    </view>

    <view class="container">
      <text class="text">设置box-shadow之后验证border和background-color效果</text>
      <view class="base-style transition-border-background" id="borderAndBackgroundColor" @click="changeBorderAndBackgroundColor"></view>
    </view>

    <view class="uni-common-mt">
      <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 transition 测试</text>
    </view>

    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件</text>
        <text class="test-info">设置值: {{transitionValue}}</text>
        <text class="test-info">获取值: {{transitionActual}}</text>
        <view class="test-box">
          <view ref="viewRefTransition" class="common-image" :style="{ transition: transitionValue }" @click="triggerTransitionView">
            <text style="font-size: 12px;">点击view</text>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件</text>
        <text class="test-info">设置值: {{transitionValue}}</text>
        <text class="test-info">获取值: {{transitionActualText}}</text>
        <view class="test-box">
          <text ref="textRefTransition" class="common-text" :style="{ transition: transitionValue }" @click="triggerTransitionText">点击text</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件</text>
        <text class="test-info">设置值: {{transitionValue}}</text>
        <text class="test-info">获取值: {{transitionActualImage}}</text>
        <view class="test-box">
          <image ref="imageRefTransition" class="common-image" :style="{ transition: transitionValue }" @click="triggerTransitionImage" src="/static/logo.png"></image>
        </view>
      </view>
    </view>

    <view class="test-container">
      <view class="test-item">
        <text class="uni-subtitle-text">view 组件拍平</text>
        <text class="test-info">设置值: {{transitionValue}}</text>
        <text class="test-info">获取值: {{transitionActualFlat}}</text>
        <view class="test-box">
          <view ref="viewRefTransitionFlat" class="common-image" :style="{ transition: transitionValue }" @click="triggerTransitionView" flatten>
            <text style="font-size: 12px;">点击view</text>
          </view>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">text 组件拍平</text>
        <text class="test-info">设置值: {{transitionValue}}</text>
        <text class="test-info">获取值: {{transitionActualTextFlat}}</text>
        <view class="test-box">
          <text ref="textRefTransitionFlat" class="common-text" :style="{ transition: transitionValue }" @click="triggerTransitionText" flatten>点击text</text>
        </view>
      </view>

      <view class="test-item">
        <text class="uni-subtitle-text">image 组件拍平</text>
        <text class="test-info">设置值: {{transitionValue}}</text>
        <text class="test-info">获取值: {{transitionActualImageFlat}}</text>
        <view class="test-box">
          <image ref="imageRefTransitionFlat" class="common-image" :style="{ transition: transitionValue }" @click="triggerTransitionImage" src="/static/logo.png" flatten></image>
        </view>
      </view>
    </view>

    <view class="uni-common-mt uni-common-mb">
      <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
      <enum-data :items="transitionEnum" title="transition 枚举值" @change="radioChangeTransition" :compact="true"></enum-data>
      <input-data :defaultValue="transitionValue" title="transition 自定义值" type="text" @confirm="inputChangeTransition"></input-data>
    </view>

  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const isTranstionWidthOrHeight = ref(false)
  const isTranstionWidthAuto = ref(false)
  const widthOrHeightAuto = ref(null as UniElement | null)
  const widthOrHeight = ref(null as UniElement | null)
  const widthProgress = ref(null as UniElement | null)
  const isTranstionWidthOrHeightStyle = ref(false)
  const widthOrHeightStyle = ref(null as UniElement | null)
  const progressWidth = ref(200)
  const isTranstionChangeMargin = ref(false)
  const styleMargin = ref(null as UniElement | null)
  const isTransitionStylePadding = ref(false)
  const stylePadding = ref(null as UniElement | null)
  const isTransitionstyleBackground = ref(false)
  const isTransitionstyleBackground2 = ref(false)
  const isTransitionstyleOpacity = ref(false)
  const styleBackground = ref(null as UniElement | null)
  const styleBackground2 = ref(null as UniElement | null)
  const styleOpacity = ref(null as UniElement | null)
  const isTransitionStyleTransform = ref(false)
  const styleTransform = ref(null as UniElement | null)
  const isTransitionStyleTransformWithWidth = ref(false)
  const styleTransformWithWidth = ref(null as UniElement | null)
  const isTransitionstyleBorder = ref(false)
  const styleBorder = ref(null as UniElement | null)
  const isTransitionstylePosition = ref(false)
  const stylePosition = ref(null as UniElement | null)
  const isSetTransition = ref(false)
  const isTransitionpropertystyleBackground = ref(false)
  const propertyStyleBackground = ref(null as UniElement | null)
  const isTransitionStyleTransformWithOrigin = ref(false)
  const styleTransformWithOrigin = ref(null as UniElement | null)
  const styleTransformTranslate = ref(null as UniElement | null)
  const isTransformTranslate = ref(false)
  const styleTransformTranslateScale = ref(null as UniElement | null)
  const startX = ref(0)
  const moveX = ref(0)
  const oldX = ref(0)
  const changestyleTransitionDuration = ref('background-color:brown;')
  const styleTransitionAll = ref(null as UniElement | null)
  const isTransitionAll = ref(false)
  const lineLeft = ref(0)
  const lineWidth = ref(200)
  const changeWidthInEnd = ref(null as UniElement | null)
  const changeWidthInEndCount = ref(0)
  const isTextTransform = ref(false)
  const textTransform = ref(null as UniElement | null)
  const isTextOpacity = ref(false)
  const textOpacity = ref(null as UniElement | null)
  const isTextBackground = ref(false)
  const textBackground = ref(null as UniElement | null)
  const isImageTransform = ref(false)
  const imageTransform = ref(null as UniElement | null)
  const isImageOpacity = ref(false)
  const imageOpacity = ref(null as UniElement | null)
  const isImageScale = ref(false)
  const imageScale = ref(null as UniElement | null)
  const isChangeBorderAndBackgroundColor = ref(false)
  const elChangeBorderAndBackgroundColor = ref(null as UniElement | null)
	// 测试例辅助函数
	const getChangeWidthInEndCount = ():number => {
	  return changeWidthInEndCount.value
	}

  onReady(() => {
    widthOrHeight.value = uni.getElementById("widthOrHeight")
    widthProgress.value = uni.getElementById("widthProgress")
    widthOrHeightStyle.value = uni.getElementById("widthOrHeightStyle")
    styleMargin.value = uni.getElementById("styleMargin")
    stylePadding.value = uni.getElementById("stylePadding")
    styleBackground.value = uni.getElementById("styleBackground")
    styleBackground2.value = uni.getElementById("styleBackground2")
    styleOpacity.value = uni.getElementById("styleOpacity")
    styleTransform.value = uni.getElementById("styleTransform")
    styleBorder.value = uni.getElementById("styleBorder")
    stylePosition.value = uni.getElementById("stylePosition")
    propertyStyleBackground.value = uni.getElementById("propertyStyleBackground")
    styleTransformWithOrigin.value = uni.getElementById("styleTransformWithOrigin")
    styleTransformWithWidth.value = uni.getElementById("styleTransformWithWidth")
    styleTransformTranslate.value = uni.getElementById("transformTranslate")
    styleTransformTranslateScale.value = uni.getElementById("styleTransformTranslateScale")
    styleTransitionAll.value = uni.getElementById("styleTransitionAll")
    widthOrHeightAuto.value = uni.getElementById("widthOrHeightAuto")
    changeWidthInEnd.value = uni.getElementById("changeWidthInEnd")
    textTransform.value = uni.getElementById("textTransform")
    textOpacity.value = uni.getElementById("textOpacity")
    textBackground.value = uni.getElementById("textBackground")
    imageTransform.value = uni.getElementById("imageTransform")
    imageOpacity.value = uni.getElementById("imageOpacity")
    imageScale.value = uni.getElementById("imageScale")
    elChangeBorderAndBackgroundColor.value = uni.getElementById("borderAndBackgroundColor")
  })

  const changeWidthOrHeight = () => {
    widthOrHeight.value?.style?.setProperty("width", isTranstionWidthOrHeight.value
      ? '200px'
      : '300px')
    isTranstionWidthOrHeight.value = !isTranstionWidthOrHeight.value
  }

  const changeWidthOrHeightAuto = () => {
    widthOrHeightAuto.value?.style?.setProperty("width", isTranstionWidthAuto.value
      ? '200px'
      : 'auto')
    isTranstionWidthAuto.value = !isTranstionWidthAuto.value
  }

  const changeWidthProgress = () => {
    progressWidth.value += 20
    widthProgress.value?.style?.setProperty("width", progressWidth.value + 'px')
  }

  const changeWidthOrHeightStyle = () => {
    widthOrHeightStyle.value?.style?.setProperty("width", isTranstionWidthOrHeightStyle.value
      ? '200px'
      : '300px')
    isTranstionWidthOrHeightStyle.value = !isTranstionWidthOrHeightStyle.value
  }

  const changeMargin = () => {
    styleMargin.value?.style?.setProperty("margin-top", isTranstionChangeMargin.value
      ? '0px'
      : '50px'
    )
    styleMargin.value?.style?.setProperty("margin-left", isTranstionChangeMargin.value
      ? '0px'
      : '50px'
    )
    isTranstionChangeMargin.value = !isTranstionChangeMargin.value
  }

  const changePadding = () => {
    stylePadding.value?.style?.setProperty("padding-top", isTransitionStylePadding.value
      ? '0px'
      : '50px')
    stylePadding.value?.style?.setProperty("padding-left", isTransitionStylePadding.value
      ? '0px'
      : '50px')
    isTransitionStylePadding.value = !isTransitionStylePadding.value
  }

  const changeBackground = () => {
    styleBackground.value?.style?.setProperty("background-color", isTransitionstyleBackground.value
      ? 'brown'
      : 'black'
    )
    styleBackground.value?.style?.setProperty("opacity", isTransitionstyleBackground.value
      ? '1'
      : '0.5'
    )
    isTransitionstyleBackground.value = !isTransitionstyleBackground.value
  }

  const changeBackground2 = () => {
    styleBackground2.value?.style?.setProperty("background-color", isTransitionstyleBackground2.value
      ? 'brown'
      : 'rgba(0, 0, 0, 0.5)'
    )
    isTransitionstyleBackground2.value = !isTransitionstyleBackground2.value
  }

  const changeStyleOpacity = () => {
    styleOpacity.value?.style?.setProperty("opacity", isTransitionstyleOpacity.value
      ? '1'
      : '0'
    )
    isTransitionstyleOpacity.value = !isTransitionstyleOpacity.value
  }

  const propertyChangeBackground = () => {
    if (!isSetTransition.value) {
      propertyStyleBackground.value?.style?.setProperty("transition-property", "background-color")
      propertyStyleBackground.value?.style?.setProperty("transition-duration", "1000ms")
      isSetTransition.value = true
    }
    propertyStyleBackground.value?.style?.setProperty("background-color", isTransitionpropertystyleBackground.value
      ? 'brown'
      : 'black'
    )
    isTransitionpropertystyleBackground.value = !isTransitionpropertystyleBackground.value
  }

  const changeTransform = () => {
    styleTransform.value?.style?.setProperty("transform", isTransitionStyleTransform.value
      ? 'rotate(0deg)'
      : 'rotate(135deg)'
    )
    isTransitionStyleTransform.value = !isTransitionStyleTransform.value
  }

  const changeTransformTranslate = () => {
    const translate = isTransformTranslate.value ? `translate(0%,0%)` : `translate(100%,0%)`
    styleTransformTranslate.value?.style?.setProperty('transform', translate)
    isTransformTranslate.value = !isTransformTranslate.value
  }

  const changeTransformWithWidth = () => {
    styleTransformWithWidth.value?.style?.setProperty("transform", isTransitionStyleTransformWithWidth.value
      ? 'rotate(0deg)'
      : 'rotate(135deg)'
    )
    styleTransformWithWidth.value?.style?.setProperty("width", isTransitionStyleTransformWithWidth.value
      ? '200px'
      : '100px'
    )
    isTransitionStyleTransformWithWidth.value = !isTransitionStyleTransformWithWidth.value
  }

  const changeTransformWithOrigin = () => {
    styleTransformWithOrigin.value?.style?.setProperty("transform", isTransitionStyleTransformWithOrigin.value
      ? 'scaleX(1)'
      : 'scaleX(0)'
    )
    isTransitionStyleTransformWithOrigin.value = !isTransitionStyleTransformWithOrigin.value
  }

  const changeBorder = () => {
    styleBorder.value?.style?.setProperty("border-color", isTransitionstyleBorder.value
      ? 'brown'
      : 'yellow'
    )
    isTransitionstyleBorder.value = !isTransitionstyleBorder.value
  }

  const changestylePosition = () => {
    stylePosition.value?.style?.setProperty("left", isTransitionstylePosition.value
      ? '0px'
      : '100px'
    )
    isTransitionstylePosition.value = !isTransitionstylePosition.value
  }

  const changestyleScale = () => {
    const el = uni.getElementById("styleChangScale")
    el?.style.setProperty("transition-duration", "0ms")
    el?.style.setProperty("transform", "translate(10px,10px) scale(1)")
    setTimeout(() => {
      el?.style.setProperty("transition-duration", "200ms")
      el?.style.setProperty("transform", "translate(10px,10px) scale(0.5)")
    }, 200)
  }

  const handleTouchStart = (e : UniTouchEvent) => {
    startX.value = e.changedTouches[0].clientX
  }

  const handleTouchMove = (e : UniTouchEvent) => {
    console.log("touchmove:" + e.touches[0].clientX + "," + e.touches[0].clientY)
    e.preventDefault()
    e.stopPropagation()
    const difX = e.changedTouches[0].clientX
    moveX.value = difX - startX.value + oldX.value
    styleTransformTranslateScale.value?.style?.setProperty('transition-duration', '0ms')
    styleTransformTranslateScale.value?.style?.setProperty('transform', `translate(${moveX.value}px,0px) scale(0.5) rotate(90deg)`)
  }

  const handleTouchEnd = (_ : UniTouchEvent) => {
    oldX.value = moveX.value
  }

  const doChangeTransitionDuration = () => {
    console.log("doChangeTransitionDuration")
    changestyleTransitionDuration.value
      = changestyleTransitionDuration.value == 'background-color:brown;' ? 'transition-duration: 2000ms;background-color: blue;' : 'background-color:brown;'
  }

  const changeTransitionAll = () => {
    if (!isTransitionAll.value) {
      // 设置为 all 时的效果
      styleTransitionAll.value?.style?.setProperty("transition-property", "all")
      styleTransitionAll.value?.style?.setProperty("width", "300px")
      styleTransitionAll.value?.style?.setProperty("height", "300px")
      styleTransitionAll.value?.style?.setProperty("background-color", "blue")
      styleTransitionAll.value?.style?.setProperty("transform", "rotate(45deg)")
    } else {
      // 设置为 none 时的效果
      styleTransitionAll.value?.style?.setProperty("transition-property", "none")
      styleTransitionAll.value?.style?.setProperty("width", "200px")
      styleTransitionAll.value?.style?.setProperty("height", "200px")
      styleTransitionAll.value?.style?.setProperty("background-color", "brown")
      styleTransitionAll.value?.style?.setProperty("transform", "rotate(0deg)")
    }
    isTransitionAll.value = !isTransitionAll.value
  }

  const changeTransform61 = () => {
    if (lineLeft.value == 0) {
      lineLeft.value = 70
      lineWidth.value = 300
    } else {
      lineLeft.value = 0
      lineWidth.value = 200
    }
  }

  const onChangeWidthEnd = (event : UniEvent) => {
    changeWidthInEnd.value?.style.setProperty("width","300px")
    changeWidthInEndCount.value++
  }

  const changeWidthInEndFun = () => {
    changeWidthInEnd.value?.style.setProperty("width","300px")
  }

  const changeTextTransform = () => {
    textTransform.value?.style?.setProperty("transform", isTextTransform.value
      ? 'rotate(0deg)'
      : 'rotate(45deg)'
    )
    isTextTransform.value = !isTextTransform.value
  }

  const changeTextOpacity = () => {
    textOpacity.value?.style?.setProperty("opacity", isTextOpacity.value
      ? '1'
      : '0.5'
    )
    isTextOpacity.value = !isTextOpacity.value
  }

  const changeTextBackground = () => {
    textBackground.value?.style?.setProperty("background-color", isTextBackground.value
      ? 'transparent'
      : 'yellow'
    )
    isTextBackground.value = !isTextBackground.value
  }

  const changeImageTransform = () => {
    imageTransform.value?.style?.setProperty("transform", isImageTransform.value
      ? 'rotate(0deg)'
      : 'rotate(45deg)'
    )
    isImageTransform.value = !isImageTransform.value
  }

  const changeImageOpacity = () => {
    imageOpacity.value?.style?.setProperty("opacity", isImageOpacity.value
      ? '1'
      : '0.5'
    )
    isImageOpacity.value = !isImageOpacity.value
  }

  const changeImageScale = () => {
    imageScale.value?.style?.setProperty("transform", isImageScale.value
      ? 'scale(1)'
      : 'scale(1.5)'
    )
    isImageScale.value = !isImageScale.value
  }

  function changeBorderAndBackgroundColor() {
    elChangeBorderAndBackgroundColor.value?.style?.setProperty("background-color",!isChangeBorderAndBackgroundColor.value?"pink":"brown")
    elChangeBorderAndBackgroundColor.value?.style?.setProperty("border-color",!isChangeBorderAndBackgroundColor.value?"yellow":"blue")
    isChangeBorderAndBackgroundColor.value = !isChangeBorderAndBackgroundColor.value
  }

  const transitionValue = ref('width 1s')
  const transitionActual = ref('')
  const transitionActualText = ref('')
  const transitionActualImage = ref('')
  const transitionActualFlat = ref('')
  const transitionActualTextFlat = ref('')
  const transitionActualImageFlat = ref('')
  const viewRefTransition = ref(null as UniElement | null)
  const textRefTransition = ref(null as UniTextElement | null)
  const imageRefTransition = ref(null as UniImageElement | null)
  const viewRefTransitionFlat = ref(null as UniElement | null)
  const textRefTransitionFlat = ref(null as UniTextElement | null)
  const imageRefTransitionFlat = ref(null as UniImageElement | null)
  const isExpandedTransition = ref(false)
  const isExpandedTransitionText = ref(false)
  const isExpandedTransitionImage = ref(false)

  const transitionEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'width 2s' },
    { value: 2, name: 'background-color 1s' },
    { value: 3, name: 'transform 1s' },
    { value: 4, name: 'all 1s' },
    { value: 5, name: 'width 1s, background-color 1s' }
  ]

  const changeTransition = (value: string) => {
    transitionValue.value = value
    // view 元素
    viewRefTransition.value?.style.setProperty('transition', value)
    // view 元素 - 拍平版本
    viewRefTransitionFlat.value?.style.setProperty('transition', value)
    // text 元素
    textRefTransition.value?.style.setProperty('transition', value)
    // text 元素 - 拍平版本
    textRefTransitionFlat.value?.style.setProperty('transition', value)
    // image 元素
    imageRefTransition.value?.style.setProperty('transition', value)
    // image 元素 - 拍平版本
    imageRefTransitionFlat.value?.style.setProperty('transition', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素
      const actualValue = viewRefTransition.value?.style.getPropertyValue('transition')
      transitionActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefTransitionFlat.value?.style.getPropertyValue('transition')
      transitionActualFlat.value = actualValueFlat ?? ''
      // text 元素
      const actualValueText = textRefTransition.value?.style.getPropertyValue('transition')
      transitionActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefTransitionFlat.value?.style.getPropertyValue('transition')
      transitionActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素
      const actualValueImage = imageRefTransition.value?.style.getPropertyValue('transition')
      transitionActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefTransitionFlat.value?.style.getPropertyValue('transition')
      transitionActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangeTransition = (index: number) => {
    const selectedItem = transitionEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeTransition(selectedItem.name)
    }
  }

  const inputChangeTransition = (value: string) => {
    changeTransition(value)
  }

  const triggerTransitionView = () => {
    const transition = transitionValue.value
    isExpandedTransition.value = !isExpandedTransition.value

    if (transition.includes('background-color')) {
      const color = isExpandedTransition.value ? 'red' : 'green'
      viewRefTransition.value?.style.setProperty('background-color', color)
      viewRefTransitionFlat.value?.style.setProperty('background-color', color)
    } else if (transition.includes('width')) {
      const width = isExpandedTransition.value ? '100px' : '50px'
      viewRefTransition.value?.style.setProperty('width', width)
      viewRefTransitionFlat.value?.style.setProperty('width', width)
    } else if (transition.includes('transform')) {
      const transform = isExpandedTransition.value ? 'rotate(45deg)' : 'rotate(0deg)'
      viewRefTransition.value?.style.setProperty('transform', transform)
      viewRefTransitionFlat.value?.style.setProperty('transform', transform)
    } else if (transition.includes('all')) {
      const width = isExpandedTransition.value ? '100px' : '50px'
      const color = isExpandedTransition.value ? 'red' : 'green'
      viewRefTransition.value?.style.setProperty('width', width)
      viewRefTransition.value?.style.setProperty('background-color', color)
      viewRefTransitionFlat.value?.style.setProperty('width', width)
      viewRefTransitionFlat.value?.style.setProperty('background-color', color)
    }
  }

  const triggerTransitionText = () => {
    const transition = transitionValue.value
    isExpandedTransitionText.value = !isExpandedTransitionText.value

    if (transition.includes('background-color')) {
      const color = isExpandedTransitionText.value ? 'red' : 'green'
      textRefTransition.value?.style.setProperty('background-color', color)
      textRefTransitionFlat.value?.style.setProperty('background-color', color)
    } else if (transition.includes('width')) {
      const width = isExpandedTransitionText.value ? '100px' : '50px'
      textRefTransition.value?.style.setProperty('width', width)
      textRefTransitionFlat.value?.style.setProperty('width', width)
    } else if (transition.includes('transform')) {
      const transform = isExpandedTransitionText.value ? 'rotate(45deg)' : 'rotate(0deg)'
      textRefTransition.value?.style.setProperty('transform', transform)
      textRefTransitionFlat.value?.style.setProperty('transform', transform)
    } else if (transition.includes('all')) {
      const width = isExpandedTransitionText.value ? '100px' : '50px'
      const color = isExpandedTransitionText.value ? 'red' : 'green'
      textRefTransition.value?.style.setProperty('width', width)
      textRefTransition.value?.style.setProperty('background-color', color)
      textRefTransitionFlat.value?.style.setProperty('width', width)
      textRefTransitionFlat.value?.style.setProperty('background-color', color)
    }
  }

  const triggerTransitionImage = () => {
    const transition = transitionValue.value
    isExpandedTransitionImage.value = !isExpandedTransitionImage.value

    if (transition.includes('background-color')) {
      const color = isExpandedTransitionImage.value ? 'red' : 'green'
      imageRefTransition.value?.style.setProperty('background-color', color)
      imageRefTransitionFlat.value?.style.setProperty('background-color', color)
    } else if (transition.includes('width')) {
      const width = isExpandedTransitionImage.value ? '100px' : '50px'
      imageRefTransition.value?.style.setProperty('width', width)
      imageRefTransitionFlat.value?.style.setProperty('width', width)
    } else if (transition.includes('transform')) {
      const transform = isExpandedTransitionImage.value ? 'rotate(45deg)' : 'rotate(0deg)'
      imageRefTransition.value?.style.setProperty('transform', transform)
      imageRefTransitionFlat.value?.style.setProperty('transform', transform)
    } else if (transition.includes('all')) {
      const width = isExpandedTransitionImage.value ? '100px' : '50px'
      const color = isExpandedTransitionImage.value ? 'red' : 'green'
      imageRefTransition.value?.style.setProperty('width', width)
      imageRefTransition.value?.style.setProperty('background-color', color)
      imageRefTransitionFlat.value?.style.setProperty('width', width)
      imageRefTransitionFlat.value?.style.setProperty('background-color', color)
    }
  }

  onReady(() => {
    // view 元素
    const actualValue = viewRefTransition.value?.style.getPropertyValue('transition')
    transitionActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefTransitionFlat.value?.style.getPropertyValue('transition')
    transitionActualFlat.value = actualValueFlat ?? ''
    // text 元素
    const actualValueText = textRefTransition.value?.style.getPropertyValue('transition')
    transitionActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefTransitionFlat.value?.style.getPropertyValue('transition')
    transitionActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素
    const actualValueImage = imageRefTransition.value?.style.getPropertyValue('transition')
    transitionActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefTransitionFlat.value?.style.getPropertyValue('transition')
    transitionActualImageFlat.value = actualValueImageFlat ?? ''
  })

	defineExpose({
	  changeWidthOrHeight,
	  changeWidthProgress,
	  changeMargin,
	  changePadding,
	  changeBackground,
	  changeBackground2,
	  changeStyleOpacity,
	  propertyChangeBackground,
	  changeTransform,
	  changeTransformTranslate,
	  changeTransformWithWidth,
	  changeTransformWithOrigin,
	  changeBorder,
	  changestylePosition,
	  changeTransitionAll,
	  changeWidthInEndFun,
	  getChangeWidthInEndCount,
    changeBorderAndBackgroundColor
	})

</script>

<style>
  .container {
    margin: 7px;
    background-color: white;
  }

  .text {
    margin-top: 10px;
    margin-bottom: 16px;
  }

  .base-style {
    width: 100px;
    height: 100px;
    background-color: brown;
  }

  .width-progress {
    width: 100px;
    height: 100px;
    background-color: brown;
  }

  .transform-bgColor {
    transition-property: background-color;
    transition-duration: 0.5s;
  }

  .transition-width {
    transition-property: width;
    transition-duration: 1s;
  }

  .transition-margin {
    transition-property: margin-left, margin-top;
    transition-duration: 1s;
  }

  .transition-padding {
    transition-property: padding-left, padding-top;
    transition-duration: 1s;
  }

  .transition-background {
    transition-property: background-color, opacity;
    transition-duration: 1s;
  }

  .transition-opacity {
    transition-property: opacity;
    transition-duration: 1s;
  }

  .transition-transform {
    transform: translate(0%, 0%) scaleX(1) rotate(0deg);
    transition-property: transform;
    transition-duration: 1s;
  }

  .transition-border {
    border-width: 5px;
    border-color: brown;
    border-style: solid;
    transition-property: border-color;
    transition-duration: 1s;
  }

  .transition-position {
    left: 0px;
    transition-property: left;
    transition-duration: 1s;
  }

  .transition-transform-width {
    transform: rotate(0deg);
    transition-property: transform, width;
    transition-duration: 1s;
  }

  .transition-all {
    transition-property: all;
    transition-duration: 1s;
  }

  .text-base-style {
    width: 200px;
    height: 50px;
    padding: 10px;
    font-size: 16px;
    text-align: center;
    background-color: lightblue;
  }

  .image-base-style {
    width: 100px;
    height: 100px;
  }
  .transition-border-background {
    box-shadow: 8px 8px 8px rgba(0, 255, 0, 1);
    border-color: blue;
    border-width: 3px;
    border-style: solid;
    transition-property: border-color, background-color;
    transition-duration: 1s;
  }

  .common-text {
    width: 50px;
    height: 50px;
    background-color: green;
    font-size: 12px;
    color: white;
  }

  .common-image {
    width: 50px;
    height: 50px;
    background-color: green;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 120px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
