          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{backgroundColor}}</text>
          <text class="test-info">获取值: {{backgroundColorActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-view test-view-flatten" :style="{ backgroundColor: backgroundColor }" flatten>
