  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1">
      <view>
        <text>background-color: red</text>
        <view class="common" style="background-color: red"></view>
        <view class="common uni-common-mt" style="background-color: red" flatten></view>
      </view>

      <view>
        <text>background-color: #ff0000</text>
        <view class="common" style="background-color: #ff0000"></view>
        <view class="common uni-common-mt" style="background-color: #ff0000" flatten></view>
      </view>

      <view>
        <text>background-color: #f00</text>
        <view class="common" style="background-color: #f00"></view>
        <view class="common uni-common-mt" style="background-color: #f00" flatten></view>
      </view>

      <view>
        <text>background-color: #ff000080</text>
        <view class="common" style="background-color: #ff000080"></view>
        <view class="common uni-common-mt" style="background-color: #ff000080" flatten></view>
      </view>

      <view>
        <text>background-color: #f008</text>
        <view class="common" style="background-color: #f008"></view>
        <view class="common uni-common-mt" style="background-color: #f008" flatten></view>
      </view>

      <view>
        <text>background-color: rgb(255, 0, 0)</text>
        <view class="common" style="background-color: rgb(255, 0, 0)"></view>
        <view class="common uni-common-mt" style="background-color: rgb(255, 0, 0)" flatten></view>
      </view>

      <view>
        <text>background-color: rgba(255, 0, 0, 0.5)</text>
        <view class="common" style="background-color: rgba(255, 0, 0, 0.5)"></view>
        <view class="common uni-common-mt" style="background-color: rgba(255, 0, 0, 0.5)" flatten></view>
      </view>
      <view>
        <text>background-color: #ff000080</text>
        <view class="common" style="background-color: #ff000080"></view>
        <view class="common uni-common-mt" style="background-color: #ff000080" flatten></view>
      </view>
      <view style="margin-left: 30px;margin-right: 30px;">
        <button type="default" @click="jumpToCheckBoxWithBackgroundColor">应用background-color示例</button>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">text 组件 background-color 测试</text>
      </view>

      <view>
        <text>text background-color: red</text>
        <text class="common" style="background-color: red">文字内容</text>
        <text class="common uni-common-mt" style="background-color: red" flatten>文字内容</text>
      </view>

      <view>
        <text>text background-color: rgba(0, 0, 255, 0.5)</text>
        <text class="common" style="background-color: rgba(0, 0, 255, 0.5)">文字内容</text>
        <text class="common uni-common-mt" style="background-color: rgba(0, 0, 255, 0.5)" flatten>文字内容</text>
      </view>

      <view>
        <text>text background-color: #00ff00</text>
        <text class="common" style="background-color: #00ff00">文字内容</text>
        <text class="common uni-common-mt" style="background-color: #00ff00" flatten>文字内容</text>
      </view>

      <view>
        <text>text background-color: #ff000080</text>
        <text class="common" style="background-color: #ff000080">文字内容</text>
        <text class="common uni-common-mt" style="background-color: #ff000080" flatten>文字内容</text>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">image 组件 background-color 测试</text>
      </view>

      <view>
        <text>image background-color: red (无src时显示背景色)</text>
        <image class="common" style="background-color: red"></image>
        <image class="common uni-common-mt" style="background-color: red" flatten></image>
      </view>

      <view>
        <text>image background-color: rgba(0, 0, 255, 0.5) (无src时显示背景色)</text>
        <image class="common" style="background-color: rgba(0, 0, 255, 0.5)"></image>
        <image class="common uni-common-mt" style="background-color: rgba(0, 0, 255, 0.5)" flatten></image>
      </view>

      <view>
        <text>image background-color: #00ff00 (无src时显示背景色)</text>
        <image class="common" style="background-color: #00ff00"></image>
        <image class="common uni-common-mt" style="background-color: #00ff00" flatten></image>
      </view>

      <view>
        <text>image background-color: #ff000080 (无src时显示背景色)</text>
        <image class="common" style="background-color: #ff000080"></image>
        <image class="common uni-common-mt" style="background-color: #ff000080" flatten></image>
      </view>

      <view>
        <text>image background-color: yellow (有src时，背景色在图片加载失败或透明区域显示)</text>
        <image class="common" style="background-color: yellow" src="/static/test-image/logo.png"></image>
        <image class="common uni-common-mt" style="background-color: yellow" src="/static/test-image/logo.png" flatten></image>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">style.setProperty 动态设置 background-color 测试</text>
        <text>background-color: {{backgroundColor}}</text>
        <view ref="viewRef" class="common" :style="{ backgroundColor: backgroundColor }">
          <text>当前 background-color: {{backgroundColor}}</text>
        </view>
      </view>

      <!-- 测试控制区域 -->
      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :compact="true" :items="backgroundColorEnum" title="background-color 枚举值" @change="radioChangeBackgroundColor"></enum-data>
        <input-data :defaultValue="backgroundColor" title="background-color 自定义值" type="text" @confirm="inputChangeBackgroundColor"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup>
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const backgroundColor = ref('red')
  const viewRef = ref(null as UniElement | null)

  const backgroundColorEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'red' },
    { value: 2, name: '#ff0000' },
    { value: 3, name: 'rgb(255, 0, 0)' },
    { value: 4, name: 'rgba(255, 0, 0, 0.5)' },
    { value: 5, name: 'blue' },
    { value: 6, name: 'rgba(0, 0, 255, 0.5)' },
    { value: 7, name: 'transparent' }
  ]

  const changeBackgroundColor = (color: string) => {
    backgroundColor.value = color
    viewRef.value?.style.setProperty('background-color', color)
  }

  const radioChangeBackgroundColor = (index: number) => {
    const selectedItem = backgroundColorEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeBackgroundColor(selectedItem.name)
    }
  }

  const inputChangeBackgroundColor = (value: string) => {
    changeBackgroundColor(value)
  }

  const jumpToCheckBoxWithBackgroundColor = () => {
    uni.navigateTo({
      url:"/pages/CSS/background/background-color-check-box"
    })
  }
</script>

<style>
  .common {
    width: 150px;
    height: 150px;
  }
</style>
