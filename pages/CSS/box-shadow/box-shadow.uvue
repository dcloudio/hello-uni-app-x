<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1">
      <view>
        <text>box-shadow: 5px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: 5px 5px 5px #00FF00</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px #00FF00"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px #00FF00" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: 5px 5px 5px rgb(0,0,255)</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px rgb(0,0,255)"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px rgb(0,0,255)" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: 5px 5px 5px rgba(0,255,255,0.5)</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px rgba(0,255,255,0.5)"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px rgba(0,255,255,0.5)" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: 5px 5px 5px rgba(0, 0, 0, 0.5)</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px rgba(0, 0, 0, 0.5)"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px rgba(0, 0, 0, 0.5)" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: 5px 5px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: 5px 10px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 10px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 10px 5px black" flatten></view>
        </view>
      </view>
      <view>
        <text>box-shadow: 5px 5px 5px 5px black（harmony暂不支持阴影扩散半径）</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 5px 5px 5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: -5px -5px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: -5px -5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: -5px -5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>box-shadow: inset 5px 5px black（harmony暂不支持inset）</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: inset 5px 5px black"></view>
        </view>
      </view>

      <view>
        <text>box-shadow: inset 5px 5px 5px black（harmony暂不支持inset）</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: inset 5px 5px 5px black"></view>
        </view>
      </view>

      <view>
        <text>box-shadow: inset 5px 10px 5px black（harmony暂不支持inset）</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: inset 5px 10px 5px black"></view>
        </view>
      </view>

      <view>
        <text>box-shadow: inset 5px 5px 5px 5px black（harmony暂不支持inset）</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: inset 5px 5px 5px 5px black"></view>
        </view>
      </view>

      <view>
        <text>box-shadow: inset -5px -5px 5px black（harmony暂不支持inset）</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: inset -5px -5px 5px black"></view>
        </view>
      </view>

      <view>
        <text>box-shadow: 0px 1px 3px rgba(0,0,0,0.4)</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.4)"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.4)" flatten></view>
        </view>
      </view>

      <view>
        <text>circle: box-shadow: 5px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>circle: box-shadow: 5px 5px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>circle: box-shadow: 5px 10px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 10px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 10px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>circle: box-shadow: 5px 5px 5px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 5px 5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: 5px 5px 5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>circle: box-shadow: -5px -5px 5px black</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: -5px -5px 5px black"></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="border-radius: 62px; box-shadow: -5px -5px 5px black" flatten></view>
        </view>
      </view>

      <view>
        <text>circle: box-shadow: 0px 1px 3px rgba(0,0,0,0.4)</text>
        <view class="backgroundview">
          <view class="common" style="
              border-radius: 62px;
              box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.4);
            "></view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view class="common" style="
              border-radius: 62px;
              box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.4);
            " flatten></view>
        </view>
      </view>

      <view>
        <text>点击动态切换 box-shadow: none</text>
        <view class="backgroundview" @click="changed">
          <view :class="['common', disabled ? 'disabledShadow' : 'shadow']"></view>
        </view>
      </view>

      <view>
        <text>点击动态切换 box-shadow: 非法值</text>
        <view class="backgroundview" @click="changed">
          <view :class="['common', disabled ? 'invalidShadow' : 'shadow']"></view>
        </view>
      </view>

      <view>
        <text>box-shadow父视图动态改变高度的渲染效果</text>
        <view class="backgroundview">
          <view
          	style="justify-content: center;align-items: center;width: 150px;background-color: red;box-shadow: 0 0 10px">
          	<view>
          		<textarea id="dynamic-height-textarea" style="margin: 20px;background-color: aqua;height: 32px;width: 110px;"
          			value="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"></textarea>
          	</view>
          </view>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <view
          	style="justify-content: center;align-items: center;width: 150px;background-color: red;box-shadow: 0 0 10px" flatten>
          	<view>
          		<textarea id="dynamic-height-textarea" style="margin: 20px;background-color: aqua;height: 32px;width: 110px;"
          			value="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"></textarea>
          	</view>
          </view>
        </view>
      </view>
      <view>
        <text>text组件: box-shadow: 5px 5px black</text>
        <view class="backgroundview">
          <text class="text-shadow" style="box-shadow: 5px 5px black;">测试文本</text>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <text class="text-shadow" style="box-shadow: 5px 5px black;" flatten>测试文本</text>
        </view>
      </view>
      <view>
        <text>text组件: box-shadow: 5px 5px 5px #00FF00</text>
        <view class="backgroundview">
          <text class="text-shadow" style="box-shadow: 5px 5px 5px #00FF00;">测试文本</text>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <text class="text-shadow" style="box-shadow: 5px 5px 5px #00FF00;" flatten>测试文本</text>
        </view>
      </view>
      <view>
        <text>image组件: box-shadow: 5px 5px black</text>
        <view class="backgroundview">
          <image class="image-shadow" style="box-shadow: 5px 5px black;" src="/static/logo.png"></image>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <image class="image-shadow" style="box-shadow: 5px 5px black;" src="/static/logo.png" flatten></image>
        </view>
      </view>
      <view>
        <text>image组件: box-shadow: 5px 5px 5px #00FF00</text>
        <view class="backgroundview">
          <image class="image-shadow" style="box-shadow: 5px 5px 5px #00FF00;" src="/static/logo.png"></image>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <image class="image-shadow" style="box-shadow: 5px 5px 5px #00FF00;" src="/static/logo.png" flatten></image>
        </view>
      </view>
      <view>
        <text>image组件（圆形）: box-shadow: 5px 5px black</text>
        <view class="backgroundview">
          <image class="image-shadow-circle" style="border-radius: 62px; box-shadow: 5px 5px black;" src="/static/logo.png"></image>
        </view>
        <text>拍平测试</text>
        <view class="backgroundview">
          <image class="image-shadow-circle" style="border-radius: 62px; box-shadow: 5px 5px black;" src="/static/logo.png" flatten></image>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 box-shadow 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <!-- view 组件测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{boxShadow}}</text>
          <text class="test-info">获取值: {{boxShadowActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ boxShadow: boxShadow }">
              <text class="common-text">view测试</text>
            </view>
          </view>
        </view>

        <!-- text 组件测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{boxShadow}}</text>
          <text class="test-info">获取值: {{boxShadowActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic common-text" :style="{ boxShadow: boxShadow }">text测试</text>
          </view>
        </view>

        <!-- image 组件测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{boxShadow}}</text>
          <text class="test-info">获取值: {{boxShadowActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-dynamic" :style="{ boxShadow: boxShadow }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本（注意：不支持 inset 值） -->
      <view class="test-container" v-if="!boxShadow.includes('inset')">
        <!-- view 组件拍平测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{boxShadow}}</text>
          <text class="test-info">获取值: {{boxShadowActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ boxShadow: boxShadow }" flatten>
              <text class="common-text">view测试</text>
            </view>
          </view>
        </view>

        <!-- text 组件拍平测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{boxShadow}}</text>
          <text class="test-info">获取值: {{boxShadowActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic common-text" :style="{ boxShadow: boxShadow }" flatten>text测试</text>
          </view>
        </view>

        <!-- image 组件拍平测试 -->
        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{boxShadow}}</text>
          <text class="test-info">获取值: {{boxShadowActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-dynamic" :style="{ boxShadow: boxShadow }" flatten src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 测试控制区域 -->
      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :compact="true" :items="boxShadowEnum" title="box-shadow 枚举值" @change="radioChangeBoxShadow"></enum-data>
        <input-data :defaultValue="boxShadow" title="box-shadow 自定义值" type="text" @confirm="inputChangeBoxShadow"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const disabled = ref(false)
  const changed = () => {
    disabled.value = !disabled.value
  }

  const boxShadow = ref('5px 5px black')
  const boxShadowActual = ref('')
  const boxShadowActualText = ref('')
  const boxShadowActualImage = ref('')
  const boxShadowActualFlat = ref('')
  const boxShadowActualTextFlat = ref('')
  const boxShadowActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const boxShadowEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'none' },
    { value: 2, name: '5px 5px black' },
    { value: 3, name: '5px 5px 5px black' },
    { value: 4, name: '10px 10px 10px red' },
    { value: 5, name: '5px 5px 5px 5px black' },
    { value: 6, name: '-5px -5px 5px black' },
    { value: 7, name: '0px 1px 3px rgba(0,0,0,0.4)' },
    { value: 8, name: 'inset 5px 5px black' }
  ]

  const changeBoxShadow = (value: string) => {
    boxShadow.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('box-shadow', value)
    const actualValue = viewRef.value?.style.getPropertyValue('box-shadow')
    boxShadowActual.value = actualValue ?? ''
    // view 元素 - 拍平版本（不支持 inset 值）
    if (!value.includes('inset')) {
      viewRefFlat.value?.style.setProperty('box-shadow', value)
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('box-shadow')
      boxShadowActualFlat.value = actualValueFlat ?? ''
    } else {
      boxShadowActualFlat.value = '不支持 inset'
    }
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('box-shadow', value)
    const actualValueText = textRef.value?.style.getPropertyValue('box-shadow')
    boxShadowActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本（不支持 inset 值）
    if (!value.includes('inset')) {
      textRefFlat.value?.style.setProperty('box-shadow', value)
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('box-shadow')
      boxShadowActualTextFlat.value = actualValueTextFlat ?? ''
    } else {
      boxShadowActualTextFlat.value = '不支持 inset'
    }
    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('box-shadow', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('box-shadow')
    boxShadowActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本（不支持 inset 值）
    if (!value.includes('inset')) {
      imageRefFlat.value?.style.setProperty('box-shadow', value)
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('box-shadow')
      boxShadowActualImageFlat.value = actualValueImageFlat ?? ''
    } else {
      boxShadowActualImageFlat.value = '不支持 inset'
    }
  }

  const radioChangeBoxShadow = (index: number) => {
    const selectedItem = boxShadowEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeBoxShadow(selectedItem.name)
    }
  }

  const inputChangeBoxShadow = (value: string) => {
    changeBoxShadow(value)
  }

  onReady(() => {
    nextTick(() => {
      const element = uni.getElementById("dynamic-height-textarea")
      element?.style.setProperty("height", "52px")
    })
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('box-shadow')
    boxShadowActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    if (!boxShadow.value.includes('inset')) {
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('box-shadow')
      boxShadowActualFlat.value = actualValueFlat ?? ''
    } else {
      boxShadowActualFlat.value = '不支持 inset'
    }
    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('box-shadow')
    boxShadowActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    if (!boxShadow.value.includes('inset')) {
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('box-shadow')
      boxShadowActualTextFlat.value = actualValueTextFlat ?? ''
    } else {
      boxShadowActualTextFlat.value = '不支持 inset'
    }
    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('box-shadow')
    boxShadowActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    if (!boxShadow.value.includes('inset')) {
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('box-shadow')
      boxShadowActualImageFlat.value = actualValueImageFlat ?? ''
    } else {
      boxShadowActualImageFlat.value = '不支持 inset'
    }
  })
</script>

<style>
  .common {
    width: 100px;
    height: 100px;
    background-color: brown;
  }

  .backgroundview {
    width: 150px;
    height: 150px;
    background-color: white;
    justify-content: center;
    align-items: center;
  }

  .big{
    width: 200px;
    height: 200px;
  }

  .shadow {
    box-shadow: 5px 5px black;
  }

  .disabledShadow {
    box-shadow: none;
  }

  .invalidShadow {
    box-shadow: abcd;
  }

  .text-shadow {
    width: 125px;
    height: 125px;
    background-color: brown;
    font-size: 16px;
    color: white;
  }

  .image-shadow {
    width: 125px;
    height: 125px;
    background-color: brown;
  }

  .image-shadow-circle {
    width: 125px;
    height: 125px;
    background-color: brown;
  }

  /* 多组件横向布局样式 */
  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 80px;
    background-color: gray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }

  .common-dynamic{
    width: 50px;
    height: 50px;
    background-color: green;
  }

  .common-text {
    font-size: 12px;
    color: white;
  }

</style>
