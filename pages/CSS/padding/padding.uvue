<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>padding: 25px</text>
        <view class="common" style="padding: 25px;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <view class="common" style="padding: 25px;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>

      <view style="width: 250px;">
        <text>padding: 10%</text>
        <view class="common" style="padding: 10%;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <view class="common" style="padding: 10%;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>
      <view>
        <text>text组件: padding: 25px</text>
        <text class="text-padding" style="padding: 25px;">测试文本</text>
        <text class="text-padding" style="padding: 25px;" flatten>测试文本</text>
      </view>
      <view style="width: 250px;">
        <text>text组件: padding: 10%</text>
        <text class="text-padding-percent" style="padding: 10%;">测试文本</text>
        <text class="text-padding-percent" style="padding: 10%;" flatten>测试文本</text>
      </view>
      <view>
        <text>image组件: padding: 25px</text>
        <image class="image-padding" style="padding: 25px;" src="/static/logo.png"></image>
        <image class="image-padding" style="padding: 25px;" src="/static/logo.png" flatten></image>
      </view>
      <view style="width: 250px;">
        <text>image组件: padding: 10%</text>
        <image class="image-padding-percent" style="padding: 10%;" src="/static/logo.png"></image>
        <image class="image-padding-percent" style="padding: 10%;" src="/static/logo.png" flatten></image>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">style.setProperty 动态设置 padding 测试</text>
        <text>padding: {{padding}}</text>
        <view ref="viewRef" class="common" style="padding: 25px;" @click="changePadding('50px')">
          <view style="flex-grow: 1;background-color: red;"></view>
          <text>点击修改 padding 为 50px</text>
        </view>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  const padding = ref('25px')
  const viewRef = ref(null as UniElement | null)

  const changePadding = (value: string) => {
    padding.value = value
    viewRef.value?.style.setProperty('padding', value)
  }
</script>

<style>
  .common {
    width: 250px;
    height: 250px;
    background-color: gray;
  }

  .text-padding {
    width: 250px;
    height: 250px;
    background-color: gray;
    font-size: 16px;
    color: black;
  }

  .text-padding-percent {
    width: 250px;
    height: 250px;
    background-color: gray;
    font-size: 16px;
    color: black;
  }

  .image-padding {
    width: 250px;
    height: 250px;
    background-color: gray;
  }

  .image-padding-percent {
    width: 250px;
    height: 250px;
    background-color: gray;
  }
</style>
