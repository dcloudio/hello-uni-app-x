<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>padding: 25px</text>
        <view class="common" style="padding: 25px;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="padding: 25px;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>

      <view style="width: 250px;">
        <text>padding: 10%</text>
        <view class="common" style="padding: 10%;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="padding: 10%;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>
      <view>
        <text>text组件: padding: 25px</text>
        <text class="text-padding" style="padding: 25px;">测试文本</text>
        <text>拍平测试</text>
        <text class="text-padding" style="padding: 25px;" flatten>测试文本</text>
      </view>
      <view style="width: 250px; ">
        <text>text组件: padding: 10%</text>
        <text class="text-padding" style="padding: 10%;">测试文本</text>
        <text>拍平测试</text>
        <text class="text-padding" style="padding: 10%;" flatten>测试文本</text>
      </view>
      <view>
        <text>image组件: padding: 25px</text>
        <image class="image-padding" style="padding: 25px;" src="/static/logo.png"></image>
        <text>拍平测试</text>
        <image class="image-padding" style="padding: 25px;" src="/static/logo.png" flatten></image>
      </view>
      <view style="width: 250px;">
        <text>image组件: padding: 10%</text>
        <image class="image-padding" style="padding: 10%;" src="/static/logo.png"></image>
        <text>拍平测试</text>
        <image class="image-padding" style="padding: 10%;" src="/static/logo.png" flatten></image>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 padding 测试</text>
      </view>

      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{padding}}</text>
          <text class="test-info">获取值: {{paddingActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ padding: padding }">
              <view style="flex-grow: 1;background-color: red;">
                <text>view测试</text>
              </view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{padding}}</text>
          <text class="test-info">获取值: {{paddingActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ padding: padding }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{padding}}</text>
          <text class="test-info">获取值: {{paddingActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-image" :style="{ padding: padding }" src="/static/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="paddingEnum" title="padding 枚举值" @change="radioChangePadding" :compact="true"></enum-data>
        <input-data :defaultValue="padding" title="padding 自定义值" type="text" @confirm="inputChangePadding"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const padding = ref('20px')
  const paddingActual = ref('')
  const paddingActualText = ref('')
  const paddingActualImage = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)

  const paddingEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '10%' }
  ]

  const changePadding = (value: string) => {
    padding.value = value
    // view 元素
    viewRef.value?.style.setProperty('padding', value)
    const actualValue = viewRef.value?.style.getPropertyValue('padding')
    paddingActual.value = actualValue ?? ''
    // text 元素
    textRef.value?.style.setProperty('padding', value)
    const actualValueText = textRef.value?.style.getPropertyValue('padding')
    paddingActualText.value = actualValueText ?? ''
    // image 元素
    imageRef.value?.style.setProperty('padding', value)
    const actualValueImage = imageRef.value?.style.getPropertyValue('padding')
    paddingActualImage.value = actualValueImage ?? ''
  }

  const radioChangePadding = (index: number) => {
    const selectedItem = paddingEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changePadding(selectedItem.name)
    }
  }

  const inputChangePadding = (value: string) => {
    changePadding(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素
    const actualValue = viewRef.value?.style.getPropertyValue('padding')
    paddingActual.value = actualValue ?? ''
    // text 元素
    const actualValueText = textRef.value?.style.getPropertyValue('padding')
    paddingActualText.value = actualValueText ?? ''
    // image 元素
    const actualValueImage = imageRef.value?.style.getPropertyValue('padding')
    paddingActualImage.value = actualValueImage ?? ''
  })
</script>

<style>
  .common {
    width: 250px;
    height: 100px;
    background-color: gray;
  }

  .common-dynamic {
    height: 80px;
    background-color: gray;
  }

  .common-image {
    width: 80px;
    height: 80px;
    background-color: gray;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 100px;
    background-color: lightgray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }

  .text-padding {
    width: 250px;
    height: 100px;
    background-color: gray;
    font-size: 16px;
    color: black;
  }

  .image-padding {
    width: 100px;
    height: 100px;
    background-color: gray;
  }

  .tips{
    font-size: 14px;
    background-color: #ffebbb;
  }

</style>
