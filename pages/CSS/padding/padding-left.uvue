<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>padding-left: 25px</text>
        <view class="common" style="padding-left: 25px;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="padding-left: 25px;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>

      <view style="width: 250px;">
        <text>padding-left: 10%</text>
        <view class="common" style="padding-left: 10%;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="padding-left: 10%;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">setProperty 设置与 getPropertyValue 获取 padding-left 测试</text>
      </view>

      <!-- 普通版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件</text>
          <text class="test-info">设置值: {{paddingLeft}}</text>
          <text class="test-info">获取值: {{paddingLeftActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ paddingLeft: paddingLeft }">
              <view style="flex-grow: 1;background-color: red;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件</text>
          <text class="test-info">设置值: {{paddingLeft}}</text>
          <text class="test-info">获取值: {{paddingLeftActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ paddingLeft: paddingLeft }">text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件</text>
          <text class="test-info">设置值: {{paddingLeft}}</text>
          <text class="test-info">获取值: {{paddingLeftActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-image" :style="{ paddingLeft: paddingLeft }" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="test-container">
        <view class="test-item">
          <text class="uni-subtitle-text">view 组件拍平</text>
          <text class="test-info">设置值: {{paddingLeft}}</text>
          <text class="test-info">获取值: {{paddingLeftActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ paddingLeft: paddingLeft }" flatten>
              <view style="flex-grow: 1;background-color: red;"><text>view测试</text></view>
            </view>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">text 组件拍平</text>
          <text class="test-info">设置值: {{paddingLeft}}</text>
          <text class="test-info">获取值: {{paddingLeftActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ paddingLeft: paddingLeft }" flatten>text测试</text>
          </view>
        </view>

        <view class="test-item">
          <text class="uni-subtitle-text">image 组件拍平</text>
          <text class="test-info">设置值: {{paddingLeft}}</text>
          <text class="test-info">获取值: {{paddingLeftActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-image" :style="{ paddingLeft: paddingLeft }" flatten src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个枚举值，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="paddingLeftEnum" title="padding-left 枚举值" @change="radioChangePaddingLeft" :compact="true"></enum-data>
        <input-data :defaultValue="paddingLeft" title="padding-left 自定义值" type="text" @confirm="inputChangePaddingLeft"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const paddingLeft = ref('25px')
  const paddingLeftActual = ref('')
  const paddingLeftActualText = ref('')
  const paddingLeftActualImage = ref('')
  const paddingLeftActualFlat = ref('')
  const paddingLeftActualTextFlat = ref('')
  const paddingLeftActualImageFlat = ref('')
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const paddingLeftEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '10%' }
  ]

  const changePaddingLeft = (value: string) => {
    paddingLeft.value = value
    // view 元素 - 普通版本
    viewRef.value?.style.setProperty('padding-left', value)
    // view 元素 - 拍平版本
    viewRefFlat.value?.style.setProperty('padding-left', value)
    // text 元素 - 普通版本
    textRef.value?.style.setProperty('padding-left', value)
    // text 元素 - 拍平版本
    textRefFlat.value?.style.setProperty('padding-left', value)
    // image 元素 - 普通版本
    imageRef.value?.style.setProperty('padding-left', value)
    // image 元素 - 拍平版本
    imageRefFlat.value?.style.setProperty('padding-left', value)

    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      // view 元素 - 普通版本
      const actualValue = viewRef.value?.style.getPropertyValue('padding-left')
      paddingLeftActual.value = actualValue ?? ''
      // view 元素 - 拍平版本
      const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('padding-left')
      paddingLeftActualFlat.value = actualValueFlat ?? ''
      // text 元素 - 普通版本
      const actualValueText = textRef.value?.style.getPropertyValue('padding-left')
      paddingLeftActualText.value = actualValueText ?? ''
      // text 元素 - 拍平版本
      const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('padding-left')
      paddingLeftActualTextFlat.value = actualValueTextFlat ?? ''
      // image 元素 - 普通版本
      const actualValueImage = imageRef.value?.style.getPropertyValue('padding-left')
      paddingLeftActualImage.value = actualValueImage ?? ''
      // image 元素 - 拍平版本
      const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('padding-left')
      paddingLeftActualImageFlat.value = actualValueImageFlat ?? ''
    })
  }

  const radioChangePaddingLeft = (index: number) => {
    const selectedItem = paddingLeftEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changePaddingLeft(selectedItem.name)
    }
  }

  const inputChangePaddingLeft = (value: string) => {
    changePaddingLeft(value)
  }

  // 页面初次渲染完成后获取初始值
  onReady(() => {
    // view 元素 - 普通版本
    const actualValue = viewRef.value?.style.getPropertyValue('padding-left')
    paddingLeftActual.value = actualValue ?? ''
    // view 元素 - 拍平版本
    const actualValueFlat = viewRefFlat.value?.style.getPropertyValue('padding-left')
    paddingLeftActualFlat.value = actualValueFlat ?? ''
    // text 元素 - 普通版本
    const actualValueText = textRef.value?.style.getPropertyValue('padding-left')
    paddingLeftActualText.value = actualValueText ?? ''
    // text 元素 - 拍平版本
    const actualValueTextFlat = textRefFlat.value?.style.getPropertyValue('padding-left')
    paddingLeftActualTextFlat.value = actualValueTextFlat ?? ''
    // image 元素 - 普通版本
    const actualValueImage = imageRef.value?.style.getPropertyValue('padding-left')
    paddingLeftActualImage.value = actualValueImage ?? ''
    // image 元素 - 拍平版本
    const actualValueImageFlat = imageRefFlat.value?.style.getPropertyValue('padding-left')
    paddingLeftActualImageFlat.value = actualValueImageFlat ?? ''
  })
</script>

<style>
  .common {
    width: 250px;
    height: 100px;
    background-color: gray;
  }

  .common-dynamic {
    height: 80px;
    background-color: gray;
  }

  .common-image {
    width: 80px;
    height: 80px;
    background-color: gray;
  }

  .test-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
  }

  .test-item {
    flex: 1;
    margin: 0 5px;
  }

  .test-box {
    width: 100%;
    height: 80px;
    background-color: lightgray;
  }

  .test-info {
    font-size: 12px;
    color: #666;
  }
</style>
