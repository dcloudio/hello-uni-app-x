<template>
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
  <!-- #endif -->
    <view style="flex-grow: 1;">
      <view>
        <text>padding-top: 25px</text>
        <view class="common" style="padding-top: 25px;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="padding-top: 25px;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>

      <view style="width: 250px;">
        <text>padding-top: 10%</text>
        <view class="common" style="padding-top: 10%;">
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
        <text>拍平测试</text>
        <view class="common" style="padding-top: 10%;" flatten>
          <view style="flex-grow: 1;background-color: red;"></view>
        </view>
      </view>

      <view class="uni-common-mt">
        <text class="uni-title-text">style.setProperty 动态设置 padding-top 测试</text>
        <text>padding-top: {{paddingTop}}</text>
        <view ref="viewRef" class="common" :style="{ paddingTop: paddingTop }">
          <view style="flex-grow: 1;background-color: red;"><text>当前 padding-top: {{paddingTop}}</text></view>
        </view>
      </view>

      <view class="uni-common-mt uni-common-mb">
        <text class="uni-tips">第一个，'' (空字符串) - 测试空值情况</text>
        <enum-data :items="paddingTopEnum" title="padding-top 枚举值" @change="radioChangePaddingTop"></enum-data>
        <input-data :defaultValue="paddingTop" title="padding-top 自定义值" type="text" @confirm="inputChangePaddingTop"></input-data>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="uts">
  import { ItemType } from '@/components/enum-data/enum-data-types'

  const paddingTop = ref('25px')
  const viewRef = ref(null as UniElement | null)

  const paddingTopEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '10%' }
  ]

  const changePaddingTop = (value: string) => {
    paddingTop.value = value
    viewRef.value?.style.setProperty('padding-top', value)
  }

  const radioChangePaddingTop = (index: number) => {
    const selectedItem = paddingTopEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changePaddingTop(selectedItem.name)
    }
  }

  const inputChangePaddingTop = (value: string) => {
    changePaddingTop(value)
  }
</script>

<style>
  .common {
    width: 250px;
    height: 100px;
    background-color: gray;
  }
  .tips{
    font-size: 14px;
    color:#a7a7a7;
    background-color: #ffebbb;
  }
</style>
