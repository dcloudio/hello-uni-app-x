}

.user-list-scroll {
  flex: 1;
  max-height: 220px;
}

.user-list-item {
  flex-direction: row;
  align-items: center;
  padding: 10px 16px;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #f5f5f5;
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 18px;
  align-items: center;
  justify-content: center;
}

