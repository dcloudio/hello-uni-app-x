  padding: 14px 16px;
  background-color: #ffffff;
  border-radius: 10px;
  flex-direction: column;
}

.hint-title {
  font-size: 14px;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8px;
}

.hint-item {
  font-size: 13px;
  color: #666666;
  line-height: 22px;
}

.preview-label {
  margin-top: 16px;
  padding: 0 4px;
}

.preview-label-text {
  font-size: 12px;
  color: #bbbbbb;
}

.user-list-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.25);
  z-index: 998;
}

.user-list-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 280px;
  background-color: #ffffff;
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
  flex-direction: column;
  z-index: 999;
  transform: translateY(100%);
  transition-property: transform;
  transition-duration: 0.25s;
  transition-timing-function: ease-out;
}

.user-list-panel-show {
  transform: translateY(0);
}

.user-list-header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px 10px;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #f0f0f0;
}

.user-list-title {
  font-size: 15px;
