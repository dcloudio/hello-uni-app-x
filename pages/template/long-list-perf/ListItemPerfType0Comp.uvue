<template>
  <view class="item-wrapper">
    <view class="item-content">
      <view class="item-left-stack">
        <image v-for="(img,index) in item.imgs" :key="index" class="item-left-stack-image" :src="img" mode="aspectFill"
          :style="`margin-left: ${5*index}px; margin-top: ${5*index}px;`"></image>
      </view>
      <view class="item-text">
        <view class="item-row">
          <text class="item-name">{{item.name}} type_{{item.type}}</text>
        </view>
        <view class="item-row">
          <template v-for="labelIndex in 10" :key="labelIndex">
            <text v-if="labelIndex % 2 == 0" class="item-new-label">新</text>
            <text v-if="labelIndex % 2 == 1" class="item-hot-label">热</text>
          </template>
        </view>
        <view class="item-row">
          <text class="item-info">{{item.info}}</text>
        </view>
        <template v-if="item.tags.length > 0">
          <view class="item-tags">
            <text class="item-info">随机tag：</text>
            <text class="item-tag" v-for="(tag, index) in item.tags" :key="index">{{tag}}</text>
          </view>
          <view>
            <text class="item-info">Tag总数：{{item.tags.length}}</text>
          </view>
        </template>
      </view>
    </view>
  </view>
</template>

<script setup>
  import {
    Item
  } from './types.uts'
  const props = defineProps({
    item: {
      type: Object as PropType<Item>
    }
  })

  const item = computed<Item>(() => {
    return props.item!
  })
</script>

